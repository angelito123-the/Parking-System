<%- include("partials/header") %>
<% const isGuardQueueMode = String(currentRole || "").toLowerCase() === "guard"; %>

<section class="dashboard-hero">
  <div class="hero-greeting">
    <h2>Gate Operations</h2>
    <h1>Manual Gate Tools</h1>
  </div>
  <p class="hero-description">Use manual lookup or review scans sent from a remote phone.</p>
</section>

<div class="overlap-wrapper manual-parking-flow">
  <div class="manual-tools-shortcut">
    <span>Prefer to scan a QR?</span>
    <a href="/scanner/auto" class="link-btn"><i class="ph ph-camera" aria-hidden="true"></i> Open scanner</a>
  </div>

  <section class="panel gate-console-panel" id="gateControlsSection">
    <div class="gate-console-top">
      <div class="gate-console-headline">
        <h2><span class="manual-step-number" aria-hidden="true">1</span> Find a vehicle</h2>
        <p>Search by name, student ID, plate number, or sticker. Check your gate before recording a movement.</p>
      </div>
      <button id="toggleCameraBtn" type="button" class="gate-camera-btn">
        <span class="gate-camera-btn-title">Use Camera Here</span>
        <span class="gate-camera-btn-sub">Secondary scanner</span>
      </button>
    </div>

    <div id="cameraWrapper" class="gate-camera-wrapper">
      <div id="qr-reader"></div>
      <p id="cameraStatus" class="gate-camera-status">Camera ready</p>
      <div class="scanner-assist">
        <p id="scannerGuidance" class="scanner-guidance" role="status" aria-live="polite">
          <span class="scanner-guidance-dot" aria-hidden="true"></span>
          <span class="scanner-guidance-text">Start the camera to scan a QR code.</span>
        </p>
        <button id="scannerTorchBtn" class="scanner-torch-btn" type="button" aria-pressed="false" aria-label="Turn flashlight on" hidden>
          <i class="ph ph-flashlight" aria-hidden="true"></i>
          <span class="scanner-torch-label">Flashlight</span>
        </button>
      </div>
    </div>

    <div class="gate-search-grid">
      <div>
        <label for="gateSearchInput">Vehicle or student</label>
        <input id="gateSearchInput" type="search" placeholder="Plate, student ID, name, or sticker" autocomplete="off" enterkeyhint="search" aria-controls="gateResultsContainer" />
      </div>
      <div>
        <label for="gateNameSelect">Current Gate</label>
        <select data-gate-select id="gateNameSelect">
          <% (typeof gates !== "undefined" ? gates : []).forEach((gate) => { %>
          <option value="<%= gate.name %>" data-gate-id="<%= gate.id %>" data-gate-type="<%= gate.type %>"><%= gate.name %></option>
          <% }) %>
        </select>
      </div>
      <button type="button" id="gateSearchBtn" class="gate-search-btn">Search records</button>
    </div>
  </section>

  <section class="panel" id="gateResultsSection">
  <div class="section-head">
    <h2><span class="manual-step-number" aria-hidden="true">2</span> Select a vehicle</h2>
    <p>Select a vehicle to record gate movement.</p>
  </div>
  <div id="gateSearchStatus" class="helper-text manual-search-status" role="status" aria-live="polite">Search for a vehicle to get started.</div>
  <div id="gateResultsContainer"></div>
</section>

  <section class="panel" id="gateLogPanel" tabindex="-1" style="display:none;">
  <div class="section-head">
    <h2><span class="manual-step-number" aria-hidden="true">3</span> Record movement</h2>
    <p id="gateLogInfo">Recording for selected vehicle.</p>
  </div>
  <div id="gateLogDetails" style="margin-bottom: 0.75rem;"></div>
  <div id="slotPickerPanel" class="scanner-slot-picker" style="display:none;">
    <div class="scanner-slot-picker-head">
      <strong>Choose Parking Slot</strong>
      <span id="slotPickerStatus" class="helper-text">Loading parking map...</span>
    </div>
    <div id="slotMap" class="scanner-slot-map" tabindex="0" role="region" aria-label="Choose an available parking slot"></div>
  </div>
  <div class="manual-movement-bar">
  <div id="gateLogFeedback" role="status" aria-live="polite">Choose a parking slot for entry.</div>
  <div id="movementBtnContainer" class="scanner-movement-actions">
    <button type="button" id="gateEntryBtn" class="scanner-movement-btn scanner-movement-entry">
      <span class="scanner-movement-direction">IN</span>
      <span class="movement-label">Record entry</span>
    </button>
    <button type="button" id="gateExitBtn" class="scanner-movement-btn scanner-movement-exit">
      <span class="scanner-movement-direction">OUT</span>
      <span class="movement-label">Record exit</span>
    </button>
  </div>
  </div>
</section>

  <% if (isGuardQueueMode) { %>
  <section class="panel remote-queue-panel" id="remoteQueueSection">
    <div class="section-head">
      <h2>Phone Camera Pending Entries</h2>
      <p>ENTRY scans from phone camera appear here. Guard assigns slot and confirms on this laptop.</p>
    </div>
    <div class="remote-queue-toolbar">
      <p id="remoteQueueStatus" class="helper-text">Waiting for phone scans...</p>
      <button type="button" id="remoteQueueRefreshBtn" class="btn-sm">Refresh List</button>
    </div>
    <div id="remoteQueueLiveAlert" class="remote-queue-live-alert" hidden></div>
    <div id="remoteQueueEmpty" class="empty-state" style="padding:1rem;">
      <p>No pending entry requests from phone camera.</p>
    </div>
    <div id="remoteQueueList" class="remote-queue-list"></div>
  </section>
  <% } %>

  <% if (isGuardQueueMode) { %>
  <div id="remoteEntryModal" class="slot-history-modal" aria-hidden="true">
    <div class="slot-history-backdrop" data-remote-close></div>
    <article class="slot-history-dialog remote-entry-dialog" role="dialog" aria-modal="true" aria-labelledby="remoteEntryModalTitle">
      <div class="slot-history-head">
        <h3 id="remoteEntryModalTitle">Confirm Phone Camera Entry</h3>
        <button type="button" id="remoteEntryCloseBtn" class="slot-history-close" aria-label="Close">
          <i class="ph ph-x" aria-hidden="true"></i>
        </button>
      </div>
      <p id="remoteEntryMeta" class="helper-text" style="margin-bottom:0.65rem;"></p>

      <div id="remoteEntrySnapshotWrap" class="remote-entry-snapshot" style="display:none;">
        <img id="remoteEntrySnapshotImg" alt="Phone camera snapshot proof" />
      </div>

      <label for="remoteEntrySlotSelect" style="display:block; margin-top:0.35rem; margin-bottom:0.3rem;">Assign Parking Slot</label>
      <select id="remoteEntrySlotSelect"></select>
      <p id="remoteEntryHint" class="helper-text" style="margin-top:0.4rem;"></p>

      <div class="remote-entry-actions">
        <button type="button" id="remoteEntryConfirmBtn" class="btn-sm">Confirm ENTRY</button>
        <button type="button" id="remoteEntryCancelBtn" class="btn-sm danger">Cancel Request</button>
      </div>
    </article>
  </div>
  <% } %>

<script src="/vendor/jsqr/jsQR.js?v=1.4.0"></script>
<script src="/js/qr-token-parser.js?v=20260826-accuracy1"></script>
<script src="/js/scan-readiness-model.js?v=20260828-ops1"></script>
<script src="/js/ml-qr-detector.js?v=20260909-camera1"></script>
<script src="/js/scanner-guidance.js?v=20260827-ml1"></script>
<script src="/vendor/html5-qrcode/html5-qrcode.min.js?v=2.3.8"></script>
<script nonce="<%= cspNonce %>">
  (() => {
    const searchInput = document.getElementById("gateSearchInput");
    const gateSelect = document.getElementById("gateNameSelect");
    const searchBtn = document.getElementById("gateSearchBtn");
    const statusEl = document.getElementById("gateSearchStatus");
    const resultsEl = document.getElementById("gateResultsContainer");
    const logPanel = document.getElementById("gateLogPanel");
    const logInfo = document.getElementById("gateLogInfo");
    const logDetails = document.getElementById("gateLogDetails");
    const slotPickerPanel = document.getElementById("slotPickerPanel");
    const slotPickerStatus = document.getElementById("slotPickerStatus");
    const slotMap = document.getElementById("slotMap");
    const logFeedback = document.getElementById("gateLogFeedback");
    const entryBtn = document.getElementById("gateEntryBtn");
    const exitBtn = document.getElementById("gateExitBtn");
    const toggleCameraBtn = document.getElementById("toggleCameraBtn");
    const cameraWrapper = document.getElementById("cameraWrapper");
    const cameraStatus = document.getElementById("cameraStatus");
    // Camera helpers must not prevent manual lookup if an optional script fails.
    const scannerGuidance = typeof window.ScannerGuidance === "function" ? new window.ScannerGuidance({
      cameraContainer: "qr-reader",
      guidanceElement: "scannerGuidance",
      torchButton: "scannerTorchBtn"
    }) : { start() {}, stop() {}, update() {}, detected() {}, unreadableFrame() {} };

    const remoteQueueStatus = document.getElementById("remoteQueueStatus");
    const remoteQueueList = document.getElementById("remoteQueueList");
    const remoteQueueEmpty = document.getElementById("remoteQueueEmpty");
    const remoteQueueRefreshBtn = document.getElementById("remoteQueueRefreshBtn");
    const remoteQueueLiveAlert = document.getElementById("remoteQueueLiveAlert");
    const remoteEntryModal = document.getElementById("remoteEntryModal");
    const remoteEntryCloseBtn = document.getElementById("remoteEntryCloseBtn");
    const remoteEntryMeta = document.getElementById("remoteEntryMeta");
    const remoteEntrySnapshotWrap = document.getElementById("remoteEntrySnapshotWrap");
    const remoteEntrySnapshotImg = document.getElementById("remoteEntrySnapshotImg");
    const remoteEntrySlotSelect = document.getElementById("remoteEntrySlotSelect");
    const remoteEntryHint = document.getElementById("remoteEntryHint");
    const remoteEntryConfirmBtn = document.getElementById("remoteEntryConfirmBtn");
    const remoteEntryCancelBtn = document.getElementById("remoteEntryCancelBtn");

    let selectedToken = null;
    let movementSaving = false;
    let searchRequestId = 0;
    let slotRequestId = 0;
    let selectedLabel = "";
    let selectedEntityType = "student";
    let selectedSlotId = null;
    let selectedSlotScope = "all";
    let html5QrCode = null;
    let parkingOverview = { slots: [], summary: { total: 0, available: 0, occupied: 0, disabled: 0 } };
    let remotePendingEntries = [];
    let activeRemoteEntryId = null;
    let remoteSlots = [];
    let latestRemoteEntryId = 0;
    let didInitialRemoteLoad = false;
    let lastAutoOpenedEntryId = 0;
    let remoteQueueAlertTimer = null;
    const guardQueueMode = <%- isGuardQueueMode ? "true" : "false" %>;
    const gateStageChips = Array.from(document.querySelectorAll(".gate-stage-chip[data-gate-stage]"));

    function scrollToManualStep(element) {
      element.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
        block: "start"
      });
    }

    // Keep the chosen vehicle, gate, and slot stable while a movement is being saved.
    function setMovementSaving(saving) {
      movementSaving = saving;
      logPanel.setAttribute("aria-busy", String(saving));
      searchInput.readOnly = saving;
      searchBtn.disabled = saving;
      gateSelect.disabled = saving;
      resultsEl.querySelectorAll(".select-vehicle-btn").forEach(button => { button.disabled = saving; });
      slotMap.querySelectorAll(".slot-option-btn").forEach(button => {
        button.disabled = saving || button.dataset.selectable !== "1";
      });
      entryBtn.disabled = saving || !selectedToken || !selectedSlotId;
      exitBtn.disabled = saving || !selectedToken;
      entryBtn.querySelector(".movement-label").textContent = saving ? "Recording entry..." : "Record entry";
      exitBtn.querySelector(".movement-label").textContent = saving ? "Recording exit..." : "Record exit";
    }

    function setGateStage(stageKey) {
      const normalized = String(stageKey || "scan").toLowerCase();
      gateStageChips.forEach((chip) => {
        const isActive = chip.dataset.gateStage === normalized;
        chip.classList.toggle("is-active", isActive);
        chip.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }

    gateStageChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        setGateStage(chip.dataset.gateStage || "scan");
        const targetId = chip.dataset.scrollTarget || "";
        const target = targetId ? document.getElementById(targetId) : null;
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    setGateStage("scan");

    // --- Audio Feedback ---
    function playBeep(type) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        if (type === 'success') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(800, ctx.currentTime);
          gain.gain.setValueAtTime(0.5, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);
          osc.start(); osc.stop(ctx.currentTime + 0.2);
        } else {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(300, ctx.currentTime);
          osc.frequency.setValueAtTime(150, ctx.currentTime + 0.1);
          gain.gain.setValueAtTime(0.5, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
          osc.start(); osc.stop(ctx.currentTime + 0.3);
        }
      } catch(e) {}
    }

    function escapeHtml(value) {
      return String(value == null ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function formatQueuedAt(value) {
      const dt = new Date(value);
      if (Number.isNaN(dt.getTime())) return "-";
      return new Intl.DateTimeFormat("en-PH", {
        month: "short",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit"
      }).format(dt);
    }

    function showRemoteQueueLiveAlert(message, tone = "info", autoHideMs = 5200) {
      if (!remoteQueueLiveAlert) return;
      remoteQueueLiveAlert.textContent = message;
      remoteQueueLiveAlert.className = `remote-queue-live-alert tone-${tone}`;
      remoteQueueLiveAlert.hidden = false;

      if (remoteQueueAlertTimer) {
        clearTimeout(remoteQueueAlertTimer);
      }
      remoteQueueAlertTimer = window.setTimeout(() => {
        remoteQueueLiveAlert.hidden = true;
      }, Math.max(1600, Number(autoHideMs) || 5200));
    }

    function closeRemoteEntryModal() {
      if (!remoteEntryModal) return;
      remoteEntryModal.classList.remove("open");
      remoteEntryModal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");
      activeRemoteEntryId = null;
      remoteEntryHint.textContent = "";
      remoteEntrySlotSelect.innerHTML = "";
      remoteEntryConfirmBtn.disabled = false;
      remoteEntryCancelBtn.disabled = false;
      remoteEntrySnapshotWrap.style.display = "none";
      remoteEntrySnapshotImg.removeAttribute("src");
      if (!selectedToken) {
        setGateStage(remotePendingEntries.length ? "select" : "scan");
      }
    }

    async function loadRemoteSlots() {
      const resp = await fetch("/api/parking-slots", { credentials: "same-origin", cache: "no-store" });
      const data = await resp.json().catch(() => ({ ok: false, message: "Invalid server response." }));
      if (!resp.ok || !data.ok) {
        throw new Error(data.message || `Unable to load slots (${resp.status})`);
      }
      remoteSlots = Array.isArray(data.slots) ? data.slots : [];
      return remoteSlots;
    }

    async function openRemoteEntryModal(entryId) {
      const entry = remotePendingEntries.find((row) => String(row.id) === String(entryId));
      if (!entry) return;

      activeRemoteEntryId = entry.id;
      setGateStage("record");
      remoteEntryMeta.textContent = `${entry.full_name || "-"} (${entry.student_number || "-"}) | ${entry.plate_number || "-"} | ${entry.gate_id || "Gate 1"} | ${formatQueuedAt(entry.created_at)}`;
      remoteEntryHint.textContent = "Loading available parking slots...";
      remoteEntrySlotSelect.innerHTML = '<option value="">Loading slots...</option>';

      if (entry.snapshot_path) {
        remoteEntrySnapshotWrap.style.display = "";
        remoteEntrySnapshotImg.src = entry.snapshot_path;
      } else {
        remoteEntrySnapshotWrap.style.display = "none";
        remoteEntrySnapshotImg.removeAttribute("src");
      }

      remoteEntryModal.classList.add("open");
      remoteEntryModal.setAttribute("aria-hidden", "false");
      document.body.classList.add("modal-open");

      try {
        const slots = await loadRemoteSlots();
        if (!slots.length) {
          remoteEntrySlotSelect.innerHTML = '<option value="">No available slots</option>';
          remoteEntryHint.textContent = "No available slots right now.";
          remoteEntryConfirmBtn.disabled = true;
          return;
        }
        remoteEntryConfirmBtn.disabled = false;
        remoteEntrySlotSelect.innerHTML = [
          '<option value="">Select parking slot...</option>',
          ...slots.map((slot) => {
            const typeLabel = slot.slot_type && slot.slot_type !== "standard" ? ` - ${slot.slot_type}` : "";
            const reservationLabel = slot.reserved_for ? ` (${slot.reserved_for})` : "";
            return `<option value="${escapeHtml(slot.id)}">${escapeHtml(slot.slot_code)} - ${escapeHtml(slot.zone || "General")}${escapeHtml(typeLabel)}${escapeHtml(reservationLabel)}</option>`;
          })
        ].join("");
        remoteEntryHint.textContent = `${slots.length} slot(s) available.`;
      } catch (error) {
        remoteEntrySlotSelect.innerHTML = '<option value="">Unable to load slots</option>';
        remoteEntryHint.textContent = error.message || "Unable to load slots.";
        remoteEntryConfirmBtn.disabled = true;
      }
    }

    async function fetchRemotePendingEntries({ silent = false } = {}) {
      if (!guardQueueMode) return;
      if (!remoteQueueStatus || !remoteQueueList) return;
      if (!silent) {
        remoteQueueStatus.textContent = "Loading pending phone entries...";
      }

      try {
        const resp = await fetch("/api/auto-scan/pending-entries?limit=30", {
          credentials: "same-origin",
          cache: "no-store"
        });
        const data = await resp.json().catch(() => ({ ok: false, message: "Invalid server response." }));
        if (!resp.ok || !data.ok) {
          throw new Error(data.message || `Unable to load pending entries (${resp.status})`);
        }

        remotePendingEntries = Array.isArray(data.rows) ? data.rows : [];
        const newestEntry = remotePendingEntries.length ? remotePendingEntries[0] : null;
        const newestId = newestEntry ? Number(newestEntry.id) : 0;
        const hasNewEntry = didInitialRemoteLoad && newestId > latestRemoteEntryId;
        if (hasNewEntry) {
          playBeep("success");
          showRemoteQueueLiveAlert(
            `New phone scan: ${newestEntry.full_name || "Unknown student"} (${newestEntry.plate_number || "-"})`,
            "success",
            6200
          );
          if (!remoteEntryModal?.classList.contains("open") && newestId !== lastAutoOpenedEntryId) {
            lastAutoOpenedEntryId = newestId;
            await openRemoteEntryModal(newestId);
          }
        }
        latestRemoteEntryId = Math.max(latestRemoteEntryId, newestId);
        didInitialRemoteLoad = true;

        if (!remotePendingEntries.length) {
          remoteQueueEmpty.style.display = "";
          remoteQueueList.innerHTML = "";
          remoteQueueStatus.textContent = "No pending phone entry requests.";
          if (!selectedToken) setGateStage("scan");
          return;
        }

        remoteQueueEmpty.style.display = "none";
        remoteQueueStatus.textContent = `${remotePendingEntries.length} pending request(s).`;
        if (!selectedToken) setGateStage("select");
        remoteQueueList.innerHTML = remotePendingEntries.map((entry) => `
          <article class="remote-queue-card">
            <div class="remote-queue-main">
              <h4>${escapeHtml(entry.full_name || "Unknown Student")}</h4>
              <p>${escapeHtml(entry.student_number || "-")} | ${escapeHtml(entry.plate_number || "-")}</p>
              <p>${escapeHtml(entry.gate_id || "Gate 1")} | ${formatQueuedAt(entry.created_at)}</p>
            </div>
            <div class="remote-queue-actions">
              <span class="badge badge-warning">Pending</span>
              <button type="button" class="btn-sm remote-open-entry-btn" data-entry-id="${escapeHtml(entry.id)}">Assign & Confirm</button>
            </div>
          </article>
        `).join("");

        remoteQueueList.querySelectorAll(".remote-open-entry-btn").forEach((btn) => {
          btn.addEventListener("click", () => openRemoteEntryModal(btn.dataset.entryId));
        });
      } catch (error) {
        remoteQueueStatus.textContent = error.message || "Unable to load pending entries.";
      }
    }

    async function confirmRemoteEntry() {
      if (!activeRemoteEntryId) return;
      const slotId = Number(remoteEntrySlotSelect.value);
      if (!Number.isInteger(slotId) || slotId <= 0) {
        remoteEntryHint.textContent = "Please select a parking slot.";
        return;
      }

      const entry = remotePendingEntries.find((row) => String(row.id) === String(activeRemoteEntryId));
      const gateValue = gateSelect?.value || entry?.gate_id || "Gate 1";
      remoteEntryHint.textContent = "Saving entry...";
      remoteEntryConfirmBtn.disabled = true;
      remoteEntryCancelBtn.disabled = true;

      try {
        const resp = await fetch(`/api/auto-scan/pending-entries/${activeRemoteEntryId}/confirm`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ slot_id: slotId, gate: gateValue })
        });
        const data = await resp.json().catch(() => ({ ok: false, message: "Invalid server response." }));
        if (!resp.ok || !data.ok) {
          throw new Error(data.message || `Unable to confirm entry (${resp.status})`);
        }

        playBeep("success");
        statusEl.textContent = data.message || `Entry recorded at ${data.gate_id || "the selected gate"}.`;
        closeRemoteEntryModal();
        await fetchRemotePendingEntries({ silent: true });
        await loadParkingSlots().catch(() => null);
      } catch (error) {
        playBeep("error");
        remoteEntryHint.textContent = error.message || "Unable to confirm entry.";
        remoteEntryConfirmBtn.disabled = false;
        remoteEntryCancelBtn.disabled = false;
      }
    }

    async function cancelRemoteEntry() {
      if (!activeRemoteEntryId) return;
      remoteEntryHint.textContent = "Cancelling request...";
      remoteEntryConfirmBtn.disabled = true;
      remoteEntryCancelBtn.disabled = true;

      try {
        const resp = await fetch(`/api/auto-scan/pending-entries/${activeRemoteEntryId}/cancel`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ reason: "Cancelled by guard from monitor console." })
        });
        const data = await resp.json().catch(() => ({ ok: false, message: "Invalid server response." }));
        if (!resp.ok || !data.ok) {
          throw new Error(data.message || `Unable to cancel request (${resp.status})`);
        }

        closeRemoteEntryModal();
        await fetchRemotePendingEntries({ silent: true });
      } catch (error) {
        remoteEntryHint.textContent = error.message || "Unable to cancel request.";
        remoteEntryConfirmBtn.disabled = false;
        remoteEntryCancelBtn.disabled = false;
      }
    }

    function renderSlotButton(slot) {
      const selected = String(selectedSlotId) === String(slot.id);
      const requestedOccupancy = String(slot.occupancy || "available").toLowerCase();
      const occupancy = ["available", "occupied", "disabled"].includes(requestedOccupancy)
        ? requestedOccupancy
        : "disabled";
      const isSelectable = occupancy === "available";
      return `
        <button
          type="button"
          class="slot-option-btn ${occupancy}${selected ? " selected" : ""}"
          data-slot-id="${escapeHtml(slot.id)}"
          data-slot-code="${escapeHtml(slot.slot_code)}"
          aria-label="${escapeHtml(slot.slot_code)}, ${escapeHtml(slot.zone || "General")}, ${escapeHtml(occupancy)}${slot.slot_type && slot.slot_type !== "standard" ? ", " + escapeHtml(slot.slot_type) : ""}${slot.reserved_for ? ", reserved for " + escapeHtml(slot.reserved_for) : ""}"
          data-selectable="${isSelectable ? "1" : "0"}"
          aria-pressed="${selected}"
          ${isSelectable ? "" : "disabled"}>
          <span class="slot-option-code">${escapeHtml(slot.slot_code)}</span>
          ${(slot.slot_type && slot.slot_type !== "standard") || slot.reserved_for ? `<span class="slot-option-zone">${slot.slot_type && slot.slot_type !== "standard" ? escapeHtml(slot.slot_type) : ""}${slot.reserved_for ? ` · ${escapeHtml(slot.reserved_for)}` : ""}</span>` : ""}
        </button>
      `;
    }

    function attachSlotHandlers() {
      slotMap.querySelectorAll(".slot-option-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          if (movementSaving || btn.dataset.selectable !== "1") return;
          selectedSlotId = btn.dataset.slotId;
          // Update selection in place so keyboard focus and map scroll stay put.
          slotMap.querySelectorAll(".slot-option-btn").forEach(button => {
            const selected = button === btn;
            button.classList.toggle("selected", selected);
            button.setAttribute("aria-pressed", String(selected));
          });
          entryBtn.disabled = false;
          logFeedback.innerHTML = `<div class="flash flash-success" style="margin:0;">Slot <strong>${escapeHtml(btn.dataset.slotCode || "-")}</strong> selected for entry.</div>`;
        });
      });
    }

    function renderParkingMap(overview) {
      if (!slotMap) return;
      const slots = Array.isArray(overview?.slots) ? overview.slots : [];
      if (!Array.isArray(slots) || slots.length === 0) {
        slotMap.innerHTML = window.NaapUiState.render("empty", {
          title: "No parking slots",
          message: "No parking slots are configured right now.",
          compact: true
        });
        return;
      }

      const grouped = slots.reduce((acc, slot) => {
        const zone = slot.zone || "General";
        if (!acc[zone]) acc[zone] = [];
        acc[zone].push(slot);
        return acc;
      }, Object.create(null));
      const zoneNames = Object.keys(grouped);
      const rawSummary = overview?.summary || {};
      const summary = {
        total: Number.isFinite(Number(rawSummary.total)) ? Number(rawSummary.total) : slots.length,
        available: Number.isFinite(Number(rawSummary.available)) ? Number(rawSummary.available) : 0,
        occupied: Number.isFinite(Number(rawSummary.occupied)) ? Number(rawSummary.occupied) : 0,
        disabled: Number.isFinite(Number(rawSummary.disabled)) ? Number(rawSummary.disabled) : 0
      };

      slotMap.innerHTML = `
        <div class="scanner-parking-map">
          <div class="scanner-parking-map-head">
            <div class="scanner-parking-map-summary">
              Campus Overview: ${summary.available || 0} Available / ${summary.total || slots.length} Total
            </div>
            <div class="scanner-parking-legend" aria-label="Parking status legend">
              <span class="scanner-parking-legend-item"><span class="scanner-parking-legend-dot available"></span>Available</span>
              <span class="scanner-parking-legend-item"><span class="scanner-parking-legend-dot occupied"></span>Occupied</span>
              <span class="scanner-parking-legend-item"><span class="scanner-parking-legend-dot disabled"></span>Disabled</span>
            </div>
          </div>
          ${zoneNames.map(zone => `
            <div class="scanner-zone-block">
              <div class="scanner-zone-title">${escapeHtml(zone)}</div>
              <div class="scanner-slot-grid" data-parking-zone="${escapeHtml(zone)}">
                ${grouped[zone].map(renderSlotButton).join("")}
              </div>
            </div>
          `).join("")}
        </div>
      `;
      if (window.NaapParkingLayout?.apply) {
        slotMap.querySelectorAll(".scanner-slot-grid").forEach(window.NaapParkingLayout.apply);
      }
      attachSlotHandlers();
    }

    async function loadParkingSlots(scope = "all") {
      if (!slotPickerStatus) return;
      const requestId = ++slotRequestId;
      slotPickerStatus.textContent = "Loading parking map...";
      slotMap.setAttribute("aria-busy", "true");
      slotMap.innerHTML = window.NaapUiState.render("loading", { title: "Loading parking slots", message: "Checking current availability...", compact: true });
      entryBtn.disabled = true;
      selectedSlotId = null;
      const selectedScope = String(scope || "all").toLowerCase();

      try {
        const resp = await fetch(`/api/parking-slot-overview?scope=${encodeURIComponent(selectedScope)}`);
        const data = await resp.json();
        if (requestId !== slotRequestId) return;
        if (!resp.ok || !data.ok) throw new Error(data.message || "Failed to load parking overview.");
        parkingOverview = {
          slots: Array.isArray(data.slots) ? data.slots : [],
          summary: data.summary || { total: 0, available: 0, occupied: 0, disabled: 0 }
        };
        const availableCount = parkingOverview.summary?.available || 0;
        const totalCount = parkingOverview.summary?.total || parkingOverview.slots.length || 0;
        slotPickerStatus.textContent = `${availableCount} available out of ${totalCount} slots`;
        renderParkingMap(parkingOverview);
        entryBtn.disabled = true;
        if (availableCount > 0) logFeedback.textContent = "Choose an available slot, then record entry.";
        if (availableCount <= 0) {
          logFeedback.textContent = totalCount > 0 && Number(parkingOverview.summary.disabled) === Number(totalCount)
            ? "All parking spaces are disabled. Ask an administrator to reopen a space before recording entry."
            : "No parking spaces are available. Entry cannot be recorded until a space is available.";
        }
      } catch (error) {
        if (requestId !== slotRequestId) return;
        parkingOverview = { slots: [], summary: { total: 0, available: 0, occupied: 0, disabled: 0 } };
        slotPickerStatus.textContent = "Unable to load parking map";
        slotMap.innerHTML = window.NaapUiState.render(navigator.onLine ? "error" : "offline", {
          title: navigator.onLine ? "Parking map unavailable" : "You are offline",
          message: error.message || "Unable to load parking overview.",
          compact: true
        });
      } finally {
        if (requestId === slotRequestId) slotMap.setAttribute("aria-busy", "false");
      }
    }

    // --- Camera Logic ---
    function setCameraButton(isOpen) {
      if (isOpen) {
        toggleCameraBtn.innerHTML = '<span class="gate-camera-btn-title">Close Camera</span><span class="gate-camera-btn-sub">Stop secondary scanner</span>';
      } else {
        toggleCameraBtn.innerHTML = '<span class="gate-camera-btn-title">Use Camera Here</span><span class="gate-camera-btn-sub">Secondary scanner</span>';
      }
    }

    setCameraButton(false);

    let cameraStarting = false;
    toggleCameraBtn.addEventListener("click", async () => {
      if (cameraStarting) return;
      const currentlyHidden = cameraWrapper.style.display === "none" || getComputedStyle(cameraWrapper).display === "none";
      if (currentlyHidden || !html5QrCode) {
        cameraStarting = true;
        try {
          cameraWrapper.style.display = "block";
          setCameraButton(true);
          if (cameraStatus) cameraStatus.textContent = "Starting camera...";
          if (!html5QrCode) {
            const enhancedScannerAvailable = typeof window.MLQrCodeScanner === "function" && typeof window.jsQR === "function";
            html5QrCode = enhancedScannerAvailable
              ? new window.MLQrCodeScanner("qr-reader", {
                  targetFps: 24,
                  confidenceThreshold: 0.35,
                  maxProcessWidth: 720,
                  perspectiveSize: 320,
                  lowConfidenceDecodeRatio: 0.58,
                  duplicateSuppressMs: 220,
                  onMlMetrics: (metrics) => scannerGuidance.update(metrics)
                })
              : new Html5Qrcode("qr-reader");
          }
          await html5QrCode.start(
            { facingMode: "environment" },
            { fps: 24, aspectRatio: 1.333333, disableFlip: false },
            onScanSuccess,
            () => scannerGuidance.unreadableFrame()
          );
          scannerGuidance.start();
          if (cameraStatus) cameraStatus.textContent = "Scanner active";
        } catch (error) {
          if (cameraStatus) cameraStatus.textContent = "Camera unavailable. Check camera permission and tap Use Camera Here to retry.";
          scannerGuidance.stop();
          if (html5QrCode) {
            try { await html5QrCode.stop(); } catch (_) {}
            try { await html5QrCode.clear(); } catch (_) {}
          }
          html5QrCode = null;
          setCameraButton(false);
        } finally { cameraStarting = false; }
      } else {
        cameraWrapper.style.display = "none";
        setCameraButton(false);
        if (cameraStatus) cameraStatus.textContent = "Camera ready";
        scannerGuidance.stop();
        if (html5QrCode) {
          const scannerToClose = html5QrCode;
          html5QrCode = null;
          scannerToClose.stop()
            .catch(() => null)
            .then(() => scannerToClose.clear())
            .catch(() => null);
        }
      }
    });
    async function onScanSuccess(decodedText, decodeMeta = null) {
      if (movementSaving) return;
      scannerGuidance.detected();
      if (html5QrCode && html5QrCode.getState() === 2) {
        html5QrCode.pause(); // Pause scanning
      }

      if (cameraStatus && decodeMeta && Number.isFinite(Number(decodeMeta.ml_confidence))) {
        cameraStatus.textContent = `QR detected (${Math.round(Number(decodeMeta.ml_confidence) * 100)}% confidence)`;
      }

      const token = window.QRTokenParser && typeof window.QRTokenParser.extract === "function"
        ? window.QRTokenParser.extract(decodedText, window.location.href)
        : String(decodedText || "").trim();

      statusEl.textContent = "Processing scan...";
      resultsEl.innerHTML = "";
      logPanel.style.display = "none";
      setGateStage("scan");

      const isOffline = !navigator.onLine;
      
      try {
        if (isOffline) {
          if (!window.OfflineManager) throw new Error("Offline lookup is unavailable. Reconnect and retry.");
          const verified = await window.OfflineManager.verifyOfflineToken(token);
          if (!verified.ok) throw new Error(verified.message);
          renderSearchResults([{ ...verified.sticker, qr_token: token, sticker_status: "active" }]);
        } else {
          searchInput.value = token;
          await doSearch();
        }
        const selectable = document.querySelector('.select-vehicle-btn');
        if (selectable) {
          playBeep('success');
          selectable.click();
        } else {
          playBeep('error');
          setTimeout(() => html5QrCode && html5QrCode.resume(), 2000);
        }
      } catch (error) {
        playBeep('error');
        statusEl.textContent = isOffline ? "Offline lookup is unavailable or this sticker is invalid. Reconnect and retry." : "Lookup failed. Please retry.";
        setTimeout(() => html5QrCode && html5QrCode.resume(), 2000);
      }
    }

    // --- Search Logic ---
    function renderVehicleCard(item) {
      const requestedEntityType = String(item.entity_type || "student").toLowerCase();
      const entityType = requestedEntityType === "visitor" ? "visitor" : "student";
      const isVisitor = entityType === "visitor";
      const statusRaw = String(item.sticker_status || "").toLowerCase();
      const allowedStatusClasses = new Set(["expired", "revoked", "pending", "invalid"]);
      const statusClass = statusRaw === "active"
        ? "valid"
        : allowedStatusClasses.has(statusRaw) ? statusRaw : "invalid";
      const isActive = statusRaw === "active";
      const identityLabel = isVisitor
        ? `Pass: ${item.sticker_code || "-"}`
        : `${item.student_number || ""}`;
      const vehicleDetail = isVisitor
        ? `${item.model ? ` · ${item.model}` : ""}${item.visitor_type ? ` · ${item.visitor_type}` : ""}`
        : `${item.model ? ` · ${item.model}` : ""}${item.color ? ` · ${item.color}` : ""}`;
      const restrictedReason = statusRaw === "pending"
        ? "Pending approval - cannot record movement yet."
        : statusRaw === "expired"
          ? isVisitor ? "Visitor pass has expired." : "Vehicle sticker has expired. Ask an administrator to renew it."
          : statusRaw === "revoked"
            ? "Access denied for this pass."
            : "No active QR token available.";
      return `
        <div class="mini-row manual-vehicle-card">
          <div style="display:flex; justify-content:space-between; align-items:center; width:100%; flex-wrap:wrap; gap:0.5rem;">
            <div>
              <strong>${escapeHtml(item.full_name || "-")}</strong>
              <span class="helper-text" style="margin-left:0.5rem;">${escapeHtml(identityLabel)}</span>
            </div>
            <span class="badge badge-${statusClass}">${escapeHtml(item.sticker_status || "no sticker")}</span>
          </div>
          <div class="helper-text">
            Vehicle: <strong>${escapeHtml(item.plate_number || "-")}</strong>${escapeHtml(vehicleDetail)}
          </div>
          <div class="helper-text">
            ${isVisitor ? "Pass" : "Sticker"}: <strong>${escapeHtml(item.sticker_code || "None")}</strong>
            ${item.expires_at ? ` · Expires: ${new Date(item.expires_at).toLocaleDateString()}` : ""}
          </div>
          ${item.current_slot ? `<div class="helper-text">Current Slot: <strong>${escapeHtml(item.current_slot)}</strong></div>` : ""}
          ${isActive && item.qr_token
            ? `<button type="button" class="select-vehicle-btn btn-sm"
                aria-pressed="false"
                data-token="${escapeHtml(item.qr_token)}"
                data-label="${escapeHtml(item.full_name)} · ${escapeHtml(item.plate_number)}"
                data-entity="${entityType}"
                data-scope="${isVisitor ? "visitor" : "all"}"
                data-lastaction="${escapeHtml(item.last_action || '')}"
                data-currentslot="${escapeHtml(item.current_slot || '')}">
                ${isVisitor ? "Select this Pass" : "Select this Vehicle"}
              </button>`
            : `<span class="helper-text">Access: ${restrictedReason}</span>`
          }
        </div>`;
    }
    function renderSearchResults(resultsData) {
      setGateStage(resultsData.length ? "select" : "scan");
      statusEl.textContent = `Found ${resultsData.length} result(s).`;
      resultsEl.innerHTML = resultsData.map(renderVehicleCard).join("");
      resultsEl.querySelectorAll(".select-vehicle-btn").forEach(btn => {
        btn.addEventListener("click", async () => {
          if (movementSaving) return;
          slotRequestId += 1;
          resultsEl.querySelectorAll(".select-vehicle-btn").forEach(button => {
            button.setAttribute("aria-pressed", String(button === btn));
            button.closest(".manual-vehicle-card").classList.toggle("is-selected", button === btn);
          });
          selectedToken = btn.dataset.token;
          selectedLabel = btn.dataset.label;
          selectedEntityType = btn.dataset.entity || "student";
          selectedSlotScope = btn.dataset.scope || (selectedEntityType === "visitor" ? "visitor" : "all");
          selectedSlotId = null;
          logInfo.textContent = selectedLabel;
          const currentSlot = btn.dataset.currentslot || "";
          logDetails.innerHTML = `
            <p class="helper-text">Gate: <strong id="manualSelectedGate">${escapeHtml(gateSelect.value)}</strong></p>
            <p class="helper-text">Mode: <strong>${selectedEntityType === "visitor" ? "Visitor Pass" : "Student Vehicle"}</strong></p>
            ${currentSlot ? `<p class="helper-text">Current Slot: <strong>${escapeHtml(currentSlot)}</strong></p>` : ""}
          `;
          logFeedback.innerHTML = "";
          logPanel.style.display = "block";
          logPanel.style.opacity = "1";
          logPanel.focus({ preventScroll: true });
          scrollToManualStep(logPanel);
          setGateStage("record");

          // Smart Scanning (Auto-Toggle)
          const lastAction = btn.dataset.lastaction;
          entryBtn.style.display = "block";
          exitBtn.style.display = "block";
          slotPickerPanel.style.display = "none";
          if (lastAction === "ENTRY") {
             entryBtn.style.display = "none";
             exitBtn.disabled = false;
             logFeedback.textContent = "Vehicle is inside campus. Record exit at your current gate.";
          } else {
             exitBtn.style.display = "none";
          }

          if (entryBtn.style.display !== "none") {
            slotPickerPanel.style.display = "block";
            await loadParkingSlots(selectedSlotScope);
          }
        });
      });
    }

    gateSelect.addEventListener("change", () => {
      const selectedGateLabel = document.getElementById("manualSelectedGate");
      if (selectedGateLabel) selectedGateLabel.textContent = gateSelect.value;
    });

    async function doSearch() {
      if (movementSaving) return;
      const requestId = ++searchRequestId;
      slotRequestId += 1;
      const q = searchInput.value.trim();
      selectedToken = null;
      selectedSlotId = null;
      resultsEl.innerHTML = "";
      logPanel.style.display = "none";
      setGateStage("scan");
      if (!q) {
        statusEl.textContent = "Please enter a search term.";
        searchBtn.disabled = false;
        searchBtn.textContent = "Search records";
        resultsEl.setAttribute("aria-busy", "false");
        searchInput.focus();
        return;
      }

      const isOffline = !navigator.onLine;
      statusEl.textContent = isOffline ? "Searching Offline Roster..." : "Searching...";
      searchBtn.disabled = true;
      searchBtn.textContent = "Searching...";
      resultsEl.setAttribute("aria-busy", "true");

      try {
        let matches;
        if (isOffline) {
          if (!window.OfflineManager) throw new Error("Offline support unavailable");
          const offlineResults = await window.OfflineManager.searchOfflineRoster(q);
          matches = offlineResults.map(vehicle => ({ ...vehicle, sticker_status: "active" }));
        } else {
          const resp = await fetch(`/api/gate-lookup?q=${encodeURIComponent(q)}`);
          const data = await resp.json();
          if (requestId !== searchRequestId) return;
          if (!resp.ok || !data.ok) {
            statusEl.textContent = `Error: ${data.message || "Unable to search records. Please retry."}`;
            return;
          }
          if (!Array.isArray(data.results)) throw new Error("Invalid lookup response");
          matches = data.results;
        }
        // A slow response must never replace the guard's more recent search.
        if (requestId !== searchRequestId) return;
        if (matches.length) {
          renderSearchResults(matches);
        } else {
          statusEl.textContent = isOffline ? "No offline matches found." : "No results found.";
        }
      } catch (error) {
        if (requestId !== searchRequestId) return;
        statusEl.textContent = isOffline
          ? "Offline lookup is unavailable on this device. Reconnect and retry."
          : "Lookup failed. Check your connection and retry.";
      } finally {
        if (requestId === searchRequestId) {
          searchBtn.disabled = false;
          searchBtn.textContent = "Search records";
          resultsEl.setAttribute("aria-busy", "false");
        }
      }
    }

    searchBtn.addEventListener("click", doSearch);
    searchInput.addEventListener("keydown", (e) => { if (e.key === "Enter") doSearch(); });
    const initialSearchQuery = new URLSearchParams(window.location.search).get("q");
    if (initialSearchQuery) {
      searchInput.value = initialSearchQuery;
      doSearch();
    }

    if (guardQueueMode) {
      remoteQueueRefreshBtn?.addEventListener("click", () => fetchRemotePendingEntries({ silent: false }));
      remoteEntryCloseBtn?.addEventListener("click", closeRemoteEntryModal);
      remoteEntryConfirmBtn?.addEventListener("click", confirmRemoteEntry);
      remoteEntryCancelBtn?.addEventListener("click", cancelRemoteEntry);
      remoteEntryModal?.querySelectorAll("[data-remote-close]").forEach((node) => {
        node.addEventListener("click", closeRemoteEntryModal);
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && remoteEntryModal?.classList.contains("open")) {
          closeRemoteEntryModal();
        }
      });
    }

    // --- Record Logic ---
    async function recordMovement(action) {
      if (!selectedToken || movementSaving) return;
      const gate = gateSelect.value || "Gate 1";
      if (window.NaapGateSelector && !window.NaapGateSelector.allows(gateSelect, action)) {
        logFeedback.textContent = gate + " does not allow " + action.toLowerCase() + ". Select a gate that allows this movement.";
        return;
      }
      if (action === "ENTRY" && !selectedSlotId) {
        logFeedback.innerHTML = `<div class="flash flash-error" style="margin:0;">Choose a parking slot on the map before recording entry.</div>`;
        return;
      }
      logFeedback.innerHTML = `<span class="helper-text">Recording ${action}...</span>`;
      
      const isOffline = !navigator.onLine;

      if (isOffline) {
        if (action === "ENTRY") {
          playBeep('error');
          logFeedback.innerHTML = `<div class="flash flash-error" style="margin:0;">Slot assignment needs an online connection before entry can be recorded.</div>`;
          return;
        }
        // Queue movement in outbox
        try {
          if (!window.OfflineManager) throw new Error("Offline support unavailable");
          const queued = await window.OfflineManager.queueMovement(selectedToken, action, gate);
          if (!queued.queued && !queued.duplicate) throw new Error("Movement was not queued");
        } catch (error) {
          logFeedback.textContent = "Movement could not be saved offline. Reconnect and retry.";
          return;
        }
        addToHistory(selectedLabel, action, true, true);
        playBeep('success');
        logFeedback.innerHTML = `<div class="flash flash-success" style="margin:0;">${action} saved to OFFLINE QUEUE.<br><small>Will sync when connection is restored.</small></div>`;
        logPanel.style.opacity = '0.7';
        statusEl.textContent = `${action} queued offline. Ready for next scan.`;
        setGateStage("scan");
        setTimeout(() => { if(html5QrCode) html5QrCode.resume() }, 2000);
      } else {
        // Block repeated clicks while the movement request is in flight.
        setMovementSaving(true);
        try {
          const resp = await fetch("/api/manual-movement", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              token: selectedToken,
              action,
              gate,
              slot_id: action === "ENTRY" ? selectedSlotId : null,
              entity_type: selectedEntityType
            })
          });
          const data = await resp.json();
          if (data.movement_saved) {
            addToHistory(selectedLabel, action, false, true);
            playBeep('success');
            selectedSlotId = null;
            slotPickerPanel.style.display = "none";
            logFeedback.innerHTML = `<div class="flash flash-success" style="margin:0;">${action === "ENTRY" ? "Entry" : "Exit"} recorded at ${escapeHtml(gate)}.</div>`;
            statusEl.textContent = `${action === "ENTRY" ? "Entry" : "Exit"} recorded at ${gate}. Ready for next scan.`;
            setGateStage("scan");
            selectedToken = null;
            selectedLabel = "";
            selectedEntityType = "student";
            selectedSlotScope = "all";
            resultsEl.innerHTML = "";
            searchInput.focus({ preventScroll: true });
            searchInput.select();
            scrollToManualStep(document.getElementById("gateControlsSection"));
          } else {
             playBeep('error');
             logFeedback.innerHTML = `<div class="flash flash-error" style="margin:0;">${escapeHtml(data.message || "Unable to record")}</div>`;
          }
          setTimeout(() => { if(html5QrCode) html5QrCode.resume() }, 2000);
        } catch (err) {
          playBeep('error');
          logFeedback.innerHTML = `<div class="flash flash-error" style="margin:0;">Unable to save movement. Check your connection and retry.</div>`;
        } finally {
          setMovementSaving(false);
        }
      }
    }

    entryBtn.addEventListener("click", () => recordMovement("ENTRY"));
    exitBtn.addEventListener("click", () => recordMovement("EXIT"));

    // Scan History
    const scanHistory = [];

    function addToHistory(label, action, isOffline, isSuccess) {
      const time = new Date().toLocaleTimeString('en-US', { timeZone: 'Asia/Manila' });
      scanHistory.unshift({ label, action, isOffline, isSuccess, time });
      if (scanHistory.length > 8) scanHistory.pop();
      renderHistory();
    }

    function renderHistory() {
      const historyList = document.getElementById("scanHistoryList");
      const historyEmpty = document.getElementById("scanHistoryEmpty");
      if (!historyList || !historyEmpty) return;
      if (scanHistory.length === 0) {
        historyEmpty.style.display = "";
        historyList.innerHTML = "";
        return;
      }
      historyEmpty.style.display = "none";
      historyList.innerHTML = scanHistory.map(entry => {
        const actionClass = entry.action === "ENTRY" ? "entry" : "exit";
        const statusIcon  = entry.isSuccess ? "ph-check-circle" : "ph-warning-circle";
        const offlineTag  = entry.isOffline ? `<span class="badge badge-warning scanner-history-offline">Offline</span>` : "";
        return `<div class="scanner-history-item action-${actionClass}">
          <span class="scanner-history-icon" aria-hidden="true"><i class="ph ${statusIcon}"></i></span>
          <div class="scanner-history-copy">
            <p class="scanner-history-label">${escapeHtml(entry.label)}</p>
            <p class="scanner-history-meta">${escapeHtml(entry.time)} ${offlineTag}</p>
          </div>
          <span class="badge badge-${actionClass}">${entry.action}</span>
        </div>`;
      }).join("");
    }

    if (guardQueueMode) {
      fetchRemotePendingEntries({ silent: false });
      setInterval(() => {
        fetchRemotePendingEntries({ silent: true });
      }, 3000);
    }

    renderHistory();
  })();
</script>

<!-- Scan History Panel -->
  <section class="panel" style="border:none; box-shadow:none; padding:0; background:transparent; border-top: 1px solid var(--line); padding-top: 2rem;">
  <div class="section-head">
    <h2>Recent Scans This Session</h2>
    <p>Last 8 movements recorded since you opened this page.</p>
  </div>
  <div id="scanHistoryEmpty" style="text-align:center;padding:1.5rem;color:var(--muted);font-size:0.875rem;">
    <div style="font-size:1rem;margin-bottom:0.5rem;color:var(--text-secondary);letter-spacing:0.08em;">LOG</div>
    No scans recorded yet this session.
  </div>
  <div id="scanHistoryList" style="display:grid;gap:0.4rem;"></div>
</section>
</div> <!-- end overlap-wrapper -->

<script src="/js/gate-selector.js?v=20261018-gates" defer></script>
<%- include("partials/footer") %>
