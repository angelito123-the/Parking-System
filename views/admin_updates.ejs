<%- include("partials/header") %>
<%
  const safeInsideVehicles = Array.isArray(insideVehicles) ? insideVehicles : [];
  const safeOverstayAlerts = Array.isArray(overstayAlerts) ? overstayAlerts : [];
  const safeMovementLogs = Array.isArray(movementLogs) ? movementLogs : [];
  const safeOverstayLimitLabel = typeof overstayLimitLabel === "string" && overstayLimitLabel
    ? overstayLimitLabel
    : "4";
  const todayKey = new Date().toISOString().slice(0, 10);
  const todayRows = safeMovementLogs.filter((row) => {
    if (!row?.scanned_at) return false;
    return new Date(row.scanned_at).toISOString().slice(0, 10) === todayKey;
  });
  const todayEntries = todayRows.filter((row) => row.action === "ENTRY").length;
  const todayExits = todayRows.filter((row) => row.action === "EXIT").length;
  const updatesSnapshotAt = new Date().toISOString();
%>

<div class="live-updates-page">
<section class="dashboard-hero updates-hero">
  <div class="hero-greeting">
    <h2>Access Control</h2>
    <h1>Latest Updates <span id="updatesLiveStatus" class="updates-live-status" data-state="live" role="status"><span class="updates-live-dot" aria-hidden="true"></span><span class="updates-live-label">Live</span></span></h1>
    <p class="updates-snapshot-note">Recent activity snapshot · refreshes every 20 seconds. Counts reflect the loaded records.</p>
  </div>
  <div class="hero-cards updates-stats-grid">
    <div class="hero-card stat-entry">
      <span class="updates-stat-glow" aria-hidden="true"></span>
      <h3><span class="updates-stat-icon"><i class="ph ph-sign-in" aria-hidden="true"></i></span>Today Entries</h3>
      <p id="updatesMetricEntries"><%= todayEntries %></p>
    </div>
    <div class="hero-card stat-exit">
      <span class="updates-stat-glow" aria-hidden="true"></span>
      <h3><span class="updates-stat-icon"><i class="ph ph-sign-out" aria-hidden="true"></i></span>Today Exits</h3>
      <p id="updatesMetricExits"><%= todayExits %></p>
    </div>
    <div class="hero-card">
      <span class="updates-stat-glow" aria-hidden="true"></span>
      <h3><span class="updates-stat-icon"><i class="ph ph-car" aria-hidden="true"></i></span>Currently Inside</h3>
      <p id="updatesMetricInside"><%= safeInsideVehicles.length %></p>
    </div>
    <div class="hero-card <%= safeOverstayAlerts.length ? 'has-overstay' : '' %>">
      <span class="updates-stat-glow" aria-hidden="true"></span>
      <h3><span class="updates-stat-icon"><i class="ph ph-warning" aria-hidden="true"></i></span>Overstay Alerts</h3>
      <p id="updatesMetricOverstay"><%= safeOverstayAlerts.length %></p>
    </div>
  </div>
</section>

<div class="overlap-wrapper" style="display:grid; gap:1.25rem;">
  <section class="panel">
    <div class="section-head">
      <h2>Live Activity Feed</h2>
      <p>Latest gate events captured across manual and phone camera scans.</p>
    </div>
    <div class="refresh-row">
      <span id="updatesLastUpdated" class="helper-text">Last updated: page loaded</span>
      <button type="button" id="updatesRefreshBtn" class="btn-secondary btn-sm" aria-busy="false"><i class="ph ph-arrow-clockwise" aria-hidden="true"></i><span>Refresh</span></button>
    </div>
    <div class="updates-filter-bar">
      <div id="updatesFilters" role="group" aria-label="Filter recent activity">
        <button type="button" data-update-filter="all" aria-pressed="true" aria-controls="updatesList">All</button>
        <button type="button" data-update-filter="entry" aria-pressed="false" aria-controls="updatesList"><i class="ph ph-sign-in" aria-hidden="true"></i> Entries</button>
        <button type="button" data-update-filter="exit" aria-pressed="false" aria-controls="updatesList"><i class="ph ph-sign-out" aria-hidden="true"></i> Exits</button>
        <button type="button" data-update-filter="unknown" aria-pressed="false" aria-controls="updatesList"><i class="ph ph-warning" aria-hidden="true"></i> Unknown</button>
      </div>
      <p id="updatesFilterCount" role="status"></p>
    </div>
    <p id="updatesRefreshError" role="status" hidden><i class="ph ph-warning" aria-hidden="true"></i> Couldn’t refresh. Showing the last loaded snapshot. Try Refresh.</p>
    <div class="updates-feed-shell">
    <div id="updatesList" class="updates-list updates-list-pro" tabindex="0" role="region" aria-label="Recent gate events" aria-busy="false">
      <% if (!safeMovementLogs.length) { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i class="ph ph-bell" aria-hidden="true"></i></div>
          <p>No updates yet.</p>
        </div>
      <% } %>
      <% safeMovementLogs.slice(0, 14).forEach((scan) => { %>
        <div class="update-item">
          <span class="update-dot <%= String(scan.result || 'invalid').toLowerCase() %> <%= String(scan.action || 'verify').toLowerCase() %>"></span>
          <div>
            <p>
              <strong><%= scan.full_name || "Unknown Student" %></strong>
              <span class="update-action <%= String(scan.action || 'verify').toLowerCase() %>"><%= scan.action || "VERIFY" %></span>
            </p>
            <p class="helper-text">
              <%= scan.gate_name || scan.gate || "Gate not recorded" %> • <%= new Date(scan.scanned_at).toLocaleString("en-US", { timeZone: "Asia/Manila" }) %>
            </p>
          </div>
        </div>
      <% }) %>
    </div>
    <div id="updatesLoading" hidden aria-hidden="true"><span class="updates-skeleton"></span><span class="updates-skeleton"></span><span class="updates-skeleton"></span></div>
    </div>
  </section>

  <section class="panel">
    <div class="section-head">
      <h2>Overstay Watch</h2>
      <p>Vehicles parked beyond <%= safeOverstayLimitLabel %> hour(s).</p>
    </div>
    <div id="updatesOverstayList" class="updates-overstay-list">
      <% if (!safeOverstayAlerts.length) { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i class="ph ph-shield-check" aria-hidden="true"></i></div>
          <p>No active overstay alerts.</p>
        </div>
      <% } %>
      <% safeOverstayAlerts.forEach((item) => { %>
        <article class="updates-overstay-card">
          <div class="updates-overstay-card-top">
            <strong><%= item.full_name || "Unknown Student" %></strong>
            <span class="badge badge-overstay">Overstay</span>
          </div>
          <p><strong>Plate:</strong> <%= item.plate_number || "-" %> • <strong>Slot:</strong> <%= item.parking_slot || "-" %></p>
          <p><strong>Entered:</strong> <%= new Date(item.entered_at).toLocaleString("en-US", { timeZone: "Asia/Manila" }) %></p>
          <p><strong>Duration:</strong> <%= item.duration_label || "-" %> <% if (item.overstay_label) { %>(<%= item.overstay_label %>)<% } %></p>
        </article>
      <% }) %>
    </div>
  </section>
</div>
</div>

<script src="/js/live-updates-ui.js?v=20261023-updates"></script>
<script nonce="<%= cspNonce %>">
  (() => {
    const updatesMetricEntries = document.getElementById("updatesMetricEntries");
    const updatesMetricExits = document.getElementById("updatesMetricExits");
    const updatesMetricInside = document.getElementById("updatesMetricInside");
    const updatesMetricOverstay = document.getElementById("updatesMetricOverstay");
    const overstayList = document.getElementById("updatesOverstayList");
    const refreshBtn = document.getElementById("updatesRefreshBtn");
    const updatesUi = window.NaapUpdatesUi;

    function toPht(value) {
      return new Date(value).toLocaleString("en-US", { timeZone: "Asia/Manila" });
    }

    function getDurationLabel(item) {
      if (item && item.duration_label) return item.duration_label;
      const minutes = Math.max(0, Number(item?.minutes_inside) || 0);
      const hours = Math.floor(minutes / 60);
      const mins = minutes % 60;
      return hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
    }

    function getOverstayText(item) {
      if (!item || !item.is_overstay) return "";
      if (item.overstay_label) return item.overstay_label;
      const overstayMinutes = Math.max(0, Number(item.overstay_minutes) || 0);
      if (!overstayMinutes) return "Over limit";
      const hours = Math.floor(overstayMinutes / 60);
      const mins = overstayMinutes % 60;
      return hours > 0 ? `+${hours}h ${mins}m over limit` : `+${mins}m over limit`;
    }

    function escapeHtml(value) {
      return String(value == null ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function renderUpdateItem(scan) {
      return updatesUi.renderRow(scan);
    }

    function renderOverstayCard(item) {
      return `<article class="updates-overstay-card">
        <div class="updates-overstay-card-top">
          <strong>${escapeHtml(item.full_name || "Unknown Student")}</strong>
          <span class="badge badge-overstay">Overstay</span>
        </div>
        <p><strong>Plate:</strong> ${escapeHtml(item.plate_number || "-")} • <strong>Slot:</strong> ${escapeHtml(item.parking_slot || "-")}</p>
        <p><strong>Entered:</strong> ${item.entered_at ? escapeHtml(toPht(item.entered_at)) : "-"}</p>
        <p><strong>Duration:</strong> ${escapeHtml(getDurationLabel(item))} ${item.is_overstay ? `(${escapeHtml(getOverstayText(item))})` : ""}</p>
      </article>`;
    }

    function renderEmptyState(iconClass, message) {
      return `<div class="empty-state"><div class="empty-state-icon"><i class="ph ${iconClass}" aria-hidden="true"></i></div><p>${message}</p></div>`;
    }

    function updateTodayMetrics(logs) {
      const todayKey = new Date().toISOString().slice(0, 10);
      const todayRows = logs.filter((row) => {
        if (!row?.scanned_at) return false;
        return new Date(row.scanned_at).toISOString().slice(0, 10) === todayKey;
      });
      const entries = todayRows.filter((row) => row.action === "ENTRY").length;
      const exits = todayRows.filter((row) => row.action === "EXIT").length;
      updatesUi.metric(updatesMetricEntries, entries);
      updatesUi.metric(updatesMetricExits, exits);
    }

    async function refreshUpdates() {
      updatesUi.start();
      let refreshed = false;
      try {
        const resp = await fetch("/api/dashboard-stats", { credentials: "same-origin" });
        const data = await resp.json();
        if (!data.ok) { updatesUi.failure(); return; }

        const movementLogs = Array.isArray(data.movementLogs) ? data.movementLogs : [];
        const insideRows = Array.isArray(data.insideVehicles) ? data.insideVehicles : [];
        const overstayRows = Array.isArray(data.overstayAlerts) ? data.overstayAlerts : insideRows.filter((item) => item.is_overstay);

        updateTodayMetrics(movementLogs);
        updatesUi.metric(updatesMetricInside, insideRows.length);
        updatesUi.metric(updatesMetricOverstay, overstayRows.length);

        updatesUi.render(movementLogs, renderUpdateItem);
        if (overstayList) {
          overstayList.innerHTML = overstayRows.length
            ? overstayRows.map(renderOverstayCard).join("")
            : renderEmptyState("ph-shield-check", "No active overstay alerts.");
        }

        updatesUi.success();
        refreshed = true;
      } catch (error) {
        updatesUi.failure();
        console.error("Failed to refresh updates page:", error);
      } finally {
        updatesUi.end(refreshed);
      }
    }

    updatesUi.init(<%- serializeForScript(safeMovementLogs) %>, renderUpdateItem, <%- serializeForScript(updatesSnapshotAt) %>);
    if (refreshBtn) refreshBtn.addEventListener("click", refreshUpdates);
    setInterval(refreshUpdates, 20000);
  })();
</script>

<%- include("partials/footer") %>
