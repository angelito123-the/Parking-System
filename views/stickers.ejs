<%- include("partials/header") %>
<%
  const stickerBaseUrl = typeof requestBaseUrl === "string" && requestBaseUrl
    ? requestBaseUrl
    : APP_BASE_URL;
  const pageFlash = typeof flash !== 'undefined' ? flash : null;
  const safeEmailDeliveries = Array.isArray(emailDeliveries) ? emailDeliveries : [];

  function calendarDateKey(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return null;
    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit'
    }).formatToParts(date).map((part) => [part.type, part.value]));
    return `${parts.year}-${parts.month}-${parts.day}`;
  }

  function stickerDisplayStatus(sticker) {
    if (sticker.status !== 'active') return sticker.status;
    const expirationDate = sticker.expires_at ? calendarDateKey(sticker.expires_at) : null;
    const today = calendarDateKey(new Date());
    if (expirationDate && expirationDate < today) return 'expired';
    return 'active';
  }
%>

<section class="dashboard-hero">
  <div class="hero-greeting">
    <h2>Access Control</h2>
    <h1>Sticker Management</h1>
  </div>
  <div class="hero-cards">
    <div class="hero-card">
      <h3>Total Issued</h3>
      <p><%= stickers.length %></p>
    </div>
    <div class="hero-card hero-card--primary">
      <h3>Active Stickers</h3>
      <p><%= stickers.filter((sticker) => stickerDisplayStatus(sticker) === 'active').length %></p>
    </div>
  </div>
  <% if (pageFlash) { %>
    <div class="flash flash-<%= pageFlash.type === 'success' ? 'success' : 'error' %> flash-spaced">
      <%= pageFlash.type === 'success' ? '✅' : '⚠️' %> <%= pageFlash.message %>
    </div>
  <% } %>
</section>

<div class="overlap-wrapper">
  <section class="panel">
    <div class="section-head">
      <h2>Sticker Issuance</h2>
      <p>Create secure QR-enabled stickers for validated student vehicles.</p>
    </div>
  <form method="post" action="/stickers" class="form-grid">
    <label for="st_vehicle_id">Vehicle</label>
    <select id="st_vehicle_id" name="vehicle_id" required>
      <option value="">Select vehicle</option>
      <% vehicles.forEach(vehicle => { %>
        <option value="<%= vehicle.id %>">
          <%= vehicle.plate_number %> — <%= vehicle.student_number %> — <%= vehicle.full_name %>
        </option>
      <% }) %>
    </select>

    <label for="st_expires">Expiration Date (optional)</label>
    <input id="st_expires" type="date" name="expires_at" />

    <button type="submit">Issue Sticker</button>
  </form>
</section>

  <section class="panel">
    <div class="section-head">
      <h2>Issued Stickers</h2>
      <p>Total records: <strong><%= stickers.length %></strong></p>
    </div>
  <div class="table-wrap desktop-only-table ops-table-shell">
    <table>
      <thead>
        <tr>
          <th>Sticker Code</th>
          <th>Student</th>
          <th>Plate Number</th>
          <th>Status</th>
          <th>Expires</th>
          <th>QR Code</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (stickers.length === 0) { %>
          <tr class="table-empty-row">
            <td colspan="7" class="table-empty-cell">
              <div class="empty-state">
                <div class="empty-state-icon">🪪</div>
                <p>No stickers issued yet. Use the form above to issue one.</p>
              </div>
            </td>
          </tr>
        <% } %>
        <% stickers.forEach(sticker => {
          const displayStatus = stickerDisplayStatus(sticker);
          const badgeClass = displayStatus === 'active' ? 'valid' : displayStatus;
        %>
          <tr>
            <td><strong><%= sticker.sticker_code %></strong></td>
            <td><%= sticker.student_number %> <span class="record-secondary"><%= sticker.full_name %></span></td>
            <td><span class="badge badge-plate"><%= sticker.plate_number %></span></td>
            <td>
              <span class="badge badge-<%= badgeClass %>">
                <%= displayStatus %>
              </span>
            </td>
            <td class="table-muted"><%= sticker.expires_at ? new Date(sticker.expires_at).toLocaleDateString() : "No expiry" %></td>
            <td>
              <div class="action-row table-action-row">
                <a href="/stickers/<%= sticker.id %>/qr" target="_blank" class="link-btn">View QR</a>
                <a href="/stickers/<%= sticker.id %>/qr" download="sticker-<%= sticker.sticker_code %>.png" class="link-btn">Download</a>
                <a href="/stickers/<%= sticker.id %>/print" target="_blank" class="link-btn">Print card</a>
                <button type="button" class="link-btn copy-sticker-link" data-copy-url="<%= stickerBaseUrl %>/verify/<%= sticker.qr_token %>">Copy link</button>
                <% if (displayStatus === "active" && sticker.email) { %>
                  <button type="button" class="link-btn email-preview-btn"
                    data-email-preview data-sticker-id="<%= sticker.id %>"
                    data-student-name="<%= sticker.full_name %>" data-student-number="<%= sticker.student_number %>"
                    data-plate-number="<%= sticker.plate_number %>" data-sticker-code="<%= sticker.sticker_code %>"
                    data-recipient="<%= sticker.email %>">Email QR</button>
                <% } else if (displayStatus === "active") { %>
                  <span class="helper-text" title="Add an email address in Student Management first">No email</span>
                <% } %>
                <% if (sticker.email_status) { %>
                  <span class="badge badge-<%= ['sent', 'queued', 'retrying', 'sending'].includes(sticker.email_status) ? 'soft' : 'invalid' %>"><%= sticker.email_status %></span>
                <% } %>
              </div>
              <div class="helper-text">Last used: <%= sticker.last_scanned_at ? new Date(sticker.last_scanned_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : 'Never' %> · QR replacements: <%= Number(sticker.qr_rotation_count || 0) %><% if (Number(sticker.rejected_scan_count || 0) > 0) { %> · Rejected scans: <%= sticker.rejected_scan_count %><% } %></div>
            </td>
            <td class="table-actions-cell">
              <% if (sticker.status === "active") { %>
                <button type="button" class="btn-sm" data-destructive-trigger data-form-id="rotateStickerDesktop_<%= sticker.id %>" data-confirm-title="Replace this QR code?" data-confirm-message="The previous QR for <%= sticker.sticker_code %> will stop working immediately. Use this for a lost or exposed QR." data-confirm-label="Replace QR">Replace QR</button>
                <form id="rotateStickerDesktop_<%= sticker.id %>" class="destructive-form" method="post" action="/stickers/<%= sticker.id %>/rotate" hidden><input type="hidden" name="reason" value="Lost, exposed, or administratively replaced QR" /></form>
                <button type="button" class="danger btn-sm" data-destructive-trigger data-form-id="revokeStickerDesktop_<%= sticker.id %>" data-confirm-title="Revoke sticker?" data-confirm-message="Revoke sticker <%= sticker.sticker_code %>? It will no longer grant parking access." data-confirm-label="Revoke sticker">Revoke</button>
                <form id="revokeStickerDesktop_<%= sticker.id %>" class="destructive-form" method="post" action="/stickers/<%= sticker.id %>/revoke" hidden></form>
              <% } else { %>
                <span class="helper-text">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Mobile-Ready Cards -->
  <div class="mobile-data-list">
    <% if (stickers.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">🪪</div>
        <p>No stickers issued yet.</p>
      </div>
    <% } %>
    <% stickers.forEach(sticker => { 
      const displayStatus = stickerDisplayStatus(sticker);
      const badgeClass = displayStatus === 'active' ? 'valid' : displayStatus;
    %>
      <div class="mobile-data-card">
        <div class="card-header">
          <div class="card-title">Code: <%= sticker.sticker_code %></div>
          <span class="badge badge-<%= badgeClass %>"><%= displayStatus %></span>
        </div>
        <div class="card-body">
          <div class="card-item">👤 <strong>Owner:</strong> <%= sticker.full_name %></div>
          <div class="card-item">🚗 <strong>Plate:</strong> <%= sticker.plate_number %></div>
          <div class="card-item">📅 <strong>Expires:</strong> <%= sticker.expires_at ? new Date(sticker.expires_at).toLocaleDateString() : "Never" %></div>
        </div>
        <div class="card-actions">
          <div class="mobile-button-grid">
            <a href="/stickers/<%= sticker.id %>/qr" target="_blank" class="btn btn-mobile-touch">View QR</a>
            <a href="/stickers/<%= sticker.id %>/qr" download class="btn btn-mobile-touch">Download</a>
            <a href="/stickers/<%= sticker.id %>/print" target="_blank" class="btn btn-mobile-touch">Print card</a>
            <% if (displayStatus === "active" && sticker.email) { %>
              <button type="button" class="btn btn-mobile-touch email-preview-btn"
                data-email-preview data-sticker-id="<%= sticker.id %>"
                data-student-name="<%= sticker.full_name %>" data-student-number="<%= sticker.student_number %>"
                data-plate-number="<%= sticker.plate_number %>" data-sticker-code="<%= sticker.sticker_code %>"
                data-recipient="<%= sticker.email %>">Email QR</button>
            <% } %>
          </div>
          <% if (displayStatus === "active" && !sticker.email) { %>
            <span class="helper-text">Add the student's email address to enable email delivery.</span>
          <% } %>
          <% if (sticker.status === "active") { %>
            <button type="button" class="btn-mobile-touch" data-destructive-trigger data-form-id="rotateStickerMobile_<%= sticker.id %>" data-confirm-title="Replace this QR code?" data-confirm-message="The previous QR will stop working immediately." data-confirm-label="Replace QR">Replace QR</button>
            <form id="rotateStickerMobile_<%= sticker.id %>" class="destructive-form" method="post" action="/stickers/<%= sticker.id %>/rotate" hidden><input type="hidden" name="reason" value="Lost, exposed, or administratively replaced QR" /></form>
            <button type="button" class="danger btn-mobile-touch" data-destructive-trigger data-form-id="revokeStickerMobile_<%= sticker.id %>" data-confirm-title="Revoke sticker?" data-confirm-message="Revoke sticker <%= sticker.sticker_code %>? It will no longer grant parking access." data-confirm-label="Revoke sticker">Revoke Sticker</button>
            <form id="revokeStickerMobile_<%= sticker.id %>" class="destructive-form" method="post" action="/stickers/<%= sticker.id %>/revoke" hidden></form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
  </section>

  <section class="panel" id="email-deliveries">
    <div class="section-head">
      <h2>QR Email Delivery</h2>
      <p>Messages are sent in the background. Failed deliveries can be safely retried.</p>
    </div>
    <div class="email-delivery-list">
      <% safeEmailDeliveries.forEach((delivery) => { %>
        <article class="email-delivery-item">
          <div>
            <strong><%= delivery.sticker_code %> · <%= delivery.full_name %></strong>
            <span><%= delivery.recipient %> · Requested <%= new Date(delivery.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %></span>
            <% if (delivery.last_error) { %><span class="email-delivery-error"><%= delivery.last_error %></span><% } %>
          </div>
          <div class="email-delivery-actions">
            <span class="badge badge-<%= delivery.status === 'sent' ? 'valid' : delivery.status === 'failed' ? 'invalid' : 'soft' %>"><%= delivery.status %></span>
            <span class="helper-text"><%= delivery.attempts %>/<%= delivery.max_attempts %> attempt(s)</span>
            <% if (delivery.status === 'failed') { %>
              <form method="post" action="/admin/email-deliveries/<%= delivery.id %>/retry" class="inline-form"><button type="submit" class="btn-sm">Retry</button></form>
            <% } %>
          </div>
        </article>
      <% }) %>
      <% if (!safeEmailDeliveries.length) { %><div class="empty-state"><p>No QR email deliveries have been requested.</p></div><% } %>
    </div>
  </section>
</div>

<div class="modal-shell" id="emailPreviewModal" hidden aria-hidden="true">
  <button type="button" class="modal-backdrop" data-email-preview-close aria-label="Close email preview"></button>
  <section class="modal-card email-preview-card" role="dialog" aria-modal="true" aria-labelledby="emailPreviewTitle">
    <div class="section-head"><h2 id="emailPreviewTitle">Confirm QR email</h2><p>Review the recipient and QR before adding it to the delivery queue.</p></div>
    <div class="email-preview-layout">
      <img id="emailPreviewQr" width="180" height="180" alt="QR code that will be emailed" />
      <div class="email-preview-details">
        <p><span>Student</span><strong id="emailPreviewStudent">-</strong></p>
        <p><span>Student number</span><strong id="emailPreviewNumber">-</strong></p>
        <p><span>Vehicle</span><strong id="emailPreviewPlate">-</strong></p>
        <p><span>Sticker</span><strong id="emailPreviewCode">-</strong></p>
        <p><span>Recipient</span><strong id="emailPreviewRecipient">-</strong></p>
      </div>
    </div>
    <div class="form-actions">
      <button type="button" class="btn-cancel-sm" data-email-preview-close>Cancel</button>
      <form method="post" id="emailPreviewForm"><button type="submit">Queue Email</button></form>
    </div>
  </section>
</div>

<script nonce="<%= cspNonce %>">
  document.addEventListener("click", async (event) => {
    const button = event.target instanceof Element ? event.target.closest(".copy-sticker-link") : null;
    if (!button) return;
    const url = button.getAttribute("data-copy-url");
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      const original = button.textContent;
      button.textContent = "Copied";
      window.setTimeout(() => { button.textContent = original; }, 1400);
    } catch (_error) {
      window.prompt("Copy verification link:", url);
    }
  });

  (() => {
    const modal = document.getElementById("emailPreviewModal");
    const qr = document.getElementById("emailPreviewQr");
    const form = document.getElementById("emailPreviewForm");
    let lastTrigger = null;
    const fields = {
      student: document.getElementById("emailPreviewStudent"),
      number: document.getElementById("emailPreviewNumber"),
      plate: document.getElementById("emailPreviewPlate"),
      code: document.getElementById("emailPreviewCode"),
      recipient: document.getElementById("emailPreviewRecipient")
    };
    const close = () => {
      modal.hidden = true;
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");
      lastTrigger?.focus();
      lastTrigger = null;
    };
    document.addEventListener("click", (event) => {
      const openButton = event.target instanceof Element ? event.target.closest("[data-email-preview]") : null;
      if (openButton) {
        const stickerId = Number(openButton.dataset.stickerId);
        if (!Number.isInteger(stickerId) || stickerId <= 0) return;
        lastTrigger = openButton;
        fields.student.textContent = openButton.dataset.studentName || "-";
        fields.number.textContent = openButton.dataset.studentNumber || "-";
        fields.plate.textContent = openButton.dataset.plateNumber || "-";
        fields.code.textContent = openButton.dataset.stickerCode || "-";
        fields.recipient.textContent = openButton.dataset.recipient || "-";
        qr.src = `/stickers/${stickerId}/qr`;
        form.action = `/stickers/${stickerId}/email`;
        modal.hidden = false;
        modal.setAttribute("aria-hidden", "false");
        document.body.classList.add("modal-open");
        form.querySelector("button")?.focus();
        return;
      }
      if (event.target instanceof Element && event.target.closest("[data-email-preview-close]")) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.hidden) close();
    });
  })();
</script>

<%- include("partials/footer") %>
