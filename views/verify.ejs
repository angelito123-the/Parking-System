<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NAAP - Gate Verification</title>
  <script nonce="<%= cspNonce %>">
    (() => {
      try {
        const savedTheme = localStorage.getItem("theme");
        const theme = savedTheme === "dark" || savedTheme === "light"
          ? savedTheme
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      } catch (_) {}
    })();
  </script>
  <link rel="stylesheet" href="/vendor/phosphor/style.css?v=2.1.2" />
  <link rel="stylesheet" href="/styles.css?v=20260912-forms" />
  <link rel="stylesheet" href="/design-system.css?v=20260912-forms" />
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      font-family: "Outfit", sans-serif;
      color: var(--text);
    }

    .verify-shell {
      max-width: 980px;
      margin: 0 auto;
      padding: 1.2rem;
    }

    .verify-header {
      background: #11263f;
      border-radius: var(--ui-radius-card);
      padding: 1rem 1.2rem;
      color: #fff;
      margin-bottom: 1rem;
      border: 1px solid #213b58;
    }

    .verify-header h1 {
      margin: 0;
      font-size: 1.15rem;
      letter-spacing: 0.02em;
    }

    .verify-header p {
      margin: 0.2rem 0 0;
      color: #cbd5e1;
      font-size: 0.84rem;
    }

    .verify-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .verify-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--ui-radius-card);
      box-shadow: none;
      padding: 1rem;
    }

    .status-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border-radius: 999px;
      border: 1px solid;
      font-weight: 700;
      font-size: 0.8rem;
      padding: 0.35rem 0.7rem;
      margin-bottom: 0.75rem;
    }

    .status-chip.valid {
      color: var(--status-success-text);
      background: var(--status-success-bg);
      border-color: var(--status-success-border);
    }

    .status-chip.invalid,
    .status-chip.revoked {
      color: var(--status-danger-text);
      background: var(--status-danger-bg);
      border-color: var(--status-danger-border);
    }

    .status-chip.expired {
      color: var(--status-warning-text);
      background: var(--status-warning-bg);
      border-color: var(--status-warning-border);
    }

    .verify-label {
      margin: 0 0 0.3rem;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      font-weight: 700;
    }

    .verify-msg {
      margin: 0;
      font-size: 0.92rem;
      color: var(--text-secondary);
    }

    .verify-summary {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 0.85rem;
    }

    .verify-summary div {
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 0.55rem;
      background: var(--surface-soft);
      text-align: center;
    }

    .verify-summary span {
      display: block;
      font-size: 0.72rem;
      color: var(--muted);
      margin-bottom: 0.2rem;
    }

    .verify-summary strong {
      font-size: 1rem;
    }

    .info-list {
      display: grid;
      gap: 0.5rem;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.45rem;
      font-size: 0.9rem;
    }

    .info-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .info-row .k {
      color: var(--muted);
      font-weight: 600;
    }

    .info-row .v {
      text-align: right;
      font-weight: 700;
      color: var(--text);
      word-break: break-word;
    }

    .map-head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .legend {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      font-size: 0.74rem;
      color: var(--muted);
    }

    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .dot {
      width: 12px;
      height: 12px;
      border-radius: 4px;
      border: 1px solid var(--status-neutral-border);
      background: var(--status-neutral-bg);
    }

    .dot.available { background: var(--status-success-text); border-color: var(--status-success-border); }
    .dot.occupied { background: var(--status-warning-text); border-color: var(--status-warning-border); }
    .dot.disabled { background: var(--status-neutral-text); border-color: var(--status-neutral-border); }

    .zone-block {
      border: 1px solid var(--line);
      border-radius: var(--ui-radius-card);
      padding: 0.7rem;
      background: var(--surface-soft);
      margin-bottom: 0.7rem;
    }

    .zone-title {
      margin: 0 0 0.6rem;
      font-size: 0.82rem;
      letter-spacing: 0.04em;
      color: var(--text-secondary);
      text-transform: uppercase;
      font-weight: 700;
    }

    .slot-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
      gap: 0.45rem;
    }

    .slot-btn {
      border: 1px solid var(--status-neutral-border);
      border-radius: 10px;
      min-height: 70px;
      font-weight: 800;
      font-size: 0.8rem;
      color: var(--status-neutral-text);
      background: var(--status-neutral-bg);
      cursor: pointer;
      transition: border-color 0.12s ease, background-color 0.12s ease;
      padding: 0.2rem;
      display: grid;
      place-items: center;
      text-align: center;
    }

    .slot-btn small {
      display: block;
      font-weight: 500;
      font-size: 0.62rem;
      opacity: 0.9;
      margin-top: 0.1rem;
    }

    .slot-btn.available {
      color: var(--status-success-text);
      border-color: var(--status-success-border);
      background: var(--status-success-bg);
    }

    .slot-btn.occupied {
      color: var(--status-warning-text);
      border-color: var(--status-warning-border);
      background: var(--status-warning-bg);
      cursor: not-allowed;
    }

    .slot-btn.disabled { cursor: not-allowed; }

    .slot-btn.available:hover,
    .slot-btn.available:focus-visible {
      border-color: var(--status-success-text);
      outline: 2px solid color-mix(in srgb, var(--status-success-text) 28%, transparent);
      outline-offset: 1px;
    }

    .slot-btn.selected {
      color: var(--status-info-text);
      border-color: var(--status-info-text);
      background: var(--status-info-bg);
      box-shadow: none;
      outline: 2px solid color-mix(in srgb, var(--status-info-text) 30%, transparent);
      outline-offset: 1px;
    }

    .movement-form {
      display: grid;
      gap: 0.75rem;
    }

    .movement-form input {
      width: 100%;
      box-sizing: border-box;
      color: var(--text);
      border: 1px solid var(--line-strong);
      border-radius: var(--ui-radius-control);
      background: var(--surface);
      padding: 0.7rem 0.75rem;
      font-size: 0.95rem;
      font-family: inherit;
    }

    .movement-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem;
    }

    .movement-btn {
      min-height: 48px;
      border: 1px solid transparent;
      border-radius: var(--ui-radius-control);
      padding: 0.85rem;
      font-family: inherit;
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      color: #fff;
    }

    .movement-btn.entry { border-color: var(--ui-success); background: var(--ui-success); }
    .movement-btn.exit { border-color: var(--ui-danger); background: var(--ui-danger); }

    .notice {
      border-radius: 10px;
      border: 1px solid;
      padding: 0.65rem 0.75rem;
      font-size: 0.83rem;
      margin-bottom: 0.75rem;
    }

    .notice.ok {
      background: var(--status-success-bg);
      border-color: var(--status-success-border);
      color: var(--status-success-text);
    }

    .notice.warn {
      background: var(--status-warning-bg);
      border-color: var(--status-warning-border);
      color: var(--status-warning-text);
    }

    .verify-grid.is-public {
      grid-template-columns: minmax(0, 680px);
      justify-content: center;
    }

    .privacy-card {
      text-align: center;
    }

    .privacy-lock {
      width: 48px;
      height: 48px;
      margin: 0 auto 0.8rem;
      display: grid;
      place-items: center;
      color: var(--status-info-text);
      border: 1px solid var(--status-info-border);
      border-radius: 14px;
      background: var(--status-info-bg);
    }

    .privacy-lock .ph {
      font-size: 23px;
    }

    .privacy-card h2 {
      margin: 0;
      font-size: 1.05rem;
    }

    .privacy-card .verify-msg {
      max-width: 470px;
      margin: 0.45rem auto 0;
    }

    .privacy-login-link {
      margin-top: 1rem;
      display: inline-flex;
      min-height: var(--ui-control-height);
      align-items: center;
      justify-content: center;
      padding: 0.65rem 0.9rem;
      color: #fff;
      border: 1px solid var(--ui-primary);
      border-radius: var(--ui-radius-control);
      background: var(--ui-primary);
      font-size: 0.84rem;
      font-weight: 750;
      text-decoration: none;
    }

    .verify-count-available { color: var(--status-success-text); }
    .verify-count-occupied { color: var(--status-warning-text); }

    @media (max-width: 768px), (any-pointer: coarse) {
      .movement-form input,
      .movement-btn,
      .privacy-login-link,
      .slot-btn {
        min-height: var(--ui-touch-target);
      }
    }

    @media (min-width: 860px) {
      .verify-grid {
        grid-template-columns: 340px 1fr;
      }
    }
  </style>
</head>
<body class="verify-page">
  <%
    const vResult = result.result || "INVALID";
    const statusClass = result.ok ? "valid" : String(vResult).toLowerCase();
    const roleNow = String(currentRole || "").toLowerCase();
    const canViewPrivateDetails = roleNow === "admin" || roleNow === "guard";
    const canRecordMovement = roleNow === "guard";
    const slotOverview = parkingSlotOverview || { slots: [], summary: { total: 0, available: 0, occupied: 0, disabled: 0 } };
    const slots = Array.isArray(slotOverview.slots) ? slotOverview.slots : [];
    const grouped = slots.reduce((acc, slot) => {
      const key = slot.zone || "General";
      if (!acc[key]) acc[key] = [];
      acc[key].push(slot);
      return acc;
    }, {});
  %>

  <div class="verify-shell">
    <header class="verify-header">
      <h1>NAAP Parking Verification</h1>
      <p>Gate entry authorization and slot assignment panel</p>
    </header>

    <div class="verify-grid <%= canViewPrivateDetails ? "" : "is-public" %>">
      <section class="verify-card">
        <div class="status-chip <%= statusClass %>"><%= vResult %></div>
        <p class="verify-label">Verification Message</p>
        <p class="verify-msg"><%= result.message || "No message available." %></p>

        <% if (result.scanned_at) { %>
          <p class="verify-label" style="margin-top:0.75rem;">Last Scan Timestamp</p>
          <p class="verify-msg"><%= new Date(result.scanned_at).toLocaleString('en-US', { timeZone: 'Asia/Manila' }) %></p>
        <% } %>

        <% if (result.movement_saved) { %>
          <div class="notice ok" style="margin-top:0.9rem;">
            Movement recorded successfully: <strong><%= result.action %></strong>
          </div>
        <% } %>

        <% if (result.duplicate_movement) { %>
          <div class="notice warn" style="margin-top:0.9rem;">
            <%= result.message %>
          </div>
        <% } %>

        <% if (canViewPrivateDetails && result.sticker) { %>
          <p class="verify-label" style="margin-top:0.9rem;">Student and Vehicle</p>
          <div class="info-list">
            <div class="info-row"><span class="k">Student</span><span class="v"><%= result.sticker.full_name || "-" %></span></div>
            <div class="info-row"><span class="k">Student Number</span><span class="v"><%= result.sticker.student_number || "-" %></span></div>
            <div class="info-row"><span class="k">Plate Number</span><span class="v"><%= result.sticker.plate_number || "-" %></span></div>
            <div class="info-row"><span class="k">Vehicle</span><span class="v"><%= result.sticker.model || "-" %></span></div>
            <div class="info-row"><span class="k">Sticker</span><span class="v"><%= result.sticker.sticker_code || "-" %></span></div>
            <div class="info-row"><span class="k">Current Slot</span><span class="v"><%= result.current_slot ? result.current_slot.slot_code : "Not Assigned" %></span></div>
          </div>
        <% } %>
      </section>

      <% if (canViewPrivateDetails) { %>
      <section class="verify-card">
        <div class="map-head">
          <div>
            <p class="verify-label" style="margin:0;">Campus Overview</p>
            <p class="verify-msg" style="font-size:0.82rem; margin-top:0.2rem;">Select only green slots for ENTRY.</p>
          </div>
          <div class="legend">
            <span class="legend-item"><span class="dot available"></span>Available</span>
            <span class="legend-item"><span class="dot occupied"></span>Occupied</span>
            <span class="legend-item"><span class="dot disabled"></span>Disabled</span>
          </div>
        </div>

        <div class="verify-summary">
          <div><span>Total</span><strong><%= slotOverview.summary?.total || 0 %></strong></div>
          <div><span>Available</span><strong class="verify-count-available"><%= slotOverview.summary?.available || 0 %></strong></div>
          <div><span>Occupied</span><strong class="verify-count-occupied"><%= slotOverview.summary?.occupied || 0 %></strong></div>
        </div>

        <% if (result.ok && !result.movement_saved && canRecordMovement) { %>
          <form method="post" action="/verify/<%= result.sticker.qr_token %>/movement" id="movementForm" class="movement-form" style="margin-top:0.95rem;">
            <label class="verify-label" for="gateField" style="margin-bottom:0;">Gate Name</label>
            <input id="gateField" name="gate" value="Main Gate" />
            <input type="hidden" name="slot_id" id="slotIdField" value="" />

            <% Object.keys(grouped).forEach(zone => { %>
              <div class="zone-block">
                <p class="zone-title"><%= zone %></p>
                <div class="slot-grid">
                  <% grouped[zone].forEach(slot => { %>
                    <button
                      type="button"
                      class="slot-btn <%= slot.occupancy %>"
                      data-slot-id="<%= slot.id %>"
                      data-occupancy="<%= slot.occupancy %>"
                      data-slot-code="<%= slot.slot_code %>"
                      <%= slot.is_selectable ? "" : "disabled" %>>
                      <span><%= slot.slot_code %></span>
                      <small><%= slot.occupancy === 'available' && slot.slot_type !== 'standard' ? `${slot.slot_type.toUpperCase()}${slot.reserved_for ? ` · ${slot.reserved_for}` : ''}` : slot.occupancy.toUpperCase() %></small>
                    </button>
                  <% }) %>
                </div>
              </div>
            <% }) %>

            <div class="movement-actions">
              <button type="submit" name="action" value="ENTRY" id="entryBtn" class="movement-btn entry">Record ENTRY</button>
              <button type="submit" name="action" value="EXIT" id="exitBtn" class="movement-btn exit">Record EXIT</button>
            </div>
            <p id="movementHint" class="verify-msg" style="font-size:0.8rem; margin:0;"></p>
          </form>
        <% } %>

        <% if (result.ok && !result.movement_saved && !canRecordMovement) { %>
          <p class="verify-msg" style="margin-top:0.95rem;">
            Only a guard account can record ENTRY or EXIT.
          </p>
        <% } %>

        <% if (!result.ok && !result.sticker) { %>
          <p class="verify-msg" style="margin-top:0.95rem;">Entry and exit controls are shown only for valid active stickers.</p>
        <% } %>
      </section>
      <% } else { %>
      <section class="verify-card privacy-card">
        <div class="privacy-lock" aria-hidden="true">
          <i class="ph ph-lock-key"></i>
        </div>
        <h2>Personal details are protected</h2>
        <p class="verify-msg">Student identity, vehicle information, current location, and parking availability are visible only to authorized staff.</p>
        <a class="privacy-login-link" href="/login">Staff sign in</a>
      </section>
      <% } %>
    </div>
  </div>

  <script nonce="<%= cspNonce %>">
    (() => {
      const form = document.getElementById("movementForm");
      if (!form) return;

      const slotButtons = Array.from(document.querySelectorAll(".slot-btn.available"));
      const slotIdField = document.getElementById("slotIdField");
      const entryBtn = document.getElementById("entryBtn");
      const exitBtn = document.getElementById("exitBtn");
      const movementHint = document.getElementById("movementHint");
      let selectedSlotCode = "";

      slotButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          slotButtons.forEach((item) => item.classList.remove("selected"));
          btn.classList.add("selected");
          slotIdField.value = btn.dataset.slotId || "";
          selectedSlotCode = btn.dataset.slotCode || "";
          if (movementHint) {
            movementHint.textContent = selectedSlotCode
              ? `Selected slot for ENTRY: ${selectedSlotCode}`
              : "";
          }
        });
      });

      form.addEventListener("submit", (event) => {
        const submitter = event.submitter;
        if (submitter && submitter.value === "ENTRY" && slotButtons.length > 0 && !slotIdField.value) {
          event.preventDefault();
          if (movementHint) movementHint.textContent = "Please select an available parking slot before recording ENTRY.";
          return;
        }

        if (entryBtn) entryBtn.disabled = true;
        if (exitBtn) exitBtn.disabled = true;
      });
    })();
  </script>
</body>
</html>
