<%- include("partials/header") %>

<% const pageFlash = typeof flash !== 'undefined' ? flash : null; %>

<section class="dashboard-hero">
  <div class="hero-greeting">
    <h2>Access Control</h2>
    <h1>Students &amp; Vehicles</h1>
  </div>
  <div class="hero-cards">
    <div class="hero-card">
      <h3>Enrolled Students</h3>
      <p><%= students.length %></p>
    </div>
    <div class="hero-card">
      <h3>Registered Vehicles</h3>
      <p><%= students.reduce((t, s) => t + (s.vehicles ? s.vehicles.length : 0), 0) %></p>
    </div>
  </div>
  <% if (pageFlash) { %>
    <div class="flash flash-<%= pageFlash.type === 'success' ? 'success' : 'error' %>" style="margin-top: 1rem;">
      <strong><%= pageFlash.type === 'success' ? 'Success:' : 'Notice:' %></strong> <%= pageFlash.message %>
    </div>
  <% } %>
</section>

<div class="overlap-wrapper">
  <section class="panel flow-assist-panel">
    <div class="section-head">
      <h2>Registration Flow</h2>
      <p>Switch between creating records and managing existing students.</p>
    </div>
    <div class="flow-tabs" role="tablist" aria-label="Students workflow tabs">
      <button type="button" class="flow-tab-btn is-active" data-flow-tab="register" aria-selected="true">1. Register</button>
      <button type="button" class="flow-tab-btn" data-flow-tab="directory" aria-selected="false">2. Directory</button>
    </div>
  </section>

  <!-- section -->
  <section class="reg-panel" data-flow-view="register">
    <div class="section-head">
      <h2>New Registration</h2>
      <p>Register a student. You may also add their vehicle in the same step - vehicle fields are optional.</p>
    </div>

    <form method="post" action="/students" class="form-grid" id="regForm">
      <!-- Student Fields -->
      <div class="form-group-label">Student Information</div>
      <div class="form-row-2">
        <div>
          <label for="s_student_number">Student Number <span class="req">*</span></label>
          <input id="s_student_number" name="student_number" required placeholder="e.g. 2024-00123" />
        </div>
        <div>
          <label for="s_full_name">Full Name <span class="req">*</span></label>
          <input id="s_full_name" name="full_name" required placeholder="Last Name, First Name M." />
        </div>
      </div>
      <div class="form-row-academic">
        <div>
          <label for="s_program">Course <span class="req">*</span></label>
          <select id="s_program" name="program" required>
            <option value="" selected disabled>Select a course</option>
            <% academicProgramGroups.forEach(group => { %>
              <optgroup label="<%= group.institute %>">
                <% group.programs.forEach(program => { %>
                  <option value="<%= program.name %>"><%= program.code ? program.code + ' — ' : '' %><%= program.name %></option>
                <% }) %>
              </optgroup>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="s_year_level">Year Level <span class="req">*</span></label>
          <select id="s_year_level" name="year_level" required>
            <option value="" selected disabled>Select year</option>
            <% yearLevels.forEach(year => { %>
              <option value="<%= year.value %>"><%= year.label %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-row-email">
        <div>
          <label for="s_email">Email Address</label>
          <input id="s_email" name="email" type="email" placeholder="student@school.edu.ph" />
        </div>
      </div>

      <!-- Vehicle Toggle -->
      <div class="vehicle-toggle-row">
        <button type="button" class="btn-ghost" id="vehicleToggle" onclick="toggleVehicleSection()">Add Vehicle Details</button>
      </div>

      <!-- Vehicle Fields (hidden by default) -->
      <div id="vehicleSection" class="vehicle-section" style="display:none;">
        <div class="form-group-label" style="margin-top:0;">Vehicle Information <span class="optional-label">(optional)</span></div>
        <div class="form-row-2">
          <div>
            <label for="v_plate">Plate Number</label>
            <input id="v_plate" name="plate_number" placeholder="e.g. ABC 1234" />
          </div>
          <div>
            <label for="v_model">Vehicle Model</label>
            <input id="v_model" name="model" placeholder="e.g. Honda Click 125i" />
          </div>
        </div>
        <div class="form-row-2">
          <div>
            <label for="v_color">Color</label>
            <input id="v_color" name="color" placeholder="e.g. Black" />
          </div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" id="regSubmitBtn">Save Student</button>
      </div>
    </form>
  </section>

  <!-- section -->
  <section class="directory-panel" data-flow-view="directory">
    <div class="section-head">
      <h2>Student Directory</h2>
      <p>Search student records, update account details, and manage registered vehicles.</p>
    </div>

    <div class="table-tools directory-toolbar">
      <div class="directory-search">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.8-3.8"></path>
        </svg>
        <label for="studentSearch" class="sr-only">Search students</label>
        <input
          id="studentSearch"
          type="search"
          autocomplete="off"
          placeholder="Search students or plate numbers"
        />
        <button type="button" id="studentSearchClear" class="icon-btn directory-search-clear" aria-label="Clear search" hidden>
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="m7 7 10 10M17 7 7 17"></path>
          </svg>
        </button>
      </div>
      <p class="directory-count" aria-live="polite">
        <span class="directory-count-dot" aria-hidden="true"></span>
        <span id="studentSearchCount">Showing <%= students.length %> student<%= students.length === 1 ? '' : 's' %></span>
      </p>
    </div>

    <% if (students.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M16 19v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1"></path>
            <circle cx="9.5" cy="7" r="3"></circle>
            <path d="M17 11a3 3 0 1 0 0-6"></path>
            <path d="M21 19v-1.3a4 4 0 0 0-2.8-3.8"></path>
          </svg>
        </div>
        <p>No students registered yet. Open the Register tab to add one.</p>
      </div>
    <% } %>

    <div id="studentDirectory" class="student-directory">
    <% students.forEach(student => { %>
      <div class="student-card" data-searchable="<%= student.student_number %> <%= student.full_name %> <%= student.program_name %> <%= student.program_display %> <%= student.year_level_label %> <%= student.email %> <%= (student.vehicles || []).map(v => v.plate_number + ' ' + v.model).join(' ') %>">

        <!-- section -->
        <div class="sc-header">
          <div class="sc-meta">
            <div class="sc-avatar" aria-hidden="true"><%= String(student.full_name || 'S').trim().charAt(0).toUpperCase() %></div>
            <div class="sc-identity-copy">
              <div class="sc-name"><%= student.full_name %></div>
              <span class="student-number-badge">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="M7 9h4M7 13h6M16 10h1M16 14h1"></path>
                </svg>
                Student no. <strong><%= student.student_number %></strong>
              </span>
            </div>
          </div>
          <div class="sc-header-actions">
            <button type="button" class="btn-edit-sm" onclick="toggleStudentEdit(<%= student.id %>)" id="editStudentBtn_<%= student.id %>" aria-controls="studentEditForm_<%= student.id %>" aria-expanded="false">Edit</button>
            <form style="margin:0;" method="post" action="/students/<%= student.id %>/delete"
                  onsubmit="return confirm('Delete <%= student.full_name %>? This will also remove all their vehicles and cannot be undone.')">
              <button type="submit" class="btn-delete-sm">Delete</button>
            </form>
          </div>
        </div>

        <!-- Student Info Row -->
        <div class="sc-info-row">
          <div class="sc-info-item sc-info-course">
            <span class="sc-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="m3 10 9-5 9 5-9 5-9-5Z"></path>
                <path d="M7 12.5V16c2.8 2 7.2 2 10 0v-3.5M21 10v5"></path>
              </svg>
            </span>
            <span class="sc-info-copy">
              <span>Course</span>
              <strong class="<%= student.program_display ? '' : 'is-empty' %>" title="<%= student.program_name || '' %>"><%= student.program_display || 'Not provided' %></strong>
            </span>
          </div>
          <div class="sc-info-item">
            <span class="sc-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                <path d="M8 3v4M16 3v4M4 10h16M8 14h3M8 17h5"></path>
              </svg>
            </span>
            <span class="sc-info-copy">
              <span>Year Level</span>
              <strong class="<%= student.year_level_label ? '' : 'is-empty' %>"><%= student.year_level_label || 'Not provided' %></strong>
            </span>
          </div>
          <div class="sc-info-item">
            <span class="sc-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m4 7 8 6 8-6"></path>
              </svg>
            </span>
            <span class="sc-info-copy">
              <span>Email address</span>
              <strong class="<%= student.email ? '' : 'is-empty' %>"><%= student.email || 'Not provided' %></strong>
            </span>
          </div>
        </div>

        <!-- section -->
        <div class="inline-edit-form" id="studentEditForm_<%= student.id %>" style="display:none;">
          <form method="post" action="/students/<%= student.id %>/edit" class="edit-form-grid">
            <div class="form-row-2">
              <div>
                <label>Student Number</label>
                <input name="student_number" value="<%= student.student_number %>" required />
              </div>
              <div>
                <label>Full Name</label>
                <input name="full_name" value="<%= student.full_name %>" required />
              </div>
            </div>
            <div class="form-row-academic">
              <div>
                <label for="editStudentCourse_<%= student.id %>">Course</label>
                <select id="editStudentCourse_<%= student.id %>" name="program" required>
                  <% if (student.program && !student.program_is_official) { %>
                    <option value="<%= student.program %>" selected>Current legacy course — <%= student.program %></option>
                  <% } else if (!student.program) { %>
                    <option value="" selected disabled>Select a course</option>
                  <% } %>
                  <% academicProgramGroups.forEach(group => { %>
                    <optgroup label="<%= group.institute %>">
                      <% group.programs.forEach(program => { %>
                        <option value="<%= program.name %>" <%= student.program === program.name ? 'selected' : '' %>><%= program.code ? program.code + ' — ' : '' %><%= program.name %></option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </div>
              <div>
                <label for="editStudentYear_<%= student.id %>">Year Level</label>
                <select id="editStudentYear_<%= student.id %>" name="year_level" required>
                  <option value="" <%= student.year_level ? '' : 'selected' %> disabled>Select year</option>
                  <% yearLevels.forEach(year => { %>
                    <option value="<%= year.value %>" <%= String(student.year_level || '') === year.value ? 'selected' : '' %>><%= year.label %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="form-row-email">
              <div>
                <label for="editStudentEmail_<%= student.id %>">Email Address</label>
                <input id="editStudentEmail_<%= student.id %>" name="email" type="email" value="<%= student.email || '' %>" />
              </div>
            </div>
            <div class="edit-form-actions">
              <button type="submit" class="btn-save-sm">Save Changes</button>
              <button type="button" class="btn-cancel-sm" onclick="toggleStudentEdit(<%= student.id %>)">Cancel</button>
            </div>
          </form>
        </div>

        <!-- section -->
        <div class="sc-vehicles">
          <div class="sv-header">
            <span class="sv-title">
              Registered vehicles
              <span class="sv-count"><%= (student.vehicles || []).length %></span>
            </span>
            <button type="button" class="btn-add-vehicle" onclick="toggleAddVehicle(<%= student.id %>)" id="addVehicleBtn_<%= student.id %>" aria-controls="addVehicleForm_<%= student.id %>" aria-expanded="false">
              <span aria-hidden="true">+</span> Add vehicle
            </button>
          </div>

          <!-- Add Vehicle Inline Form -->
          <div class="inline-edit-form add-vehicle-form" id="addVehicleForm_<%= student.id %>" style="display:none;">
            <form method="post" action="/vehicles" class="edit-form-grid">
              <input type="hidden" name="student_id" value="<%= student.id %>" />
              <div class="form-row-3">
                <div>
                  <label>Plate Number <span class="req">*</span></label>
                  <input name="plate_number" required placeholder="e.g. ABC 1234" />
                </div>
                <div>
                  <label>Model</label>
                  <input name="model" placeholder="e.g. Honda Click 125i" />
                </div>
                <div>
                  <label>Color</label>
                  <input name="color" placeholder="e.g. Black" />
                </div>
              </div>
              <div class="edit-form-actions">
                <button type="submit" class="btn-save-sm">Register Vehicle</button>
                <button type="button" class="btn-cancel-sm" onclick="toggleAddVehicle(<%= student.id %>)">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Vehicle List -->
          <% if (!student.vehicles || student.vehicles.length === 0) { %>
            <div class="sv-empty" id="svEmpty_<%= student.id %>">No vehicles registered yet.</div>
          <% } %>

          <% (student.vehicles || []).forEach(vehicle => { %>
            <div class="sv-item" id="svItem_<%= vehicle.id %>">
              <div class="sv-item-main">
                <div class="sv-vehicle-identity">
                  <span class="sv-vehicle-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 16h14l-1.5-6a2 2 0 0 0-2-1.5h-7A2 2 0 0 0 6.5 10L5 16Z"></path>
                      <path d="M4 13h16M7 16v2M17 16v2"></path>
                      <circle cx="8" cy="14" r=".8"></circle>
                      <circle cx="16" cy="14" r=".8"></circle>
                    </svg>
                  </span>
                  <span class="sv-vehicle-copy">
                    <span class="sv-plate"><%= vehicle.plate_number %></span>
                    <span class="sv-description">
                      <span class="sv-model"><%= vehicle.model || 'Unknown model' %></span>
                      <% if (vehicle.color) { %>
                        <span aria-hidden="true">&bull;</span>
                        <span class="sv-color"><%= vehicle.color %></span>
                      <% } %>
                    </span>
                  </span>
                </div>
                <div class="sv-item-actions">
                  <button type="button" class="btn-edit-xs" onclick="toggleVehicleEdit(<%= vehicle.id %>)" id="editVehicleBtn_<%= vehicle.id %>" aria-controls="vehicleEditForm_<%= vehicle.id %>" aria-expanded="false">Edit</button>
                  <form style="margin:0;" method="post" action="/vehicles/<%= vehicle.id %>/delete"
                        onsubmit="return confirm('Delete vehicle <%= vehicle.plate_number %>? This cannot be undone.')">
                    <button type="submit" class="btn-delete-xs">Delete</button>
                  </form>
                </div>
              </div>

              <!-- Inline Vehicle Edit Form -->
              <div class="inline-edit-form vehicle-edit-form" id="vehicleEditForm_<%= vehicle.id %>" style="display:none;">
                <form method="post" action="/vehicles/<%= vehicle.id %>/edit" class="edit-form-grid">
                  <div class="form-row-3">
                    <div>
                      <label>Plate Number</label>
                      <input name="plate_number" value="<%= vehicle.plate_number %>" required />
                    </div>
                    <div>
                      <label>Model</label>
                      <input name="model" value="<%= vehicle.model || '' %>" />
                    </div>
                    <div>
                      <label>Color</label>
                      <input name="color" value="<%= vehicle.color || '' %>" />
                    </div>
                  </div>
                  <div class="edit-form-actions">
                    <button type="submit" class="btn-save-sm">Save</button>
                    <button type="button" class="btn-cancel-sm" onclick="toggleVehicleEdit(<%= vehicle.id %>)">Cancel</button>
                  </div>
                </form>
              </div>
            </div>
          <% }) %>
        </div>

      </div>
    <% }) %>
    </div>
    <div id="studentNoResults" class="directory-no-results" hidden>
      <span class="directory-no-results-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.8-3.8M8.5 11h5"></path>
        </svg>
      </span>
      <strong>No matching students</strong>
      <p>Try a name, student number, course, year level, email address, or plate number.</p>
      <button type="button" id="studentNoResultsClear" class="btn-clear-search">Clear search</button>
    </div>
  </section>
</div>

<!-- section -->
<style>
  .overlap-wrapper {
    display: grid;
    gap: 1.75rem;
  }

  .flow-assist-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .flow-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  button.flow-tab-btn {
    border: 1px solid var(--line-strong);
    background: var(--surface-soft);
    color: var(--text-secondary);
    border-radius: 9px;
    padding: 0.55rem 0.88rem;
    font-size: 0.82rem;
    font-weight: 700;
    box-shadow: none;
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  button.flow-tab-btn:hover {
    border-color: rgba(37, 99, 235, 0.35);
    background: var(--blue-soft);
    color: var(--blue-mid);
    box-shadow: none;
    transform: none;
  }

  button.flow-tab-btn.is-active,
  button.flow-tab-btn.is-active:hover {
    background: var(--blue-mid);
    border-color: var(--blue-mid);
    color: #ffffff;
    box-shadow: 0 5px 12px rgba(37, 99, 235, 0.18);
  }

  button.flow-tab-btn:focus-visible {
    outline: 3px solid rgba(37, 99, 235, 0.22);
    outline-offset: 2px;
  }

  .reg-panel,
  .directory-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem;
  }

  .section-head {
    margin-bottom: 1.1rem;
  }

  .section-head h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 760;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .section-head p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    max-width: 70ch;
  }

  .form-group-label {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
    margin-top: 0.6rem;
  }

  .form-group-label::after {
    content: "";
    height: 1px;
    min-width: 2rem;
    flex: 1;
    background: var(--line);
  }

  .form-row-2,
  .form-row-3,
  .form-row-academic,
  .form-row-email {
    display: grid;
    gap: 0.8rem;
  }

  .form-row-2 {
    grid-template-columns: 1fr 1fr;
  }

  .form-row-3 {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .form-row-academic {
    grid-template-columns: minmax(0, 2fr) minmax(170px, 0.7fr);
  }

  .form-row-email {
    grid-template-columns: minmax(0, 1fr);
    max-width: 720px;
  }

  .form-row-2 > div,
  .form-row-3 > div,
  .form-row-academic > div,
  .form-row-email > div {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 0.36rem;
  }

  .form-row-2 > div > label,
  .form-row-3 > div > label,
  .form-row-academic > div > label,
  .form-row-email > div > label {
    display: block;
    margin: 0;
  }

  .form-row-2 > div > input,
  .form-row-2 > div > select,
  .form-row-3 > div > input,
  .form-row-3 > div > select,
  .form-row-academic > div > input,
  .form-row-academic > div > select,
  .form-row-email > div > input,
  .form-row-email > div > select {
    width: 100%;
  }

  .form-actions {
    margin-top: 0.7rem;
  }

  .req {
    color: var(--red-text);
  }

  .optional-label {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0;
  }

  .vehicle-toggle-row {
    margin: 0.6rem 0 0.25rem;
  }

  .vehicle-section {
    background: color-mix(in oklab, var(--surface-soft) 92%, #ffffff 8%);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.05rem;
    display: grid;
    gap: 0.7rem;
    animation: revealUp 0.2s ease;
  }

  .btn-ghost {
    background: var(--surface-soft);
    border: 1px solid var(--line-strong);
    color: var(--text-secondary);
    font-size: 0.83rem;
    font-weight: 650;
    padding: 0.56rem 0.95rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease;
    width: auto;
    box-shadow: none;
  }

  .btn-ghost:hover {
    background: var(--surface);
    border-color: var(--blue-mid);
    color: var(--blue-mid);
  }

  .table-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
    flex-wrap: wrap;
  }

  .directory-search {
    position: relative;
    flex: 1 1 440px;
    max-width: 640px;
  }

  .directory-search > svg {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    width: 1.05rem;
    height: 1.05rem;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.9;
    stroke-linecap: round;
    pointer-events: none;
  }

  .table-tools .directory-search input[type="search"] {
    width: 100%;
    max-width: none;
    min-height: 44px;
    padding: 0.66rem 2.7rem 0.66rem 2.65rem;
    border-color: var(--line-strong);
    background: var(--surface);
  }

  .table-tools .directory-search input[type="search"]::-webkit-search-cancel-button {
    appearance: none;
  }

  button.directory-search-clear {
    position: absolute;
    top: 50%;
    right: 0.55rem;
    width: 30px;
    height: 30px;
    padding: 0;
    transform: translateY(-50%);
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    display: inline-grid;
    place-items: center;
    cursor: pointer;
