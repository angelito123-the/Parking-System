<%- include("partials/header") %>

<%
  const pageFlash = typeof flash !== 'undefined' ? flash : null;
  const safeFilters = typeof filters === 'object' && filters ? filters : {
    q: '', course: '', year_level: '', vehicle_status: 'all', sticker_status: 'all', sort: 'registered', direction: 'desc'
  };
  const safePagination = typeof pagination === 'object' && pagination ? pagination : {
    page: 1, pageSize: 10, total: students.length, totalPages: 1, from: students.length ? 1 : 0, to: students.length
  };
  const safeDirectorySummary = typeof directorySummary === 'object' && directorySummary
    ? directorySummary
    : { students: students.length, vehicles: students.reduce((total, student) => total + (student.vehicles || []).length, 0) };
  const directoryQuery = typeof makeStudentDirectoryQuery === 'function'
    ? makeStudentDirectoryQuery
    : (() => '/students#directory');
  const hasDirectoryFilters = Boolean(
    safeFilters.q || safeFilters.course || safeFilters.year_level
    || safeFilters.vehicle_status !== 'all' || safeFilters.sticker_status !== 'all'
  );
%>

<section class="dashboard-hero">
  <div class="hero-greeting">
    <h2>Access Control</h2>
    <h1>Students &amp; Vehicles</h1>
  </div>
  <div class="hero-cards">
    <div class="hero-card">
      <h3>Enrolled Students</h3>
      <p><%= safeDirectorySummary.students %></p>
    </div>
    <div class="hero-card">
      <h3>Registered Vehicles</h3>
      <p><%= safeDirectorySummary.vehicles %></p>
    </div>
  </div>
  <% if (pageFlash) { %>
    <div class="flash flash-spaced flash-<%= pageFlash.type === 'success' ? 'success' : 'error' %>">
      <strong><%= pageFlash.type === 'success' ? 'Success:' : 'Notice:' %></strong> <%= pageFlash.message %>
    </div>
  <% } %>
</section>

<div class="overlap-wrapper">
  <section class="panel flow-assist-panel">
    <div class="section-head">
      <h2>Registration Flow</h2>
      <p>Switch between creating records and managing existing students.</p>
    </div>
    <div class="flow-tabs" role="tablist" aria-label="Students workflow tabs">
      <button type="button" class="flow-tab-btn is-active" data-flow-tab="register" aria-selected="true">1. Register</button>
      <button type="button" class="flow-tab-btn" data-flow-tab="directory" aria-selected="false">2. Directory</button>
    </div>
  </section>

  <!-- section -->
  <section class="reg-panel" data-flow-view="register">
    <div class="section-head">
      <h2>New Registration</h2>
      <p>Register a student. You may also add their vehicle in the same step - vehicle fields are optional.</p>
    </div>

    <form method="post" action="/students" class="form-grid" id="regForm">
      <!-- Student Fields -->
      <div class="form-group-label">Student Information</div>
      <div class="form-row-2">
        <div>
          <label for="s_student_number">Student Number <span class="req">*</span></label>
          <input id="s_student_number" name="student_number" required placeholder="e.g. 2024-00123" />
        </div>
        <div>
          <label for="s_full_name">Full Name <span class="req">*</span></label>
          <input id="s_full_name" name="full_name" required placeholder="Last Name, First Name M." />
        </div>
      </div>
      <div class="form-row-academic">
        <div>
          <label for="s_program">Course <span class="req">*</span></label>
          <select id="s_program" name="program" required>
            <option value="" selected disabled>Select a course</option>
            <% academicProgramGroups.forEach(group => { %>
              <optgroup label="<%= group.institute %>">
                <% group.programs.forEach(program => { %>
                  <option value="<%= program.name %>"><%= program.code ? program.code + ' — ' : '' %><%= program.name %></option>
                <% }) %>
              </optgroup>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="s_year_level">Year Level <span class="req">*</span></label>
          <select id="s_year_level" name="year_level" required>
            <option value="" selected disabled>Select year</option>
            <% yearLevels.forEach(year => { %>
              <option value="<%= year.value %>"><%= year.label %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-row-email">
        <div>
          <label for="s_email">Email Address</label>
          <input id="s_email" name="email" type="email" placeholder="student@school.edu.ph" />
        </div>
      </div>

      <!-- Vehicle Toggle -->
      <div class="vehicle-toggle-row">
        <button type="button" class="btn-ghost" id="vehicleToggle" data-ui-action="toggle-registration-vehicle">Add Vehicle Details</button>
      </div>

      <!-- Vehicle Fields (hidden by default) -->
      <div id="vehicleSection" class="vehicle-section" hidden>
        <div class="form-group-label no-top-margin">Vehicle Information <span class="optional-label">(optional)</span></div>
        <div class="form-row-2">
          <div>
            <label for="v_plate">Plate Number</label>
            <input id="v_plate" name="plate_number" placeholder="e.g. ABC 1234" />
          </div>
          <div>
            <label for="v_model">Vehicle Model</label>
            <input id="v_model" name="model" placeholder="e.g. Honda Click 125i" />
          </div>
        </div>
        <div class="form-row-2">
          <div>
            <label for="v_color">Color</label>
            <input id="v_color" name="color" placeholder="e.g. Black" />
          </div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" id="regSubmitBtn">Save Student</button>
      </div>
    </form>
  </section>

  <!-- section -->
  <section class="directory-panel" data-flow-view="directory">
    <div class="directory-heading-row">
      <div class="section-head">
        <h2>Student Directory</h2>
        <p>Search student records, update account details, and manage registered vehicles.</p>
      </div>
      <div class="directory-heading-actions">
        <a class="btn-directory-secondary" href="/students/import/template" download>Download template</a>
        <button type="button" class="btn-directory-primary" id="studentImportToggle" aria-controls="studentImportPanel" aria-expanded="false">Import CSV</button>
      </div>
    </div>

    <section class="student-import-panel" id="studentImportPanel" hidden aria-labelledby="studentImportTitle">
      <div class="student-import-heading">
        <div>
          <h3 id="studentImportTitle">Bulk student import</h3>
          <p>Choose a CSV, review every row, then confirm. Existing student numbers will be updated; new ones will be created.</p>
        </div>
        <button type="button" class="student-import-close" id="studentImportClose" aria-label="Close CSV import">&times;</button>
      </div>
      <div class="student-import-file-row">
        <div>
          <label for="studentCsvFile">Student CSV file</label>
          <input id="studentCsvFile" type="file" accept=".csv,text/csv" />
          <small>Required headers: student_number, full_name, program, year_level. Email is optional. Maximum 2 MB or 2,000 rows.</small>
        </div>
        <button type="button" class="btn-directory-primary" id="studentCsvPreviewButton" disabled>Validate and preview</button>
      </div>
      <div class="student-import-status" id="studentImportStatus" aria-live="polite">Select a CSV file to begin.</div>
      <div id="studentImportResults" hidden>
        <div class="student-import-summary" id="studentImportSummary"></div>
        <div class="student-import-messages" id="studentImportMessages"></div>
        <div class="student-import-table-wrap">
          <table class="student-import-table">
            <thead><tr><th>Row</th><th>Student</th><th>Course</th><th>Year</th><th>Email</th><th>Result</th></tr></thead>
            <tbody id="studentImportPreviewBody"></tbody>
          </table>
        </div>
        <form method="post" action="/students/import" id="studentImportConfirmForm" class="student-import-confirm">
          <textarea name="csv_data" id="studentImportCsvData" hidden required></textarea>
          <input type="hidden" name="preview_token" id="studentImportPreviewToken" />
          <p id="studentImportConfirmHint">Import remains locked until every row is valid.</p>
          <button type="submit" id="studentImportConfirmButton" disabled>Import validated students</button>
        </form>
      </div>
    </section>

    <form class="directory-filter-form" method="get" action="/students#directory">
      <div class="directory-search directory-filter-search">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.8-3.8"></path>
        </svg>
        <label for="studentSearch" class="sr-only">Search students</label>
        <input
          id="studentSearch"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Search students or plate numbers"
          value="<%= safeFilters.q %>"
        />
      </div>
      <div class="directory-filter-field">
        <label for="directoryCourse">Course</label>
        <select id="directoryCourse" name="course">
          <option value="">All courses</option>
          <% academicProgramGroups.forEach(group => { %>
            <optgroup label="<%= group.institute %>">
              <% group.programs.forEach(program => { %>
                <option value="<%= program.name %>" <%= safeFilters.course === program.name ? 'selected' : '' %>><%= program.code || program.name %></option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
      </div>
      <div class="directory-filter-field">
        <label for="directoryYear">Year level</label>
        <select id="directoryYear" name="year_level">
          <option value="">All years</option>
          <% yearLevels.forEach(year => { %>
            <option value="<%= year.value %>" <%= safeFilters.year_level === year.value ? 'selected' : '' %>><%= year.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="directory-filter-field">
        <label for="directoryVehicleStatus">Vehicle</label>
        <select id="directoryVehicleStatus" name="vehicle_status">
          <option value="all" <%= safeFilters.vehicle_status === 'all' ? 'selected' : '' %>>Any status</option>
          <option value="with_vehicle" <%= safeFilters.vehicle_status === 'with_vehicle' ? 'selected' : '' %>>Has vehicle</option>
          <option value="without_vehicle" <%= safeFilters.vehicle_status === 'without_vehicle' ? 'selected' : '' %>>No vehicle</option>
        </select>
      </div>
      <div class="directory-filter-field">
        <label for="directoryStickerStatus">Sticker</label>
        <select id="directoryStickerStatus" name="sticker_status">
          <option value="all" <%= safeFilters.sticker_status === 'all' ? 'selected' : '' %>>Any status</option>
          <option value="active" <%= safeFilters.sticker_status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="expired" <%= safeFilters.sticker_status === 'expired' ? 'selected' : '' %>>Expired</option>
          <option value="revoked" <%= safeFilters.sticker_status === 'revoked' ? 'selected' : '' %>>Revoked</option>
          <option value="none" <%= safeFilters.sticker_status === 'none' ? 'selected' : '' %>>No sticker</option>
        </select>
      </div>
      <div class="directory-filter-field">
        <label for="directorySort">Sort by</label>
        <select id="directorySort" name="sort">
          <option value="name" <%= safeFilters.sort === 'name' ? 'selected' : '' %>>Name</option>
          <option value="course" <%= safeFilters.sort === 'course' ? 'selected' : '' %>>Course</option>
          <option value="year" <%= safeFilters.sort === 'year' ? 'selected' : '' %>>Year level</option>
          <option value="registered" <%= safeFilters.sort === 'registered' ? 'selected' : '' %>>Registration date</option>
        </select>
      </div>
      <div class="directory-filter-field directory-order-field">
        <label for="directoryDirection">Order</label>
        <select id="directoryDirection" name="direction">
          <option value="asc" <%= safeFilters.direction === 'asc' ? 'selected' : '' %>>Ascending</option>
          <option value="desc" <%= safeFilters.direction === 'desc' ? 'selected' : '' %>>Descending</option>
        </select>
      </div>
      <input type="hidden" name="page_size" value="<%= safePagination.pageSize %>" />
      <div class="directory-filter-actions">
        <button type="submit" class="btn-filter-apply">Apply filters</button>
        <% if (hasDirectoryFilters) { %><a class="btn-filter-clear" href="/students#directory">Reset</a><% } %>
      </div>
    </form>

    <div class="directory-results-bar">
      <p class="directory-count" aria-live="polite">
        <span class="directory-count-dot" aria-hidden="true"></span>
        <span>Showing <%= safePagination.from %>–<%= safePagination.to %> of <%= safePagination.total %> student<%= safePagination.total === 1 ? '' : 's' %></span>
      </p>
      <form method="get" action="/students#directory" class="directory-page-size-form">
        <% ['q', 'course', 'year_level', 'vehicle_status', 'sticker_status', 'sort', 'direction'].forEach(key => { %>
          <% if (safeFilters[key] && safeFilters[key] !== 'all') { %><input type="hidden" name="<%= key %>" value="<%= safeFilters[key] %>" /><% } %>
        <% }) %>
        <label for="directoryPageSize">Rows</label>
        <select id="directoryPageSize" name="page_size">
          <% [10, 25, 50].forEach(size => { %><option value="<%= size %>" <%= safePagination.pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %>
        </select>
      </form>
    </div>

    <% if (students.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M16 19v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1"></path>
            <circle cx="9.5" cy="7" r="3"></circle>
            <path d="M17 11a3 3 0 1 0 0-6"></path>
            <path d="M21 19v-1.3a4 4 0 0 0-2.8-3.8"></path>
          </svg>
        </div>
        <p><%= hasDirectoryFilters ? 'No students match the selected filters.' : 'No students registered yet. Open the Register tab to add one.' %></p>
      </div>
    <% } %>

    <% if (students.length > 0) { %>
    <div class="student-directory-columns" aria-hidden="true">
      <span>Student</span><span>Course</span><span>Year</span><span>Sticker</span><span>Registered</span><span>Actions</span>
    </div>
    <div id="studentDirectory" class="student-directory">
    <% students.forEach(student => { %>
      <div class="student-card" data-searchable="<%= student.student_number %> <%= student.full_name %> <%= student.program_name %> <%= student.program_display %> <%= student.year_level_label %> <%= student.email %> <%= (student.vehicles || []).map(v => v.plate_number + ' ' + v.model).join(' ') %>">

        <!-- section -->
        <div class="sc-header">
          <div class="sc-meta">
            <div class="sc-avatar" aria-hidden="true"><%= String(student.full_name || 'S').trim().charAt(0).toUpperCase() %></div>
            <div class="sc-identity-copy">
              <div class="sc-name"><%= student.full_name %></div>
              <span class="student-number-badge">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="M7 9h4M7 13h6M16 10h1M16 14h1"></path>
                </svg>
                Student no. <strong><%= student.student_number %></strong>
              </span>
              <span class="sc-email"><%= student.email || 'No email address' %></span>
            </div>
          </div>
          <div class="sc-header-actions">
            <button type="button" class="btn-details-sm" data-ui-action="toggle-student-details" data-target-id="<%= student.id %>" id="studentDetailsBtn_<%= student.id %>" aria-controls="studentDetails_<%= student.id %>" aria-expanded="false">Details</button>
            <button type="button" class="btn-edit-sm" data-ui-action="toggle-student-edit" data-target-id="<%= student.id %>" id="editStudentBtn_<%= student.id %>" aria-controls="studentEditForm_<%= student.id %>" aria-expanded="false">Edit</button>
            <div class="action-menu">
              <button type="button" class="action-menu-trigger" data-action-menu-trigger aria-label="More actions for <%= student.full_name %>" aria-haspopup="menu" aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.4"></circle><circle cx="12" cy="12" r="1.4"></circle><circle cx="12" cy="19" r="1.4"></circle></svg>
              </button>
              <div class="action-menu-popover" role="menu">
                <button type="button" class="action-menu-danger" role="menuitem" data-destructive-trigger data-form-id="deleteStudentForm_<%= student.id %>" data-confirm-title="Delete student?" data-confirm-message="Delete <%= student.full_name %> and all linked vehicles and stickers? This cannot be undone." data-confirm-label="Delete student">Delete student</button>
              </div>
            </div>
            <form id="deleteStudentForm_<%= student.id %>" class="destructive-form" method="post" action="/students/<%= student.id %>/delete" hidden>
            </form>
          </div>
        </div>

        <!-- Student Info Row -->
        <div class="sc-info-row">
          <div class="sc-info-item sc-info-course">
            <span class="sc-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="m3 10 9-5 9 5-9 5-9-5Z"></path>
                <path d="M7 12.5V16c2.8 2 7.2 2 10 0v-3.5M21 10v5"></path>
              </svg>
            </span>
            <span class="sc-info-copy">
              <span>Course</span>
              <strong class="<%= student.program_display ? '' : 'is-empty' %>" title="<%= student.program_name || '' %>"><%= student.program_display || 'Not provided' %></strong>
            </span>
          </div>
          <div class="sc-info-item sc-info-year">
            <span class="sc-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                <path d="M8 3v4M16 3v4M4 10h16M8 14h3M8 17h5"></path>
              </svg>
            </span>
            <span class="sc-info-copy">
              <span>Year Level</span>
              <strong class="<%= student.year_level_label ? '' : 'is-empty' %>"><%= student.year_level_label || 'Not provided' %></strong>
            </span>
          </div>
          <div class="sc-info-item sc-info-email">
            <span class="sc-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m4 7 8 6 8-6"></path>
              </svg>
            </span>
            <span class="sc-info-copy">
              <span>Email address</span>
              <strong class="<%= student.email ? '' : 'is-empty' %>"><%= student.email || 'Not provided' %></strong>
            </span>
          </div>
          <div class="sc-info-item sc-info-sticker">
            <span class="sc-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 5h10l4 4-10 10-4-4V5Z"></path><circle cx="10" cy="10" r="1.3"></circle></svg>
            </span>
            <span class="sc-info-copy">
              <span>Sticker</span>
              <strong><span class="vehicle-sticker-status state-<%= student.sticker_status %>"><%= student.sticker_status === 'none' ? 'No sticker' : student.sticker_status.charAt(0).toUpperCase() + student.sticker_status.slice(1) %></span></strong>
            </span>
          </div>
          <div class="sc-info-item sc-info-registered">
            <span class="sc-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M8 3v4M16 3v4M4 10h16"></path></svg>
            </span>
            <span class="sc-info-copy">
              <span>Registered</span>
              <strong><%= student.created_at ? new Date(student.created_at).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Unknown' %></strong>
            </span>
          </div>
        </div>

        <!-- section -->
        <div class="inline-edit-form" id="studentEditForm_<%= student.id %>" hidden>
          <form method="post" action="/students/<%= student.id %>/edit" class="edit-form-grid">
            <div class="form-row-2">
              <div>
                <label>Student Number</label>
                <input name="student_number" value="<%= student.student_number %>" required />
              </div>
              <div>
                <label>Full Name</label>
                <input name="full_name" value="<%= student.full_name %>" required />
              </div>
            </div>
            <div class="form-row-academic">
              <div>
                <label for="editStudentCourse_<%= student.id %>">Course</label>
                <select id="editStudentCourse_<%= student.id %>" name="program" required>
                  <% if (student.program && !student.program_is_official) { %>
                    <option value="<%= student.program %>" selected>Current legacy course — <%= student.program %></option>
                  <% } else if (!student.program) { %>
                    <option value="" selected disabled>Select a course</option>
                  <% } %>
                  <% academicProgramGroups.forEach(group => { %>
                    <optgroup label="<%= group.institute %>">
                      <% group.programs.forEach(program => { %>
                        <option value="<%= program.name %>" <%= student.program === program.name ? 'selected' : '' %>><%= program.code ? program.code + ' — ' : '' %><%= program.name %></option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </div>
              <div>
                <label for="editStudentYear_<%= student.id %>">Year Level</label>
                <select id="editStudentYear_<%= student.id %>" name="year_level" required>
                  <option value="" <%= student.year_level ? '' : 'selected' %> disabled>Select year</option>
                  <% yearLevels.forEach(year => { %>
                    <option value="<%= year.value %>" <%= String(student.year_level || '') === year.value ? 'selected' : '' %>><%= year.label %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="form-row-email">
              <div>
                <label for="editStudentEmail_<%= student.id %>">Email Address</label>
                <input id="editStudentEmail_<%= student.id %>" name="email" type="email" value="<%= student.email || '' %>" />
              </div>
            </div>
            <div class="edit-form-actions">
              <button type="submit" class="btn-save-sm">Save Changes</button>
              <button type="button" class="btn-cancel-sm" data-ui-action="toggle-student-edit" data-target-id="<%= student.id %>">Cancel</button>
            </div>
          </form>
        </div>

        <!-- section -->
        <div class="sc-vehicles" id="studentDetails_<%= student.id %>" hidden>
          <div class="sv-header">
            <span class="sv-title">
              Registered vehicles
              <span class="sv-count"><%= (student.vehicles || []).length %></span>
            </span>
            <button type="button" class="btn-add-vehicle" data-ui-action="toggle-add-vehicle" data-target-id="<%= student.id %>" id="addVehicleBtn_<%= student.id %>" aria-controls="addVehicleForm_<%= student.id %>" aria-expanded="false">
              <span aria-hidden="true">+</span> Add vehicle
            </button>
          </div>

          <!-- Add Vehicle Inline Form -->
          <div class="inline-edit-form add-vehicle-form" id="addVehicleForm_<%= student.id %>" hidden>
            <form method="post" action="/vehicles" class="edit-form-grid">
              <input type="hidden" name="student_id" value="<%= student.id %>" />
              <div class="form-row-3">
                <div>
                  <label>Plate Number <span class="req">*</span></label>
                  <input name="plate_number" required placeholder="e.g. ABC 1234" />
                </div>
                <div>
                  <label>Model</label>
                  <input name="model" placeholder="e.g. Honda Click 125i" />
                </div>
                <div>
                  <label>Color</label>
                  <input name="color" placeholder="e.g. Black" />
                </div>
              </div>
              <div class="edit-form-actions">
                <button type="submit" class="btn-save-sm">Register Vehicle</button>
                <button type="button" class="btn-cancel-sm" data-ui-action="toggle-add-vehicle" data-target-id="<%= student.id %>">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Vehicle List -->
          <% if (!student.vehicles || student.vehicles.length === 0) { %>
            <div class="sv-empty" id="svEmpty_<%= student.id %>">No vehicles registered yet.</div>
          <% } %>

          <% (student.vehicles || []).forEach(vehicle => { %>
            <div class="sv-item" id="svItem_<%= vehicle.id %>">
              <div class="sv-item-main">
                <div class="sv-vehicle-identity">
                  <span class="sv-vehicle-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 16h14l-1.5-6a2 2 0 0 0-2-1.5h-7A2 2 0 0 0 6.5 10L5 16Z"></path>
                      <path d="M4 13h16M7 16v2M17 16v2"></path>
                      <circle cx="8" cy="14" r=".8"></circle>
                      <circle cx="16" cy="14" r=".8"></circle>
                    </svg>
                  </span>
                  <span class="sv-vehicle-copy">
                    <span class="sv-plate"><%= vehicle.plate_number %></span>
                    <span class="sv-description">
                      <span class="sv-model"><%= vehicle.model || 'Unknown model' %></span>
                      <% if (vehicle.color) { %>
                        <span aria-hidden="true">&bull;</span>
                        <span class="sv-color"><%= vehicle.color %></span>
                      <% } %>
                    </span>
                    <% const stickerState = vehicle.latest_sticker?.display_status || 'none'; %>
                    <span class="vehicle-sticker-status state-<%= stickerState %>"><%= stickerState === 'none' ? 'No sticker' : `${stickerState.charAt(0).toUpperCase()}${stickerState.slice(1)} sticker` %></span>
                  </span>
                </div>
                <div class="sv-item-actions">
                  <button type="button" class="btn-edit-xs" data-ui-action="toggle-vehicle-edit" data-target-id="<%= vehicle.id %>" id="editVehicleBtn_<%= vehicle.id %>" aria-controls="vehicleEditForm_<%= vehicle.id %>" aria-expanded="false">Edit</button>
                  <div class="action-menu">
                    <button type="button" class="action-menu-trigger action-menu-trigger-compact" data-action-menu-trigger aria-label="More actions for vehicle <%= vehicle.plate_number %>" aria-haspopup="menu" aria-expanded="false">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.4"></circle><circle cx="12" cy="12" r="1.4"></circle><circle cx="12" cy="19" r="1.4"></circle></svg>
                    </button>
                    <div class="action-menu-popover" role="menu">
                      <button type="button" class="action-menu-danger" role="menuitem" data-destructive-trigger data-form-id="deleteVehicleForm_<%= vehicle.id %>" data-confirm-title="Delete vehicle?" data-confirm-message="Delete vehicle <%= vehicle.plate_number %> and its linked sticker records? This cannot be undone." data-confirm-label="Delete vehicle">Delete vehicle</button>
                    </div>
                  </div>
                  <form id="deleteVehicleForm_<%= vehicle.id %>" class="destructive-form" method="post" action="/vehicles/<%= vehicle.id %>/delete" hidden>
                  </form>
                </div>
              </div>

              <!-- Inline Vehicle Edit Form -->
              <div class="inline-edit-form vehicle-edit-form" id="vehicleEditForm_<%= vehicle.id %>" hidden>
                <form method="post" action="/vehicles/<%= vehicle.id %>/edit" class="edit-form-grid">
                  <div class="form-row-3">
                    <div>
                      <label>Plate Number</label>
                      <input name="plate_number" value="<%= vehicle.plate_number %>" required />
                    </div>
                    <div>
                      <label>Model</label>
                      <input name="model" value="<%= vehicle.model || '' %>" />
                    </div>
                    <div>
                      <label>Color</label>
                      <input name="color" value="<%= vehicle.color || '' %>" />
                    </div>
                  </div>
                  <div class="edit-form-actions">
                    <button type="submit" class="btn-save-sm">Save</button>
                    <button type="button" class="btn-cancel-sm" data-ui-action="toggle-vehicle-edit" data-target-id="<%= vehicle.id %>">Cancel</button>
                  </div>
                </form>
              </div>
            </div>
          <% }) %>
        </div>

      </div>
    <% }) %>
    </div>
    <% } %>
    <% if (safePagination.totalPages > 1) { %>
      <nav class="directory-pagination" aria-label="Student directory pages">
        <a class="pagination-control <%= safePagination.page <= 1 ? 'is-disabled' : '' %>" href="<%= safePagination.page > 1 ? directoryQuery({ page: safePagination.page - 1 }) : '#' %>" <%- safePagination.page <= 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>>Previous</a>
        <div class="pagination-pages">
          <%
            const firstPage = Math.max(1, safePagination.page - 2);
            const lastPage = Math.min(safePagination.totalPages, firstPage + 4);
            const visibleFirstPage = Math.max(1, lastPage - 4);
          %>
          <% for (let pageNumber = visibleFirstPage; pageNumber <= lastPage; pageNumber += 1) { %>
            <a class="pagination-page <%= pageNumber === safePagination.page ? 'is-active' : '' %>" href="<%= directoryQuery({ page: pageNumber }) %>" <%- pageNumber === safePagination.page ? 'aria-current="page"' : '' %>><%= pageNumber %></a>
          <% } %>
        </div>
        <a class="pagination-control <%= safePagination.page >= safePagination.totalPages ? 'is-disabled' : '' %>" href="<%= safePagination.page < safePagination.totalPages ? directoryQuery({ page: safePagination.page + 1 }) : '#' %>" <%- safePagination.page >= safePagination.totalPages ? 'aria-disabled="true" tabindex="-1"' : '' %>>Next</a>
      </nav>
    <% } %>
  </section>
</div>

