</style>

<script nonce="<%= cspNonce %>">
  // Toggle vehicle section in registration form
  function toggleVehicleSection() {
    const section = document.getElementById('vehicleSection');
    const btn = document.getElementById('vehicleToggle');
    const isVisible = !section.hidden;
    section.hidden = isVisible;
    btn.textContent = isVisible ? 'Add Vehicle Details' : 'Hide Vehicle Details';

    // Update submit button text
    const submitBtn = document.getElementById('regSubmitBtn');
    submitBtn.textContent = isVisible ? 'Save Student' : 'Save Student and Vehicle';
  }

  function toggleStudentDetails(id) {
    const details = document.getElementById('studentDetails_' + id);
    const button = document.getElementById('studentDetailsBtn_' + id);
    if (!details || !button) return;
    const isVisible = !details.hidden;
    details.hidden = isVisible;
    button.textContent = isVisible ? 'Details' : 'Hide details';
    button.setAttribute('aria-expanded', isVisible ? 'false' : 'true');
  }

  // Toggle student inline edit form
  function toggleStudentEdit(id) {
    const form = document.getElementById('studentEditForm_' + id);
    const btn = document.getElementById('editStudentBtn_' + id);
    const isVisible = !form.hidden;
    form.hidden = isVisible;
    btn.textContent = isVisible ? 'Edit' : 'Close';
    btn.setAttribute('aria-expanded', isVisible ? 'false' : 'true');
  }

  // Toggle vehicle inline edit form
  function toggleVehicleEdit(id) {
    const form = document.getElementById('vehicleEditForm_' + id);
    const btn = document.getElementById('editVehicleBtn_' + id);
    const isVisible = !form.hidden;
    form.hidden = isVisible;
    if (btn) {
      btn.textContent = isVisible ? 'Edit' : 'Close';
      btn.setAttribute('aria-expanded', isVisible ? 'false' : 'true');
    }
  }

  // Toggle add vehicle form per student
  function toggleAddVehicle(studentId) {
    const form = document.getElementById('addVehicleForm_' + studentId);
    const btn = document.getElementById('addVehicleBtn_' + studentId);
    const isVisible = !form.hidden;
    form.hidden = isVisible;
    btn.innerHTML = isVisible ? '<span aria-hidden="true">+</span> Add vehicle' : 'Cancel';
    btn.setAttribute('aria-expanded', isVisible ? 'false' : 'true');
  }

  document.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-ui-action]') : null;
    if (!button) return;
    const id = Number(button.dataset.targetId);
    switch (button.dataset.uiAction) {
      case 'toggle-registration-vehicle':
        toggleVehicleSection();
        break;
      case 'toggle-student-details':
        if (Number.isInteger(id) && id > 0) toggleStudentDetails(id);
        break;
      case 'toggle-student-edit':
        if (Number.isInteger(id) && id > 0) toggleStudentEdit(id);
        break;
      case 'toggle-vehicle-edit':
        if (Number.isInteger(id) && id > 0) toggleVehicleEdit(id);
        break;
      case 'toggle-add-vehicle':
        if (Number.isInteger(id) && id > 0) toggleAddVehicle(id);
        break;
      default:
        break;
    }
  });

  document.getElementById('directoryPageSize')?.addEventListener('change', (event) => {
    if (event.currentTarget.form) event.currentTarget.form.requestSubmit();
  });

  (() => {
    const tabButtons = Array.from(document.querySelectorAll(".flow-tab-btn[data-flow-tab]"));
    const sections = Array.from(document.querySelectorAll("[data-flow-view]"));
    if (!tabButtons.length || !sections.length) return;

    const setFlowView = (view) => {
      const target = view === "directory" ? "directory" : "register";
      sections.forEach((section) => {
        section.style.display = section.dataset.flowView === target ? "" : "none";
      });
      tabButtons.forEach((button) => {
        const active = button.dataset.flowTab === target;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-selected", active ? "true" : "false");
      });
    };

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => setFlowView(button.dataset.flowTab || "register"));
    });

    const params = new URLSearchParams(window.location.search);
    const hashView = String(window.location.hash || "").replace("#", "").trim().toLowerCase();
    const successParams = ["success", "vsuccess", "esuccess", "deleted", "vdeleted", "imported", "import_error"];
    const directoryParams = ["q", "course", "year_level", "vehicle_status", "sticker_status", "sort", "direction", "page", "page_size"];
    const hasSuccess = successParams.some((key) => params.has(key));
    const hasDirectoryQuery = directoryParams.some((key) => params.has(key));
    const defaultView = hashView === "directory" || hasSuccess || hasDirectoryQuery ? "directory" : "register";
    setFlowView(defaultView);
  })();

  (() => {
    const panel = document.getElementById('studentImportPanel');
    const toggle = document.getElementById('studentImportToggle');
    const close = document.getElementById('studentImportClose');
    const fileInput = document.getElementById('studentCsvFile');
    const previewButton = document.getElementById('studentCsvPreviewButton');
    const status = document.getElementById('studentImportStatus');
    const results = document.getElementById('studentImportResults');
    const summary = document.getElementById('studentImportSummary');
    const messages = document.getElementById('studentImportMessages');
    const previewBody = document.getElementById('studentImportPreviewBody');
    const csvData = document.getElementById('studentImportCsvData');
    const previewToken = document.getElementById('studentImportPreviewToken');
    const confirmButton = document.getElementById('studentImportConfirmButton');
    const confirmHint = document.getElementById('studentImportConfirmHint');
    if (!panel || !toggle || !fileInput || !previewButton) return;

    const setPanelOpen = (open) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) fileInput.focus();
    };

    const resetPreview = (message = 'Select a CSV file to begin.') => {
      results.hidden = true;
      summary.replaceChildren();
      messages.replaceChildren();
      previewBody.replaceChildren();
      csvData.value = '';
      previewToken.value = '';
      confirmButton.disabled = true;
      status.classList.remove('is-error');
      status.textContent = message;
    };

    const addSummaryItem = (label, value) => {
      const item = document.createElement('div');
      const caption = document.createElement('span');
      const number = document.createElement('strong');
      caption.textContent = label;
      number.textContent = String(value);
      item.append(caption, number);
      summary.append(item);
    };

    const renderMessages = (data) => {
      const items = [
        ...(Array.isArray(data.headerErrors) ? data.headerErrors : []),
        ...(Array.isArray(data.headerWarnings) ? data.headerWarnings : [])
      ];
      messages.replaceChildren();
      messages.classList.toggle('has-errors', data.headerErrors?.length > 0);
      if (!items.length) {
        messages.textContent = 'Headers are valid. Review the row results below before importing.';
        return;
      }
      const list = document.createElement('ul');
      items.forEach((message) => {
        const item = document.createElement('li');
        item.textContent = message;
        list.append(item);
      });
      messages.append(list);
    };

    const renderRows = (rows) => {
      previewBody.replaceChildren();
      rows.forEach((row) => {
        const tableRow = document.createElement('tr');
        tableRow.classList.toggle('is-invalid', row.action === 'invalid');
        const values = [
          row.rowNumber,
          `${row.fullName || 'Missing name'}\n${row.studentNumber || 'Missing student number'}`,
          row.programCode || row.program || 'Missing course',
          row.yearLevel || 'Missing',
          row.email || 'Optional'
        ];
        values.forEach((value, index) => {
          const cell = document.createElement('td');
          cell.textContent = String(value);
          if (index === 1) cell.classList.add('student-import-student-cell');
          tableRow.append(cell);
        });
        const resultCell = document.createElement('td');
        const badge = document.createElement('span');
        badge.className = `student-import-result is-${row.action}`;
        badge.textContent = row.action;
        resultCell.append(badge);
        if (Array.isArray(row.issues) && row.issues.length) {
          const issue = document.createElement('span');
          issue.className = 'student-import-issues';
          issue.textContent = row.issues.join(' ');
          resultCell.append(issue);
        }
        tableRow.append(resultCell);
        previewBody.append(tableRow);
      });
    };

    toggle.addEventListener('click', () => setPanelOpen(panel.hidden));
    close?.addEventListener('click', () => setPanelOpen(false));
    fileInput.addEventListener('change', () => {
      resetPreview(fileInput.files?.[0]
        ? `${fileInput.files[0].name} is ready for validation.`
        : 'Select a CSV file to begin.');
      previewButton.disabled = !fileInput.files?.[0];
    });

    previewButton.addEventListener('click', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      if (file.size > 2 * 1024 * 1024) {
        resetPreview('The CSV file is too large. Maximum size is 2 MB.');
        status.classList.add('is-error');
        return;
      }
      previewButton.disabled = true;
      previewButton.textContent = 'Validating...';
      status.classList.remove('is-error');
      status.textContent = 'Checking headers, student numbers, courses, years, and emails...';
      try {
        const text = await file.text();
        const response = await fetch('/students/import/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ csv_data: text })
        });
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.message || 'Unable to validate this CSV file.');
        results.hidden = false;
        summary.replaceChildren();
        addSummaryItem('Total rows', data.total);
        addSummaryItem('Create', data.createCount);
        addSummaryItem('Update', data.updateCount);
        addSummaryItem('Invalid', data.invalidCount);
        renderMessages(data);
        renderRows(Array.isArray(data.rows) ? data.rows : []);
        csvData.value = text;
        previewToken.value = data.previewToken || '';
        confirmButton.disabled = !data.canImport;
        confirmHint.textContent = data.canImport
          ? `Ready to import ${data.total} validated student record(s). No database changes have been made yet.`
          : 'Fix every invalid row, save the CSV, and validate it again before importing.';
        status.textContent = data.canImport
          ? 'Validation complete. All rows are ready to import.'
          : `Validation complete. ${data.invalidCount} row(s) need attention.`;
        status.classList.toggle('is-error', !data.canImport);
      } catch (error) {
        resetPreview(error.message || 'Unable to validate this CSV file.');
        status.classList.add('is-error');
      } finally {
        previewButton.disabled = !fileInput.files?.[0];
        previewButton.textContent = 'Validate and preview';
      }
    });
  })();
</script>

<%- include("partials/footer") %>
