<%- include("partials/header") %>

<%
  const safeUsers = Array.isArray(users) ? users : [];
  const adminCount = safeUsers.filter((user) => user.role === "admin").length;
  const guardCount = safeUsers.filter((user) => user.role === "guard").length;
  const activeCount = safeUsers.filter((user) => user.is_active).length;
  const dateLabel = (value) => value ? new Date(value).toLocaleString("en-PH", { timeZone: "Asia/Manila" }) : "Never";
%>

<section class="dashboard-hero">
  <div class="hero-greeting">
    <h2>Administration</h2>
    <h1>User Management</h1>
  </div>
  <div class="hero-cards">
    <div class="hero-card">
      <h3>Total Users</h3>
      <p><%= safeUsers.length %></p>
    </div>
    <div class="hero-card">
      <h3>Admins</h3>
      <p><%= adminCount %></p>
    </div>
    <div class="hero-card">
      <h3>Guards</h3>
      <p><%= guardCount %></p>
    </div>
    <div class="hero-card">
      <h3>Active Accounts</h3>
      <p><%= activeCount %></p>
    </div>
  </div>
  <% if (flash) { %>
    <div class="flash flash-spaced flash-<%= flash.type === 'success' ? 'success' : 'error' %>">
      <%= flash.message %>
    </div>
  <% } %>
</section>

<div class="overlap-wrapper panel-stack">
  <section class="panel">
    <div class="section-head">
      <h2>Add User</h2>
      <p>Create an Admin or Guard account. New users must replace their temporary password at first sign-in.</p>
    </div>

    <form method="post" action="/admin/users" class="form-grid user-admin-form" data-form-feedback>
      <div class="form-row-3">
        <div>
          <label for="new_username">Username <span class="req">*</span></label>
          <input id="new_username" name="username" required autocomplete="off" autocapitalize="none" spellcheck="false" />
        </div>
        <div>
          <label for="new_password">Password <span class="req">*</span></label>
          <input id="new_password" data-password-rules name="password" type="password" minlength="10" autocomplete="new-password" required />
        </div>
        <div>
          <label for="new_role">Role <span class="req">*</span></label>
          <select id="new_role" name="role" required>
            <option value="guard" selected>Guard</option>
            <option value="admin">Admin</option>
          </select>
          <small class="helper-text">Guards handle gate scanning and visits. Admins manage records, accounts and reports.</small>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit">Create User</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <div class="section-head">
      <h2>Existing Accounts</h2>
      <p>Reset passwords and suspend access without deleting audit history.</p>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Status</th>
            <th>Security</th>
            <th>Last Login</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!safeUsers.length) { %>
            <tr>
              <td colspan="6">
                <div class="empty-state"><p>No users found.</p></div>
              </td>
            </tr>
          <% } %>
          <% safeUsers.forEach((user) => { %>
            <tr>
              <td><strong><%= user.username %></strong></td>
              <td><span class="badge"><%= user.role %></span></td>
              <td><span class="badge badge-<%= user.is_active ? 'valid' : 'invalid' %>"><%= user.is_active ? 'Active' : 'Suspended' %></span></td>
              <td>
                <% if (user.must_change_password) { %><span class="badge badge-warning">Password change required</span><% } else { %><span class="badge badge-valid">Password set</span><% } %>
              </td>
              <td><%= dateLabel(user.last_login_at) %></td>
              <td>
                <div class="table-action-group">
                  <button
                    type="button"
                    class="btn-edit-sm"
                    data-user-editor-id="<%= user.id %>"
                    id="editUserBtn_<%= user.id %>">
                    Edit
                  </button>
                  <% if (Number(currentUser?.id) !== Number(user.id)) { %>
                  <div class="action-menu">
                    <button type="button" class="action-menu-trigger action-menu-trigger-compact" data-action-menu-trigger aria-label="More actions for <%= user.username %>" aria-haspopup="menu" aria-expanded="false">
                      <i class="ph ph-dots-three-vertical" aria-hidden="true"></i>
                    </button>
                    <div class="action-menu-popover action-menu-popover-end" role="menu">
                      <% if (user.is_active) { %>
                        <button type="button" role="menuitem" data-destructive-trigger data-form-id="suspendUserForm_<%= user.id %>" data-confirm-title="Suspend this account?" data-confirm-message="Sign out <%= user.username %> and block future logins until an administrator reactivates the account?" data-confirm-label="Suspend account">Suspend account</button>
                      <% } else { %>
                        <form method="post" action="/admin/users/<%= user.id %>/status"><input type="hidden" name="is_active" value="1" /><button type="submit" role="menuitem">Reactivate account</button></form>
                      <% } %>
                      <button type="button" class="action-menu-danger" role="menuitem" data-destructive-trigger data-form-id="deleteUserForm_<%= user.id %>" data-confirm-title="Delete user account?" data-confirm-message="Delete the account for <%= user.username %>? They will immediately lose access and this cannot be undone." data-confirm-label="Delete account">Delete user</button>
                    </div>
                  </div>
                  <% } %>
                  <form id="suspendUserForm_<%= user.id %>" class="destructive-form" method="post" action="/admin/users/<%= user.id %>/status" hidden><input type="hidden" name="is_active" value="0" /></form>
                  <form id="deleteUserForm_<%= user.id %>" class="destructive-form" method="post" action="/admin/users/<%= user.id %>/delete" hidden></form>
                </div>
              </td>
            </tr>
            <tr id="userEditor_<%= user.id %>" hidden>
              <td colspan="6">
                <form method="post" action="/admin/users/<%= user.id %>/edit" class="inline-edit-form is-visible">
                  <div class="form-row-3">
                    <div>
                      <label>Username</label>
                      <input name="username" value="<%= user.username %>" required />
                    </div>
                    <div>
                      <label>Role</label>
                      <select name="role" required>
                        <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                        <option value="guard" <%= user.role === 'guard' ? 'selected' : '' %>>Guard</option>
                      </select>
                    </div>
                    <div>
                      <label>Temporary Password (Optional)</label>
                      <input type="password" name="password" minlength="10" autocomplete="new-password" placeholder="Forces a change at next sign-in" />
                    </div>
                  </div>
                  <div class="edit-form-actions">
                    <button type="submit" class="btn-save-sm">Save Changes</button>
                    <button
                      type="button"
                      class="btn-cancel-sm"
                      data-user-editor-id="<%= user.id %>">
                      Cancel
                    </button>
                  </div>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<script nonce="<%= cspNonce %>">
  (() => {
    window.toggleUserEditor = (userId) => {
      const row = document.getElementById(`userEditor_${userId}`);
      const trigger = document.getElementById(`editUserBtn_${userId}`);
      if (!row || !trigger) return;
      const isOpen = !row.hidden;
      row.hidden = isOpen;
      trigger.textContent = isOpen ? "Edit" : "Close";
    };
    document.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest("[data-user-editor-id]") : null;
      if (!button) return;
      window.toggleUserEditor(button.dataset.userEditorId);
    });
  })();
</script>

<%- include("partials/footer") %>
