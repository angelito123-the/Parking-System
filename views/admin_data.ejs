<%- include("partials/header") %>
<%
  const safeDatasets = Array.isArray(datasets) ? datasets : [];
  const importable = safeDatasets.filter((item) => item.importable);
%>

<section class="dashboard-hero data-tools-hero">
  <div class="hero-greeting"><h2>Administration</h2><h1>Data Backup &amp; Import</h1><p>Download operational backups and safely update master records from CSV files.</p></div>
  <div class="hero-cards">
    <div class="hero-card"><h3>Backup Sets</h3><p><%= safeDatasets.length %></p></div>
    <div class="hero-card"><h3>Import Types</h3><p><%= importable.length %></p></div>
    <div class="hero-card"><h3>Import Limit</h3><p class="security-text-value">2,000 rows</p></div>
    <div class="hero-card"><h3>Format</h3><p class="security-text-value">CSV</p></div>
  </div>
  <% if (flash) { %><div class="flash flash-<%= flash.type === 'success' ? 'success' : 'error' %>"><%= flash.message %></div><% } %>
</section>

<div class="overlap-wrapper data-tools-grid">
  <section class="panel">
    <div class="section-head"><h2>Download Backups</h2><p>Exports are UTF-8 CSV files compatible with Excel and Google Sheets.</p></div>
    <div class="backup-card-grid">
      <% safeDatasets.forEach((dataset) => { %>
        <article class="backup-card"><div><strong><%= dataset.label %></strong><span><%= dataset.importable ? 'Export and restore supported' : 'Export-only historical record' %></span></div><a class="btn-sm" href="/admin/data/export/<%= dataset.key %>" download>Download CSV</a></article>
      <% }) %>
    </div>
  </section>

  <section class="panel">
    <div class="section-head"><h2>Import Master Records</h2><p>Existing records are updated by their unique ID field; missing records are created. Historical logs remain export-only to protect audit integrity.</p></div>
    <form method="post" action="/admin/data/import" class="form-grid data-import-form" id="dataImportForm">
      <div>
        <label for="importDataset">Data type</label>
        <select id="importDataset" name="dataset" required><% importable.forEach((dataset) => { %><option value="<%= dataset.key %>" data-columns="<%= dataset.columns.join(',') %>"><%= dataset.label %></option><% }) %></select>
      </div>
      <div>
        <label for="csvFile">CSV file</label>
        <input id="csvFile" type="file" accept=".csv,text/csv" required />
      </div>
      <div class="data-template-note"><strong>Required header format</strong><code id="csvHeaderExample"><%= importable[0]?.columns.join(',') || '' %></code></div>
      <textarea id="csvData" name="csv_data" hidden required></textarea>
      <div id="csvPreview" class="csv-preview" aria-live="polite">Choose a CSV file to preview its row count.</div>
      <div class="form-actions"><button type="submit" id="csvImportButton" disabled>Import CSV</button></div>
    </form>
  </section>

  <section class="panel data-safety-note">
    <div class="section-head"><h2>Safe Backup Routine</h2><p>Recommended before large roster changes.</p></div>
    <ol><li>Download Students and Vehicles backups.</li><li>Open the CSV and confirm headers have not changed.</li><li>Import Students before Vehicles so references exist.</li><li>Review the Student Directory after import.</li></ol>
  </section>
</div>

<script>
  (() => {
    const dataset = document.getElementById('importDataset');
    const file = document.getElementById('csvFile');
    const csvData = document.getElementById('csvData');
    const preview = document.getElementById('csvPreview');
    const button = document.getElementById('csvImportButton');
    const header = document.getElementById('csvHeaderExample');
    const updateHeader = () => { header.textContent = dataset.selectedOptions[0]?.dataset.columns || ''; };
    dataset.addEventListener('change', updateHeader);
    file.addEventListener('change', async () => {
      button.disabled = true;
      csvData.value = '';
      const selected = file.files?.[0];
      if (!selected) { preview.textContent = 'Choose a CSV file to preview its row count.'; return; }
      if (selected.size > 7 * 1024 * 1024) { preview.textContent = 'This file is too large. Maximum size is 7 MB.'; return; }
      try {
        const text = await selected.text();
        const lineCount = text.split(/\r?\n/).filter((line) => line.trim()).length;
        csvData.value = text;
        preview.textContent = `${selected.name} · approximately ${Math.max(0, lineCount - 1)} data row(s)`;
        button.disabled = lineCount < 2;
      } catch (_error) {
        preview.textContent = 'Unable to read this file.';
      }
    });
    updateHeader();
  })();
</script>

<%- include("partials/footer") %>
