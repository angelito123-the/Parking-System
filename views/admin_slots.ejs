<%- include("partials/header") %>
<link rel="stylesheet" href="/admin-parking-map.css?v=20261027-spacing" />
<%
  const safeParkingSlots = Array.isArray(parkingSlots) ? parkingSlots : [];
  const safeParkingSlotSummary = typeof parkingSlotSummary === "object" && parkingSlotSummary
    ? parkingSlotSummary
    : {
      total: safeParkingSlots.length,
      available: safeParkingSlots.filter((slot) => slot.occupancy === "available").length,
      occupied: safeParkingSlots.filter((slot) => slot.occupancy === "occupied").length,
      disabled: safeParkingSlots.filter((slot) => slot.occupancy === "disabled").length
    };
  const initialSelectedSlot = safeParkingSlots.find((slot) => slot.occupancy === "available") || safeParkingSlots[0] || null;
  const initialSelectedSlotCode = initialSelectedSlot?.slot_code ? String(initialSelectedSlot.slot_code) : "";
  const safeZoneSettings = Array.isArray(zoneSettings) ? zoneSettings : [];
%>

<section class="dashboard-hero">
  <div class="hero-greeting">
    <h2>Access Control</h2>
    <h1>Parking Slot Monitoring</h1>
  </div>
  <div class="hero-cards">
    <div class="hero-card">
      <h3>Total Slots</h3>
      <p id="slotMetricTotal"><%= safeParkingSlotSummary.total %></p>
    </div>
    <div class="hero-card hero-card--success">
      <h3>Available</h3>
      <p id="slotMetricAvailable"><%= safeParkingSlotSummary.available %></p>
    </div>
    <div class="hero-card hero-card--warning">
      <h3>Occupied</h3>
      <p id="slotMetricOccupied"><%= safeParkingSlotSummary.occupied %></p>
    </div>
    <div class="hero-card hero-card--muted">
      <h3>Blocked</h3>
      <p id="slotMetricDisabled"><%= safeParkingSlotSummary.disabled %></p>
    </div>
  </div>
  <% if (flash) { %><div class="flash flash-spaced flash-<%= flash.type === 'success' ? 'success' : 'error' %>"><%= flash.message %></div><% } %>
</section>

<div class="overlap-wrapper" style="display:grid; gap:1.25rem;">
  <section class="panel">
    <div class="section-head">
      <h2>Parking Slot Monitoring</h2>
      <p>See which vehicle is parked in each occupied slot. Click any slot to review history.</p>
    </div>
    <div class="standard-form-actions" style="margin-bottom:1rem;">
      <form method="post" action="/admin/slots/enable-all" id="enableAllSlotsForm"
        class="standard-form-actions" style="margin:0;" data-confirm-form
        data-confirm-title="Enable all parking slots?"
        data-confirm-message="This reopens disabled parking spaces in every zone, including slots hidden by filters and spaces closed for maintenance. Disabled reasons are cleared. Parked vehicles remain assigned; only empty spaces become available for entry."
        data-confirm-label="Enable all parking slots">
        <input type="hidden" name="confirm_enable_all" value="yes" />
        <button type="submit" id="enableAllSlotsBtn" class="btn-sm">Enable all parking slots</button>
      </form>
      <form method="post" action="/admin/slots/disable-all" id="disableAllSlotsForm"
        class="standard-form-actions" style="margin:0;" data-confirm-form
        data-confirm-title="Disable all parking slots?"
        data-confirm-message="This closes parking in every zone, including slots hidden by filters. Vehicles already parked remain assigned and can still exit. Existing maintenance reasons are kept. Slots stay disabled until you enable them again."
        data-confirm-label="Disable all parking slots" data-confirm-note="true">
        <input type="hidden" name="confirm_disable_all" value="yes" />
        <input type="hidden" name="approval_note" value="" />
        <button type="submit" id="disableAllSlotsBtn" class="btn-confirm-danger">Disable all parking slots</button>
      </form>
    </div>
    <div class="refresh-row" style="margin-bottom:0.8rem;">
      <span id="slotsLastUpdated" class="helper-text live-update-status">Automatic updates every 20s</span>
      <button type="button" id="slotsRefreshBtn" class="refresh-btn btn-sm">Refresh</button>
    </div>

    <div class="parking-slots-toolbar">
      <div class="parking-slots-toolbar-left">
        <span id="parkingSlotsMeta" class="helper-text">
          <%= safeParkingSlotSummary.available %> available | <%= safeParkingSlotSummary.occupied %> occupied | <%= safeParkingSlotSummary.disabled %> disabled | <%= safeParkingSlotSummary.total %> total
        </span>
        <label for="parkingSlotSearch" class="sr-only">Find parking slot</label>
        <input
          type="search"
          id="parkingSlotSearch"
          class="slot-search-input"
          placeholder="Find slot code, zone, plate, or student..." />
      </div>
      <div class="slot-filter-group" role="group" aria-label="Parking slot status filter">
        <button type="button" class="slot-filter-btn is-active" data-slot-filter="all">All (<%= safeParkingSlotSummary.total %>)</button>
        <button type="button" class="slot-filter-btn" data-slot-filter="available">Available (<%= safeParkingSlotSummary.available %>)</button>
        <button type="button" class="slot-filter-btn" data-slot-filter="occupied">Occupied (<%= safeParkingSlotSummary.occupied %>)</button>
        <button type="button" class="slot-filter-btn" data-slot-filter="disabled">Blocked (<%= safeParkingSlotSummary.disabled %>)</button>
        <button type="button" class="slot-filter-btn" data-slot-filter="reserved">Reserved</button>
      </div>
    </div>

    <div class="parking-view-toolbar">
      <p class="helper-text">Select a space to see its details. Reserved spaces also show their current availability.</p>
      <div id="parkingViewButtons" class="parking-view-toggle" role="group" aria-label="Parking view">
        <button type="button" class="btn-sm" data-parking-view="map" aria-pressed="true" aria-controls="parkingSlotsList"><i class="ph ph-grid-four" aria-hidden="true"></i> Map</button>
        <button type="button" class="btn-sm btn-reset" data-parking-view="table" aria-pressed="false" aria-controls="parkingSlotsTableRegion"><i class="ph ph-list" aria-hidden="true"></i> Table</button>
      </div>
    </div>
    <div class="parking-status-legend" role="group" aria-label="Highlight a status on the map">
      <span class="map-legend-caption">Highlight:</span>
      <button type="button" class="available" data-map-status="available" aria-pressed="false"><i class="ph ph-check-circle" aria-hidden="true"></i> Available</button>
      <button type="button" class="occupied" data-map-status="occupied" aria-pressed="false"><i class="ph ph-car" aria-hidden="true"></i> Occupied</button>
      <button type="button" class="reserved" data-map-status="reserved" aria-pressed="false"><i class="ph ph-bookmark-simple" aria-hidden="true"></i> Reserved</button>
      <button type="button" class="disabled" data-map-status="disabled" aria-pressed="false"><i class="ph ph-prohibit" aria-hidden="true"></i> Maintenance</button>
    </div>
    <div id="availableSlotsStrip" class="available-slots-strip">
      <% const initialAvailableSlots = safeParkingSlots.filter((slot) => slot.occupancy === "available"); %>
      <% if (!initialAvailableSlots.length) { %>
        <span class="available-slots-empty">No available slots right now.</span>
      <% } else { %>
        <span class="available-slots-label">Available now:</span>
        <% initialAvailableSlots.slice(0, 18).forEach((slot) => { %>
          <button type="button" class="available-slot-pill" data-slot-pill="<%= slot.slot_code || '' %>"><%= slot.slot_code || "-" %></button>
        <% }) %>
        <% if (initialAvailableSlots.length > 18) { %>
          <span class="available-slots-more">+<%= initialAvailableSlots.length - 18 %> more</span>
        <% } %>
      <% } %>
    </div>

    <div class="parking-space-layout">
      <div class="parking-space-map-shell">
        <div class="parking-map-controls" id="parkingMapControls">
          <div class="parking-zone-picker"><label for="parkingZonePicker">Parking zone</label><select id="parkingZonePicker"></select></div>
          <button type="button" class="btn-sm btn-reset" id="findAvailableBay"><i class="ph ph-magnifying-glass" aria-hidden="true"></i> Find available slot</button>
          <div class="parking-map-zoom" id="parkingMapZoom" role="group" aria-label="Map zoom" hidden>
            <button type="button" data-map-zoom="out" aria-label="Zoom out"><i class="ph ph-minus" aria-hidden="true"></i></button>
            <button type="button" data-map-zoom="fit">Fit</button>
            <button type="button" data-map-zoom="in" aria-label="Zoom in"><i class="ph ph-plus" aria-hidden="true"></i></button>
          </div>
        </div>
        <div class="parking-map-feedback"><span id="parkingMapHint" role="status">Use arrow keys to move between bays. Enter selects.</span><span id="parkingMapLoading" hidden><span class="sr-only">Updating parking availability</span><span class="ui-skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></span></span></div>
        <div id="parkingSlotsList" class="parking-space-map" tabindex="0" role="region" aria-label="Parking map">
          <% if (!safeParkingSlots.length) { %>
            <div class="empty-state" style="padding:1.25rem 1rem;">
              <p>No parking slots configured.</p>
            </div>
          <% } %>
        </div>
        <div id="parkingSlotsTableRegion" class="table-wrap parking-slots-table-region" tabindex="0" role="region" aria-label="Parking spaces table" hidden>
          <table>
            <thead><tr><th scope="col">Space</th><th scope="col">Zone</th><th scope="col">Status</th><th scope="col">Type</th><th scope="col">Vehicle / note</th><th scope="col">Details</th></tr></thead>
            <tbody id="parkingSlotsTableBody"></tbody>
          </table>
        </div>
      </div>

      <aside class="parking-space-panel">
        <div class="parking-space-panel-head">
          <div>
            <p class="parking-space-panel-label">Selected Parking Space</p>
            <h3 id="slotInspectorTitle" tabindex="-1"><%= initialSelectedSlotCode || "Not selected" %></h3>
          </div>
          <span id="slotInspectorStatus" class="parking-inspector-badge">--</span>
        </div>
        <p id="slotInspectorSubtitle" class="helper-text" style="margin-bottom:0.7rem;">
          Select a slot to review assignment details and recent parking activity.
        </p>
        <div id="slotInspectorDetails" class="parking-inspector-details"></div>
        <details class="slot-editor-disclosure">
          <summary>Edit selected space</summary>
          <form method="post" id="slotEditorForm" class="form-grid security-form-compact" data-form-feedback>
            <div><label for="slotEditorCode">Slot code</label><input id="slotEditorCode" name="slot_code" maxlength="30" required /></div>
            <div><label for="slotEditorZone">Zone</label><input id="slotEditorZone" name="zone" maxlength="50" required /></div>
            <div><label for="slotEditorType">Space type</label><select id="slotEditorType" name="slot_type"><option value="standard">Standard</option><option value="accessibility">Accessibility</option><option value="reserved">Reserved</option></select></div>
            <div><label for="slotEditorReserved">Reserved for</label><input id="slotEditorReserved" name="reserved_for" maxlength="120" /></div>
            <div><label for="slotEditorState">Status</label><select id="slotEditorState" name="status"><option value="available">Available</option><option value="disabled">Disabled / maintenance</option></select></div>
            <div><label for="slotEditorReason">Maintenance reason</label><input id="slotEditorReason" name="disabled_reason" maxlength="255" /></div>
            <div class="standard-form-actions"><button type="submit" class="btn-sm">Save changes</button></div>
          </form>
        </details>

        <div class="parking-inspector-history-head">
          <strong>Recent Activity</strong>
          <button type="button" id="openSlotHistoryBtn" class="btn-sm btn-secondary">View history</button>
        </div>
        <div id="slotInspectorHistory" class="parking-inspector-history-list" tabindex="0" role="region" aria-label="Recent history for the selected parking slot">
          <div class="empty-state" style="padding:0.8rem;">
            <p>Select a slot to load recent history.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>
  <section class="panel slot-configuration-panel">
    <div class="section-head"><h2>Configure Parking Spaces</h2><p>Add a parking space and set its availability.</p></div>
    <form method="post" action="/admin/slots" class="form-grid parking-space-form" data-form-feedback>
      <fieldset class="parking-form-section">
        <legend>Space details</legend>
        <div class="form-row-3">
        <div><label for="newSlotCode">Slot code</label><input id="newSlotCode" name="slot_code" maxlength="30" placeholder="C-01" required /></div>
        <div><label for="newSlotZone">Zone</label><input id="newSlotZone" name="zone" maxlength="50" placeholder="Zone C" required /></div>
        <div><label for="newSlotType">Space type</label><select id="newSlotType" name="slot_type"><option value="standard">Standard</option><option value="accessibility">Accessibility</option><option value="reserved">Reserved</option></select></div>
        </div>
      </fieldset>
      <fieldset class="parking-form-section">
        <legend>Availability &amp; access</legend>
        <div class="form-row-3">
        <div><label for="newSlotStatus">Status</label><select id="newSlotStatus" name="status"><option value="available">Available</option><option value="disabled">Disabled / maintenance</option></select></div>
        <div><label for="newSlotReserved">Reserved for</label><input id="newSlotReserved" name="reserved_for" maxlength="120" placeholder="Name or group" aria-describedby="newSlotReservedHelp" /><p id="newSlotReservedHelp" class="parking-field-help">Required for reserved spaces.</p></div>
        <div><label for="newSlotReason">Maintenance reason</label><input id="newSlotReason" name="disabled_reason" maxlength="255" placeholder="Reason for closure" aria-describedby="newSlotReasonHelp" /><p id="newSlotReasonHelp" class="parking-field-help">Required when disabled.</p></div>
        </div>
      </fieldset>
      <div class="form-actions standard-form-actions parking-form-actions"><p class="parking-field-help">Slot code and zone are required.</p><button type="submit">Add parking space</button></div>
    </form>
    <% if (safeZoneSettings.length) { %>
      <section id="zoneThresholdSettings" class="zone-threshold-section" aria-labelledby="zoneThresholdHeading">
        <div class="zone-threshold-heading">
          <h3 id="zoneThresholdHeading">Zone occupancy warnings</h3>
          <p>Choose how full each zone can get before a warning appears.</p>
        </div>
      <div class="zone-threshold-grid">
        <% safeZoneSettings.forEach((setting, index) => { %>
          <form method="post" action="/admin/slots/zone-threshold" class="zone-threshold-card">
            <input type="hidden" name="zone" value="<%= setting.zone %>" />
            <div class="zone-threshold-info"><strong><%= setting.zone %></strong><span><%= setting.total_slots %> <%= Number(setting.total_slots) === 1 ? 'space' : 'spaces' %></span></div>
            <div class="zone-threshold-control">
              <label for="zoneThreshold<%= index %>">Warn at<span class="sr-only"> for <%= setting.zone %> (percent occupied)</span></label>
              <div class="zone-threshold-input"><input id="zoneThreshold<%= index %>" type="number" name="warning_threshold_percent" min="50" max="100" value="<%= setting.warning_threshold_percent %>" required /><span aria-hidden="true">%</span></div>
            </div>
            <button type="submit" class="btn-sm btn-reset">Save threshold<span class="sr-only"> for <%= setting.zone %></span></button>
          </form>
        <% }) %>
      </div>
      </section>
    <% } %>
  </section>

</div>

<div id="slotHistoryModal" class="slot-history-modal" aria-hidden="true">
  <div class="slot-history-backdrop" data-close-slot-history></div>
  <div class="slot-history-dialog" role="dialog" aria-modal="true" aria-labelledby="slotHistoryTitle">
    <div class="slot-history-head">
      <div class="slot-history-heading">
        <h3 id="slotHistoryTitle">Slot history</h3>
        <p id="slotHistoryMeta" role="status">Loading parking records...</p>
      </div>
      <button type="button" class="slot-history-close" data-close-slot-history aria-label="Close slot history">
        <i class="ph ph-x" aria-hidden="true"></i>
      </button>
    </div>
    <p class="slot-history-timezone">Newest first &middot; Philippine time (UTC+8)</p>
    <div id="slotHistoryList" class="slot-history-list" tabindex="0" role="region" aria-label="Parking records">
      <div class="empty-state" style="padding:1rem;"><p>Loading slot history...</p></div>
    </div>
  </div>
</div>

<script src="/js/admin-parking-map.js?v=20261026-bays"></script>
<script nonce="<%= cspNonce %>">
  (() => {
    function escapeHtml(value) {
      return String(value == null ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    const slotMetricTotal = document.getElementById("slotMetricTotal");
    const slotMetricAvailable = document.getElementById("slotMetricAvailable");
    const slotMetricOccupied = document.getElementById("slotMetricOccupied");
    const slotMetricDisabled = document.getElementById("slotMetricDisabled");
    const lastUpdatedEl = document.getElementById("slotsLastUpdated");
    const refreshBtn = document.getElementById("slotsRefreshBtn");
    const parkingSlotsMetaEl = document.getElementById("parkingSlotsMeta");
    const parkingSlotsListEl = document.getElementById("parkingSlotsList");
    const parkingSlotsTableRegion = document.getElementById("parkingSlotsTableRegion");
    const parkingSlotsTableBody = document.getElementById("parkingSlotsTableBody");
    const parkingViewButtons = Array.from(document.querySelectorAll("[data-parking-view]"));
    let parkingView = "map";
    const parkingSlotSearchEl = document.getElementById("parkingSlotSearch");
    const availableSlotsStripEl = document.getElementById("availableSlotsStrip");
    const slotFilterButtons = Array.from(document.querySelectorAll(".slot-filter-btn[data-slot-filter]"));
    const slotInspectorTitleEl = document.getElementById("slotInspectorTitle");
    const slotInspectorStatusEl = document.getElementById("slotInspectorStatus");
    const slotInspectorSubtitleEl = document.getElementById("slotInspectorSubtitle");
    const slotInspectorDetailsEl = document.getElementById("slotInspectorDetails");
    const slotInspectorHistoryEl = document.getElementById("slotInspectorHistory");
    const slotEditorForm = document.getElementById("slotEditorForm");
    const slotEditorCode = document.getElementById("slotEditorCode");
    const slotEditorZone = document.getElementById("slotEditorZone");
    const slotEditorType = document.getElementById("slotEditorType");
    const slotEditorReserved = document.getElementById("slotEditorReserved");
    const slotEditorState = document.getElementById("slotEditorState");
    const slotEditorReason = document.getElementById("slotEditorReason");
    const openSlotHistoryBtnEl = document.getElementById("openSlotHistoryBtn");
    const slotHistoryModal = document.getElementById("slotHistoryModal");
    const slotHistoryTitle = document.getElementById("slotHistoryTitle");
    const slotHistoryMeta = document.getElementById("slotHistoryMeta");
    const slotHistoryList = document.getElementById("slotHistoryList");
    const slotHistoryCloseBtn = slotHistoryModal?.querySelector("button[data-close-slot-history]");
    const slotHistoryAppShell = document.querySelector(".app-shell");
    let slotHistoryReturnFocus = null;
    let slotHistoryWasInert = false;
    let slotHistoryModalRequestId = 0;

    const initialParkingSlots = <%- serializeForScript(safeParkingSlots) %>;
    const initialParkingSlotSummary = <%- serializeForScript(safeParkingSlotSummary) %>;
    const mapZoneSettings = <%- serializeForScript(safeZoneSettings) %>;
    let activeSlotFilter = "all";
    let slotSearchQuery = "";
    let latestParkingSlots = Array.isArray(initialParkingSlots) ? initialParkingSlots : [];
    let latestParkingSlotSummary = (initialParkingSlotSummary && typeof initialParkingSlotSummary === "object")
      ? initialParkingSlotSummary
      : { total: latestParkingSlots.length, available: 0, occupied: 0, disabled: 0 };
    let selectedSlotCode = String(<%- serializeForScript(initialSelectedSlotCode) %> || "").trim().toUpperCase();
    let selectedSlotHistoryRows = [];
    let slotInspectorLoading = false;
    let slotInspectorError = "";
    let slotHistoryRequestId = 0;
    const slotHistoryCache = new Map();

    if (slotHistoryModal && slotHistoryModal.parentElement !== document.body) {
      document.body.appendChild(slotHistoryModal);
    }

    function toPht(value) {
      return new Date(value).toLocaleString("en-US", { timeZone: "Asia/Manila" });
    }

    function normalizeSlotCode(value) {
      return String(value || "").trim().toUpperCase();
    }

    function computeParkingSlotSummary(slots) {
      const source = Array.isArray(slots) ? slots : [];
      const summary = { total: source.length, available: 0, occupied: 0, disabled: 0 };
      source.forEach((slot) => {
        const occupancy = slot?.occupancy || "available";
        if (occupancy === "available") summary.available += 1;
        else if (occupancy === "occupied") summary.occupied += 1;
        else summary.disabled += 1;
      });
      return summary;
    }

    function normalizeParkingSlotSummary(summary, slots) {
      const fallback = computeParkingSlotSummary(slots);
      return {
        total: Number.isFinite(Number(summary?.total)) ? Number(summary.total) : fallback.total,
        available: Number.isFinite(Number(summary?.available)) ? Number(summary.available) : fallback.available,
        occupied: Number.isFinite(Number(summary?.occupied)) ? Number(summary.occupied) : fallback.occupied,
        disabled: Number.isFinite(Number(summary?.disabled)) ? Number(summary.disabled) : fallback.disabled
      };
    }

    function getSelectedSlot() {
      const code = normalizeSlotCode(selectedSlotCode);
      if (!code) return null;
      return latestParkingSlots.find((slot) => normalizeSlotCode(slot.slot_code) === code) || null;
    }

    function renderParkingSlotCard(slot) {
      const requestedOccupancy = String(slot.occupancy || "available").toLowerCase();
      const occupancy = ["available", "occupied", "disabled"].includes(requestedOccupancy) ? requestedOccupancy : "disabled";
      const code = slot.slot_code || "-";
      const isSelected = normalizeSlotCode(code) === normalizeSlotCode(selectedSlotCode);
      const tileMeta = occupancy === "occupied"
        ? (slot.occupied_by_plate || "Occupied")
        : occupancy === "available"
          ? (slot.slot_type === "standard" ? "Available" : `${slot.slot_type || "special"} space`)
          : slot.occupied_by_type
            ? `Vehicle still parked: ${slot.occupied_by_plate || "Assigned"}`
            : (slot.disabled_reason || "Unavailable");

      return `<button
        type="button"
        class="parking-slot-tile ${occupancy} ${isSelected ? "selected" : ""}"
        data-slot-code="${escapeHtml(code)}"
        data-slot-type="${escapeHtml(slot.slot_type || "standard")}"
        data-parking-label="${occupancy === "disabled" ? "Blocked" : occupancy === "occupied" ? "Occupied" : "Available"}"
        aria-pressed="${isSelected ? "true" : "false"}"
        aria-label="Parking slot ${escapeHtml(code)} ${occupancy}${slot.slot_type === "reserved" ? " reserved space" : ""}">
        <span class="tile-code">${escapeHtml(code)}</span>
        <span class="tile-meta">${escapeHtml(tileMeta)}</span>
        ${slot.slot_type === "reserved" ? '<span class="parking-reserved-label">◆ Reserved</span>' : ''}
      </button>`;
    }

    // Both views use the same filtered inventory and selected slot.
    function renderParkingSlotsTable(slots) {
      if (!parkingSlotsTableBody) return;
      const labels = { available: "Available", occupied: "Occupied", disabled: "Blocked" };
      parkingSlotsTableBody.innerHTML = slots.length ? slots.map(slot => {
        const state = Object.prototype.hasOwnProperty.call(labels, slot.occupancy) ? slot.occupancy : "disabled";
        const code = slot.slot_code || "-";
        const selected = normalizeSlotCode(code) === normalizeSlotCode(selectedSlotCode);
        const type = slot.slot_type || "standard";
        const note = slot.occupied_by_plate || slot.occupied_by_name || slot.disabled_reason || slot.reserved_for || "No vehicle assigned";
        return `<tr class="${selected ? "is-selected" : ""}">
          <td><strong>${escapeHtml(code)}</strong></td>
          <td>${escapeHtml(slot.zone || "General")}</td>
          <td><span class="parking-status-badge status-${state}"><i class="ph ${{ available: "ph-check-circle", occupied: "ph-car", disabled: "ph-prohibit" }[state]}" aria-hidden="true"></i>${labels[state]}</span></td>
          <td><span class="parking-type-label ${type === "reserved" ? "is-reserved" : ""}">${type === "reserved" ? '<i class="ph ph-bookmark-simple" aria-hidden="true"></i> ' : ""}${escapeHtml(type.charAt(0).toUpperCase() + type.slice(1))}</span></td>
          <td>${escapeHtml(note)}</td>
          <td><button type="button" class="btn-sm btn-reset" data-slot-select="${escapeHtml(code)}" aria-pressed="${selected}">View <span class="sr-only">${escapeHtml(code)}</span></button></td>
        </tr>`;
      }).join("") : `<tr><td colspan="6">${renderEmptyParkingSlots("No spaces match your search and filters.")}</td></tr>`;
      if (parkingSlotsListEl) parkingSlotsListEl.hidden = parkingView !== "map";
      if (parkingSlotsTableRegion) parkingSlotsTableRegion.hidden = parkingView !== "table";
      parkingViewButtons.forEach(button => {
        const active = button.dataset.parkingView === parkingView;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("btn-reset", !active);
      });
      window.NaapAdminMap?.viewChanged(parkingView);
    }

    function renderEmptyParkingSlots(message = "No parking slots configured.") {
      return window.NaapUiState.render("empty", {
        title: "No parking slots",
        message,
        compact: true
      });
    }

    function getSlotFilterCount(filterKey, summary) {
      if (filterKey === "available") return summary.available || 0;
      if (filterKey === "occupied") return summary.occupied || 0;
      if (filterKey === "disabled") return summary.disabled || 0;
      if (filterKey === "reserved") return latestParkingSlots.filter(slot => slot.slot_type === "reserved").length;
      return summary.total || 0;
    }

    function updateSlotFilterButtons(summary) {
      if (!slotFilterButtons.length) return;
      const labels = { all: "All", available: "Available", occupied: "Occupied", disabled: "Blocked", reserved: "Reserved" };
      slotFilterButtons.forEach((button) => {
        const key = button.dataset.slotFilter || "all";
        const count = getSlotFilterCount(key, summary);
        button.textContent = `${labels[key] || "All"} (${count})`;
        const isActive = key === activeSlotFilter;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }

    function renderAvailableSlotsStrip(slots, summary) {
      if (!availableSlotsStripEl) return;
      const availableSlots = (slots || [])
        .filter((slot) => (slot.occupancy || "available") === "available")
        .sort((a, b) => String(a.slot_code || "").localeCompare(String(b.slot_code || "")));

      if (!availableSlots.length) {
        availableSlotsStripEl.innerHTML = '<span class="available-slots-empty">No available slots right now.</span>';
        return;
      }

      const visible = availableSlots;
      availableSlotsStripEl.innerHTML = `
        <span class="available-slots-label">Available now (${summary.available || availableSlots.length}):</span>
        ${visible.map((slot) => `<button type="button" class="available-slot-pill" data-reserved="${slot.slot_type === "reserved"}" data-slot-pill="${escapeHtml(slot.slot_code || "")}"><i class="ph ph-check-circle" aria-hidden="true"></i>${escapeHtml(slot.slot_code || "-")}${slot.slot_type === "reserved" ? '<span class="chip-reserved">◆ Reserved</span>' : ""}</button>`).join("")}
        ${availableSlots.length > visible.length ? `<span class="available-slots-more">+${availableSlots.length - visible.length} more</span>` : ""}
      `;
    }

    function focusSlotTileByCode(slotCode) {
      if (!slotCode || !parkingSlotsListEl) return;
      const code = normalizeSlotCode(slotCode);
      const tiles = Array.from(parkingSlotsListEl.querySelectorAll(".parking-slot-tile"));
      const target = tiles.find((tile) => normalizeSlotCode(tile.dataset.slotCode) === code);
      if (!target) return;
      target.focus({ preventScroll: true });
      target.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
    }

    function applyParkingSlotFilters(slots) {
      const source = Array.isArray(slots) ? slots : [];
      const query = String(slotSearchQuery || "").trim().toLowerCase();
      return source.filter((slot) => {
        const occupancy = slot.occupancy || "available";
        if (activeSlotFilter === "reserved" && slot.slot_type !== "reserved") return false;
        if (activeSlotFilter !== "all" && activeSlotFilter !== "reserved" && occupancy !== activeSlotFilter) return false;
        if (!query) return true;
        const searchable = [slot.slot_code || "", slot.zone || "", slot.slot_type || "", slot.reserved_for || "", slot.disabled_reason || "", slot.occupied_by_plate || "", slot.occupied_by_name || ""].join(" ").toLowerCase();
        return searchable.includes(query);
      });
    }

    function groupSlotsByZone(slots) {
      return (slots || []).reduce((acc, slot) => {
        const zone = slot.zone || "General";
        if (!acc[zone]) acc[zone] = [];
        acc[zone].push(slot);
        return acc;
      }, Object.create(null));
    }

    function renderSlotInspectorHistoryItem(item) {
      const parkedAt = item.parked_at || item.scanned_at;
      const stateClass = item.is_ongoing ? "inside" : "exited";
      const stateLabel = item.is_ongoing ? "INSIDE" : "EXITED";
      return `<article class="parking-inspector-history-item ${stateClass}">
        <div class="parking-inspector-history-top">
          <strong>${escapeHtml(item.full_name || "Unknown Student")}</strong>
          <span class="parking-inspector-mini-badge ${stateClass}">${stateLabel}</span>
        </div>
        <p>${escapeHtml(item.plate_number || "-")} | ${escapeHtml(item.student_number || "-")}</p>
        <p>${parkedAt ? escapeHtml(toPht(parkedAt)) : "-"} | ${escapeHtml(item.duration_label || "-")}</p>
      </article>`;
    }

    function renderSlotInspector() {
      if (!slotInspectorTitleEl || !slotInspectorStatusEl || !slotInspectorSubtitleEl || !slotInspectorDetailsEl || !slotInspectorHistoryEl) return;
      const slot = getSelectedSlot();
      if (!slot) {
        slotInspectorTitleEl.textContent = "Not selected";
        slotInspectorStatusEl.textContent = "--";
        slotInspectorStatusEl.className = "parking-inspector-badge";
        slotInspectorSubtitleEl.textContent = "Select a slot to review assignment details and recent parking activity.";
        slotInspectorDetailsEl.innerHTML = '<div class="empty-state" style="padding:0.8rem;"><p>No slot selected.</p></div>';
        slotInspectorHistoryEl.innerHTML = '<div class="empty-state" style="padding:0.8rem;"><p>Select a slot to load recent history.</p></div>';
        if (openSlotHistoryBtnEl) openSlotHistoryBtnEl.disabled = true;
        if (slotEditorForm) slotEditorForm.hidden = true;
        return;
      }

      const requestedOccupancy = String(slot.occupancy || "available").toLowerCase();
      const occupancy = ["available", "occupied", "disabled"].includes(requestedOccupancy)
        ? requestedOccupancy
        : "disabled";
      const statusText = occupancy === "disabled" ? "Blocked" : occupancy.charAt(0).toUpperCase() + occupancy.slice(1);
      slotInspectorTitleEl.textContent = slot.slot_code || "-";
      slotInspectorStatusEl.textContent = statusText;
      slotInspectorStatusEl.className = `parking-inspector-badge ${occupancy}`;
      slotInspectorSubtitleEl.textContent = occupancy === "available"
        ? "This slot is open and ready for a new entry assignment."
        : occupancy === "occupied"
          ? "This slot is currently occupied. Review current assignment and activity."
          : slot.occupied_by_type
            ? "Closed to new parking. The current vehicle remains assigned and can still exit."
            : "This slot is currently disabled and cannot be assigned.";

      slotInspectorDetailsEl.innerHTML = `
        <div class="parking-inspector-detail"><span>Zone</span><strong>${escapeHtml(slot.zone || "General")}</strong></div>
        <div class="parking-inspector-detail"><span>Status</span><strong>${statusText}</strong></div>
        <div class="parking-inspector-detail"><span>Type</span><strong>${escapeHtml(slot.slot_type || "standard")}</strong></div>
        <div class="parking-inspector-detail"><span>Reserved for</span><strong>${escapeHtml(slot.reserved_for || "-")}</strong></div>
        <div class="parking-inspector-detail"><span>Maintenance</span><strong>${escapeHtml(slot.disabled_reason || "-")}</strong></div>
        <div class="parking-inspector-detail"><span>Plate</span><strong>${escapeHtml(slot.occupied_by_plate || "-")}</strong></div>
        <div class="parking-inspector-detail"><span>Student</span><strong>${escapeHtml(slot.occupied_by_name || "-")}</strong></div>
      `;
      window.NaapPages?.inspectorUpdated(slot.slot_code || "-");
      if (slotEditorForm) {
        slotEditorForm.hidden = false;
        slotEditorForm.action = `/admin/slots/${Number(slot.id)}`;
        slotEditorCode.value = slot.slot_code || "";
        slotEditorZone.value = slot.zone || "General";
        slotEditorType.value = ["standard", "accessibility", "reserved"].includes(slot.slot_type) ? slot.slot_type : "standard";
        slotEditorReserved.value = slot.reserved_for || "";
        slotEditorState.value = slot.status === "disabled" ? "disabled" : "available";
        slotEditorReason.value = slot.disabled_reason || "";
      }

      if (openSlotHistoryBtnEl) openSlotHistoryBtnEl.disabled = false;
      if (slotInspectorLoading) {
        slotInspectorHistoryEl.innerHTML = window.NaapUiState.render("loading", {
          title: "Loading history",
          message: "Retrieving recent activity for this slot.",
          compact: true
        });
        return;
      }
      if (slotInspectorError) {
        slotInspectorHistoryEl.innerHTML = window.NaapUiState.render("error", {
          title: "History unavailable",
          message: slotInspectorError,
          compact: true
        });
        return;
      }
      if (!selectedSlotHistoryRows.length) {
        slotInspectorHistoryEl.innerHTML = window.NaapUiState.render("empty", {
          title: "No recent activity",
          message: "This slot has no recorded parking activity yet.",
          compact: true
        });
        return;
      }
      slotInspectorHistoryEl.innerHTML = selectedSlotHistoryRows.slice(0, 5).map(renderSlotInspectorHistoryItem).join("");
    }

    async function loadSelectedSlotHistory(slotCode, force = false) {
      const normalizedCode = normalizeSlotCode(slotCode);
      if (!normalizedCode) return;
      if (!force && slotHistoryCache.has(normalizedCode)) {
        selectedSlotHistoryRows = slotHistoryCache.get(normalizedCode) || [];
        slotInspectorError = "";
        slotInspectorLoading = false;
        renderSlotInspector();
        return;
      }

      slotInspectorLoading = true;
      slotInspectorError = "";
      renderSlotInspector();
      const requestId = ++slotHistoryRequestId;
      try {
        const resp = await fetch(`/api/parking-slot-history?slot_code=${encodeURIComponent(normalizedCode)}`, { credentials: "same-origin" });
        const data = await resp.json();
        if (!data.ok) throw new Error(data.message || "Unable to load slot history.");
        const rows = Array.isArray(data.rows) ? data.rows : [];
        slotHistoryCache.set(normalizedCode, rows);
        if (requestId !== slotHistoryRequestId || normalizeSlotCode(selectedSlotCode) !== normalizedCode) return;
        selectedSlotHistoryRows = rows;
        slotInspectorError = "";
      } catch (error) {
        if (requestId !== slotHistoryRequestId || normalizeSlotCode(selectedSlotCode) !== normalizedCode) return;
        selectedSlotHistoryRows = [];
        slotInspectorError = error.message || "Unable to load slot history.";
      } finally {
        if (requestId !== slotHistoryRequestId || normalizeSlotCode(selectedSlotCode) !== normalizedCode) return;
        slotInspectorLoading = false;
        renderSlotInspector();
      }
    }

    function renderEmptySlotHistory(message, type = "empty") {
      const title = type === "loading" ? "Loading history" : type === "error" ? "History unavailable" : "No parking history";
      return window.NaapUiState.render(type, { title, message, compact: true });
    }

    // Separate the date and time for scanning while preserving the recorded timestamp.
    function renderSlotHistoryTime(value, fallback = "Not recorded") {
      const date = value ? new Date(value) : null;
      if (!date || !Number.isFinite(date.getTime())) return `<span class="slot-history-pending">${escapeHtml(fallback)}</span>`;
      const time = date.toLocaleTimeString("en-US", { timeZone: "Asia/Manila", hour: "numeric", minute: "2-digit", second: "2-digit" });
      const day = date.toLocaleDateString("en-US", { timeZone: "Asia/Manila", month: "short", day: "numeric", year: "numeric" });
      return `<time datetime="${date.toISOString()}"><strong>${escapeHtml(time)}</strong><span>${escapeHtml(day)}</span></time>`;
    }

    function renderSlotHistoryCard(item) {
      const parkedAt = item.parked_at || item.scanned_at;
      const state = item.is_ongoing ? "inside" : "exited";
      const statusLabel = item.is_ongoing ? "Still parked" : "Exited";
      return `<article class="slot-history-card">
        <div class="slot-history-card-head">
          <h4>${escapeHtml(item.full_name || "Unknown Student")}</h4>
          <span class="slot-history-status ${state}">${statusLabel}</span>
        </div>
        <dl class="slot-history-details">
          <div><dt>Plate number</dt><dd>${escapeHtml(item.plate_number || "-")}</dd></div>
          <div><dt>Student number</dt><dd>${escapeHtml(item.student_number || "-")}</dd></div>
        </dl>
        <ol class="slot-history-timeline">
          <li class="slot-history-entry">
            <span class="slot-history-event-label">Entry</span>
            ${renderSlotHistoryTime(parkedAt)}
            <span class="slot-history-gate">Entry gate: ${escapeHtml(item.entry_gate || item.gate || "Not recorded")}</span>
          </li>
          <li class="slot-history-exit">
            <span class="slot-history-event-label">Exit</span>
            ${renderSlotHistoryTime(item.exited_at, item.is_ongoing ? "Awaiting exit" : "Not recorded")}
          </li>
        </ol>
        <div class="slot-history-card-footer">
          <span>Space <strong>${escapeHtml(item.parking_slot || "-")}</strong></span>
          <span>Time parked <strong>${escapeHtml(item.duration_label || "-")}</strong></span>
        </div>
      </article>`;
    }

    function closeSlotHistoryModal() {
      if (!slotHistoryModal?.classList.contains("open")) return;
      ++slotHistoryModalRequestId;
      slotHistoryModal.classList.remove("open");
      slotHistoryModal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");
      if (slotHistoryAppShell) slotHistoryAppShell.inert = slotHistoryWasInert;
      if (slotHistoryReturnFocus?.isConnected) slotHistoryReturnFocus.focus({ preventScroll: true });
      slotHistoryReturnFocus = null;
    }

    async function openSlotHistoryModal(slotCode) {
      if (!slotCode || !slotHistoryModal) return;
      const requestId = ++slotHistoryModalRequestId;
      slotHistoryReturnFocus = document.activeElement;
      slotHistoryWasInert = Boolean(slotHistoryAppShell?.inert);
      slotHistoryModal.classList.add("open");
      slotHistoryModal.setAttribute("aria-hidden", "false");
      document.body.classList.add("modal-open");
      slotHistoryCloseBtn?.focus({ preventScroll: true });
      if (slotHistoryAppShell) slotHistoryAppShell.inert = true;
      if (slotHistoryTitle) slotHistoryTitle.textContent = `Slot ${slotCode} history`;
      if (slotHistoryMeta) slotHistoryMeta.textContent = "Loading parking records...";
      if (slotHistoryList) slotHistoryList.innerHTML = renderEmptySlotHistory("Retrieving parking activity for this slot.", "loading");
      slotHistoryList?.setAttribute("aria-busy", "true");

      try {
        const resp = await fetch(`/api/parking-slot-history?slot_code=${encodeURIComponent(slotCode)}`);
        const data = await resp.json();
        // A closed or reopened dialog must not display a previous request's results.
        if (requestId !== slotHistoryModalRequestId) return;
        if (!resp.ok || !data.ok) throw new Error(data.message || "Failed to load slot history.");
        const rows = Array.isArray(data.rows) ? data.rows : [];
        if (slotHistoryList) {
          slotHistoryList.innerHTML = rows.length
            ? rows.map(renderSlotHistoryCard).join("")
            : renderEmptySlotHistory(`No parking history found for slot ${slotCode}.`);
        }
        if (slotHistoryMeta) {
          slotHistoryMeta.textContent = `${rows.length} parking record${rows.length === 1 ? "" : "s"}`;
        }
      } catch (error) {
        if (requestId !== slotHistoryModalRequestId) return;
        if (slotHistoryList) slotHistoryList.innerHTML = renderEmptySlotHistory(error.message || "Unable to load slot history.", "error");
        if (slotHistoryMeta) slotHistoryMeta.textContent = "History unavailable";
      } finally {
        if (requestId === slotHistoryModalRequestId) slotHistoryList?.removeAttribute("aria-busy");
      }
    }

    function attachParkingSlotHandlers() {
      const tiles = Array.from(document.querySelectorAll(".parking-slot-tile"));
      tiles.forEach((tile) => {
        const slotCode = normalizeSlotCode(tile.dataset.slotCode);
        tile.addEventListener("click", () => {
          if (!slotCode) return;
          const changed = slotCode !== normalizeSlotCode(selectedSlotCode);
          selectedSlotCode = slotCode;
          if (changed) {
            selectedSlotHistoryRows = [];
            slotInspectorError = "";
          }
          renderParkingSlotsSection();
        });
      });
    }

    function renderParkingSlotsSection() {
      window.NaapAdminMap?.beforeRender();
      const summary = normalizeParkingSlotSummary(latestParkingSlotSummary, latestParkingSlots);
      if (slotMetricTotal) slotMetricTotal.textContent = summary.total;
      if (slotMetricAvailable) slotMetricAvailable.textContent = summary.available;
      if (slotMetricOccupied) slotMetricOccupied.textContent = summary.occupied;
      if (slotMetricDisabled) slotMetricDisabled.textContent = summary.disabled;
      updateSlotFilterButtons(summary);
      renderAvailableSlotsStrip(latestParkingSlots, summary);

      const previousSelected = normalizeSlotCode(selectedSlotCode);
      const selectedStillExists = latestParkingSlots.some((slot) => normalizeSlotCode(slot.slot_code) === previousSelected);
      if (!selectedStillExists) {
        const fallback = latestParkingSlots.find((slot) => (slot.occupancy || "available") === "available") || latestParkingSlots[0] || null;
        selectedSlotCode = normalizeSlotCode(fallback?.slot_code || "");
        selectedSlotHistoryRows = [];
        slotInspectorError = "";
      }
      const selectedChanged = normalizeSlotCode(selectedSlotCode) !== previousSelected;

      const filteredSlots = applyParkingSlotFilters(latestParkingSlots);
      renderParkingSlotsTable(filteredSlots);
      if (parkingSlotsMetaEl) {
        parkingSlotsMetaEl.textContent = `${summary.available} available · ${summary.occupied} occupied · ${summary.disabled} blocked · Showing ${filteredSlots.length} of ${summary.total}`;
      }
      if (parkingSlotsListEl) {
        const emptyMessage = latestParkingSlots.length ? "No slots match the selected filter." : "No parking slots configured.";
        if (!filteredSlots.length) {
          parkingSlotsListEl.innerHTML = renderEmptyParkingSlots(emptyMessage);
        } else {
          const grouped = groupSlotsByZone(filteredSlots);
          const zoneNames = Object.keys(grouped).sort((a, b) => String(a).localeCompare(String(b), undefined, { numeric: true }));
          parkingSlotsListEl.innerHTML = zoneNames.map((zoneName) => {
            const zoneSlots = grouped[zoneName]
              .slice()
              .sort((a, b) => String(a.slot_code || "").localeCompare(String(b.slot_code || ""), undefined, { numeric: true }));
            const zoneAvailable = zoneSlots.filter((slot) => (slot.occupancy || "available") === "available").length;
            return `
              <section class="parking-zone-section">
                <div class="parking-zone-header">
                  <h4>${escapeHtml(zoneName)}</h4>
                  <span>${zoneAvailable}/${zoneSlots.length} available</span>
                </div>
                <div class="parking-zone-grid" data-parking-zone="${escapeHtml(zoneName)}">
                  ${zoneSlots.map(renderParkingSlotCard).join("")}
                </div>
              </section>
            `;
          }).join("");
        }
      }

      parkingSlotsListEl?.querySelectorAll(".parking-zone-grid").forEach(window.NaapParkingLayout.apply);
      window.NaapAdminMap?.render({ slots: latestParkingSlots, zones: mapZoneSettings, selectedCode: selectedSlotCode });
      window.NaapPages?.parkingRendered();
      attachParkingSlotHandlers();
      renderSlotInspector();
      const selectedCode = normalizeSlotCode(selectedSlotCode);
      if (selectedCode && (selectedChanged || !slotHistoryCache.has(selectedCode))) {
        loadSelectedSlotHistory(selectedCode);
      }
    }

    async function refreshSlots(event) {
      const manual = event?.type === "click";
      window.NaapAdminMap?.loading(true);
      if (manual && refreshBtn) {
        refreshBtn.disabled = true;
        refreshBtn.setAttribute("aria-busy", "true");
      }
      try {
        const resp = await fetch("/api/parking-slot-overview", { credentials: "same-origin" });
        const data = await resp.json();
        if (!resp.ok || !data.ok) throw new Error("Refresh unavailable");
        latestParkingSlots = Array.isArray(data.slots) ? data.slots : [];
        latestParkingSlotSummary = normalizeParkingSlotSummary(data.summary || {}, latestParkingSlots);
        renderParkingSlotsSection();
        if (lastUpdatedEl) lastUpdatedEl.textContent = `Last updated: ${new Date().toLocaleTimeString()}`;
        lastUpdatedEl?.classList.remove("is-stale");
        lastUpdatedEl?.classList.add("is-current");
        if (manual) window.NaapFeedback?.show("Parking availability updated.", { tone: "success" });
      } catch (error) {
        if (lastUpdatedEl) {
          lastUpdatedEl.textContent = "Update failed · showing previous data";
          lastUpdatedEl.classList.remove("is-current");
          lastUpdatedEl.classList.add("is-stale");
        }
        if (manual) window.NaapFeedback?.show("Parking availability could not update. Check your connection and try Refresh again.", { tone: "error" });
        console.error("Failed to refresh parking slots:", error);
      } finally {
        window.NaapAdminMap?.loading(false);
        if (manual && refreshBtn) {
          refreshBtn.disabled = false;
          refreshBtn.removeAttribute("aria-busy");
        }
      }
    }

    slotFilterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextFilter = button.dataset.slotFilter || "all";
        if (nextFilter === activeSlotFilter) return;
        activeSlotFilter = nextFilter;
        renderParkingSlotsSection();
      });
    });

    parkingViewButtons.forEach(button => {
      button.addEventListener("click", () => {
        parkingView = button.dataset.parkingView === "table" ? "table" : "map";
        const update = () => renderParkingSlotsTable(applyParkingSlotFilters(latestParkingSlots));
        if (window.NaapPages) window.NaapPages.switchView(update, () => parkingView === "map" ? parkingSlotsListEl : parkingSlotsTableRegion);
        else update();
      });
    });
    parkingSlotsTableBody?.addEventListener("click", event => {
      const button = event.target instanceof Element ? event.target.closest("[data-slot-select]") : null;
      if (!button) return;
      selectedSlotCode = normalizeSlotCode(button.dataset.slotSelect);
      selectedSlotHistoryRows = slotHistoryCache.get(selectedSlotCode) || [];
      slotInspectorError = "";
      renderParkingSlotsSection();
      slotInspectorTitleEl?.focus({ preventScroll: true });
      slotInspectorTitleEl?.scrollIntoView({ block: "nearest", behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    });

    if (parkingSlotSearchEl) {
      parkingSlotSearchEl.addEventListener("input", () => {
        slotSearchQuery = parkingSlotSearchEl.value || "";
        renderParkingSlotsSection();
      });
    }

    if (availableSlotsStripEl) {
      availableSlotsStripEl.addEventListener("click", (event) => {
        const source = event.target instanceof Element ? event.target : null;
        if (!source) return;
        const trigger = source.closest("[data-slot-pill]");
        if (!trigger) return;
        const slotCode = trigger.dataset.slotPill || "";
        if (!slotCode) return;
        parkingView = "map";
        activeSlotFilter = "all";
        slotSearchQuery = slotCode;
        selectedSlotCode = normalizeSlotCode(slotCode);
        selectedSlotHistoryRows = [];
        slotInspectorError = "";
        if (parkingSlotSearchEl) parkingSlotSearchEl.value = slotCode;
        renderParkingSlotsSection();
        focusSlotTileByCode(slotCode);
      });
    }

    if (openSlotHistoryBtnEl) {
      openSlotHistoryBtnEl.addEventListener("click", () => {
        const slotCode = normalizeSlotCode(selectedSlotCode);
        if (!slotCode) return;
        openSlotHistoryModal(slotCode);
      });
    }

    if (refreshBtn) refreshBtn.addEventListener("click", refreshSlots);
    if (slotHistoryModal) {
      slotHistoryModal.querySelectorAll("[data-close-slot-history]").forEach((el) => {
        el.addEventListener("click", closeSlotHistoryModal);
      });
    }
    document.addEventListener("keydown", (event) => {
      if (!slotHistoryModal?.classList.contains("open")) return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeSlotHistoryModal();
      } else if (event.key === "Tab") {
        // Keep keyboard navigation inside the dialog; the record list can be scrolled.
        const first = slotHistoryCloseBtn;
        const last = slotHistoryList;
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    });

    latestParkingSlotSummary = normalizeParkingSlotSummary(latestParkingSlotSummary, latestParkingSlots);
    renderParkingSlotsSection();
    setInterval(refreshSlots, 20000);
  })();
</script>

<%- include("partials/footer") %>
