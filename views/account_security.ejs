<%- include("partials/header") %>
<%
  const safeSessions = Array.isArray(sessions) ? sessions : [];
  const safeAuditRows = Array.isArray(auditRows) ? auditRows : [];
  const dateLabel = (value) => value ? new Date(value).toLocaleString("en-PH", { timeZone: "Asia/Manila" }) : "Not recorded";
%>

<section class="dashboard-hero security-hero">
  <div class="hero-greeting">
    <h2>Account</h2>
    <h1>Security &amp; Sessions</h1>
    <p>Manage your password and signed-in devices.</p>
  </div>
  <div class="hero-cards">
    <div class="hero-card"><h3>Role</h3><p class="security-text-value"><%= account.role %></p></div>
    <div class="hero-card"><h3>Active Sessions</h3><p><%= safeSessions.length %></p></div>
    <div class="hero-card"><h3>Last Login</h3><p class="security-date-value"><%= dateLabel(account.last_login_at) %></p></div>
  </div>
  <% if (flash) { %><div class="flash flash-<%= flash.type === 'success' ? 'success' : 'error' %>"><%= flash.message %></div><% } %>
</section>

<div class="overlap-wrapper security-settings-grid">
  <section class="panel" id="password">
    <div class="section-head">
      <h2>Change Password</h2>
      <p>Use at least 10 characters with uppercase, lowercase, and a number.</p>
    </div>
    <% if (account.must_change_password) { %><div class="security-status is-required"><strong>Temporary password must be replaced.</strong><span>Other application pages remain locked until you choose a private password.</span></div><% } %>
    <form method="post" action="/account/password" class="form-grid security-form" data-form-feedback>
      <div><label for="current_password">Current password</label><input id="current_password" name="current_password" type="password" autocomplete="current-password" required /></div>
      <div><label for="new_password">New password</label><input id="new_password" data-password-rules name="new_password" type="password" minlength="10" autocomplete="new-password" required /></div>
      <div><label for="confirm_password">Confirm new password</label><input id="confirm_password" data-match="new_password" name="confirm_password" type="password" minlength="10" autocomplete="new-password" required /></div>
      <div class="form-actions"><button type="submit">Update Password</button></div>
    </form>
  </section>

  <section class="panel" id="sessions">
    <div class="section-head">
      <h2>Active Sessions</h2>
      <p>Revoke access from devices you no longer use.</p>
    </div>
    <div class="security-session-list">
      <% safeSessions.forEach((sessionItem) => { %>
        <article class="security-session-item">
          <div><strong><%= sessionItem.current ? "This device" : `Session ${sessionItem.fingerprint}` %></strong><span>Expires <%= dateLabel(sessionItem.expires_at) %></span></div>
          <% if (sessionItem.current) { %><span class="badge">Current</span><% } else { %>
            <button type="button" class="btn-delete-sm" data-destructive-trigger data-form-id="revokeSession_<%= sessionItem.fingerprint %>" data-confirm-title="Revoke session?" data-confirm-message="Sign this device out of your account?" data-confirm-label="Revoke session">Revoke</button>
            <form id="revokeSession_<%= sessionItem.fingerprint %>" class="destructive-form" method="post" action="/account/sessions/<%= sessionItem.fingerprint %>/revoke" hidden></form>
          <% } %>
        </article>
      <% }) %>
      <% if (!safeSessions.length) { %><p class="helper-text">No active session records were found.</p><% } %>
    </div>
    <% if (safeSessions.some((item) => !item.current)) { %>
      <div class="security-revoke-all">
        <button type="button" class="btn-delete-sm" data-destructive-trigger data-form-id="revokeOtherSessions" data-confirm-title="Revoke other sessions?" data-confirm-message="Sign out every other device currently using your account?" data-confirm-label="Revoke sessions">Revoke All Other Sessions</button>
        <form id="revokeOtherSessions" class="destructive-form" method="post" action="/account/sessions/revoke-others" hidden></form>
      </div>
    <% } %>
  </section>

  <section class="panel">
    <div class="section-head"><h2>Recent Account Activity</h2><p>Security-related events for your account.</p></div>
    <div class="security-audit-list">
      <% safeAuditRows.forEach((row) => { %><div><strong><%= String(row.event_type || '').replace(/_/g, ' ') %></strong><span><%= row.outcome %> · <%= dateLabel(row.created_at) %></span></div><% }) %>
      <% if (!safeAuditRows.length) { %><p class="helper-text">No account activity has been recorded yet.</p><% } %>
    </div>
  </section>
</div>

<%- include("partials/footer") %>
