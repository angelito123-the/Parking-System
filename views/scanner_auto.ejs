<%- include("partials/header") %>

<% const isRemoteScannerMode = Boolean(deferEntryConfirmation); %>

<section class="dashboard-hero">
  <div class="hero-greeting">
    <h2>Gate Operations</h2>
    <h1><%= isRemoteScannerMode ? 'Remote Camera' : 'Scan & Process' %></h1>
  </div>
  <p class="hero-description">
    <%= isRemoteScannerMode
      ? 'Use this device as a camera and send entry requests to the guard console.'
      : 'Scan a QR, assign an entry slot, and continue to the next vehicle from one screen.' %>
  </p>
</section>

<div class="overlap-wrapper auto-gate-shell" data-scan-cooldown="<%= scanCooldownSeconds %>" data-scanner-mode="<%= isRemoteScannerMode ? 'remote' : 'local' %>">
  <section class="panel scan-mode-bar" aria-label="Scanner mode">
    <div class="scan-mode-copy">
      <strong><%= isRemoteScannerMode ? 'Remote phone mode' : 'Standard gate mode' %></strong>
      <span><%= isRemoteScannerMode ? 'Entries wait for approval on another device.' : 'Recommended: scan and approve entries on this device.' %></span>
    </div>
    <div class="scan-mode-switch" role="navigation" aria-label="Choose scanner workflow">
      <a href="/scanner/auto" class="<%= isRemoteScannerMode ? '' : 'is-active' %>" <%- isRemoteScannerMode ? '' : 'aria-current="page"' %>>This device</a>
      <a href="/scanner/auto?mode=remote" class="<%= isRemoteScannerMode ? 'is-active' : '' %>" <%- isRemoteScannerMode ? 'aria-current="page"' : '' %>>Remote phone</a>
    </div>
  </section>

  <section class="panel auto-gate-camera-panel">
    <div class="auto-gate-toolbar">
      <div>
        <h3>Scan Vehicle QR</h3>
        <p>The rear camera starts automatically. Hold the QR inside the guide.</p>
      </div>
      <div class="auto-gate-controls">
        <div>
          <label for="autoGateSelect">Gate</label>
          <select id="autoGateSelect">
            <option value="Main Gate">Main Gate</option>
            <option value="Side Gate">Side Gate</option>
            <option value="North Gate">North Gate</option>
            <option value="South Gate">South Gate</option>
          </select>
        </div>
        <button type="button" id="toggleAutoCameraBtn" class="auto-camera-toggle">Stop Camera</button>
      </div>
    </div>

    <div class="auto-indicator-row">
      <span id="chipAutoState" class="auto-chip state-live">Scanner Active</span>
      <span id="chipCameraState" class="auto-chip state-live">Camera Ready</span>
      <span id="chipCooldownState" class="auto-chip state-idle">Ready for QR</span>
      <span id="chipOfflineQueueState" class="auto-chip state-idle">Offline Queue: 0</span>
    </div>

    <div id="autoCameraWrapper" class="auto-camera-wrapper">
      <div id="autoQrReader"></div>

      <div id="cameraHud" class="auto-camera-hud" aria-hidden="true">
        <div class="hud-corners">
          <span class="corner tl"></span>
          <span class="corner tr"></span>
          <span class="corner bl"></span>
          <span class="corner br"></span>
        </div>
        <div class="scan-line"></div>
        <p class="hud-label">QR can be detected anywhere in view</p>
      </div>

      <div id="processingOverlay" class="auto-processing-overlay" hidden>
        <div class="processing-box">
          <span class="processing-spinner" aria-hidden="true"></span>
          <p>Processing scan...</p>
        </div>
      </div>

      <p id="autoCameraStatus" class="auto-camera-status">Initializing rear camera...</p>
      <div class="scanner-assist scanner-assist-auto">
        <p id="autoScannerGuidance" class="scanner-guidance" role="status" aria-live="polite">
          <span class="scanner-guidance-dot" aria-hidden="true"></span>
          <span class="scanner-guidance-text">Start the camera to scan a QR code.</span>
        </p>
        <button id="autoScannerTorchBtn" class="scanner-torch-btn" type="button" aria-pressed="false" aria-label="Turn flashlight on" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 2h6l1 4-2 3v11a2 2 0 0 1-4 0V9L8 6l1-4Z"></path>
            <path d="M10 6h4"></path>
          </svg>
          <span class="scanner-torch-label">Flashlight</span>
        </button>
      </div>
    </div>

    <details class="scanner-diagnostics">
      <summary>Scanner details</summary>
      <div class="scanner-diagnostics-chips">
        <span id="chipMlState" class="auto-chip state-idle">Smart Assist: Starting</span>
        <span id="chipRiskState" class="auto-chip state-idle">QR Safety: Waiting</span>
        <span id="chipStabilityState" class="auto-chip state-idle">Read: 0/2</span>
      </div>
      <p id="smartAssistSummary" class="scanner-learning-note">Learns successful scan conditions on this device. Camera frames stay private.</p>
      <div class="scanner-diagnostic-actions">
        <button type="button" id="recalibrateScannerBtn" class="link-btn">Recalibrate Camera</button>
        <button type="button" id="resetSmartAssistBtn" class="link-btn">Reset Learning</button>
        <button type="button" id="runDeviceCheckBtn" class="link-btn">Run Device Check</button>
      </div>
      <div id="scannerDeviceCheckResults" class="scanner-device-check-results" hidden aria-live="polite"></div>
    </details>

    <p class="scanner-flow-note">
      <strong><%= isRemoteScannerMode ? 'Remote workflow:' : 'Simple workflow:' %></strong>
      <%= isRemoteScannerMode
        ? 'Entry scans are sent to the other guard device. Exits are recorded automatically.'
        : 'For entry, choose an available slot below. Exits are recorded automatically.' %>
    </p>
  </section>

  <section class="panel auto-gate-result-panel">
    <div class="section-head">
      <h2>Current Scan</h2>
      <p><%= isRemoteScannerMode ? 'Entry approvals will appear on the guard console.' : 'Follow the prompt shown here after the QR is detected.' %></p>
    </div>

    <div id="autoResultCard" class="auto-result-card state-idle">
      <h3 id="autoResultTitle">Waiting for QR detection</h3>
      <p id="autoResultMessage">Point the camera to a student vehicle QR sticker anywhere in view.</p>
      <div id="autoResultMeta" class="auto-result-meta"></div>
    </div>

    <div id="entryConfirmPanel" class="entry-confirm-panel" style="display:none;">
      <div class="entry-confirm-head">
        <h3>Choose a Slot</h3>
        <p>Select one available parking slot, then confirm the vehicle entry.</p>
      </div>

      <div id="entryStickerDetails" class="entry-sticker-grid"></div>

      <div class="auto-slot-header">
        <strong>Available Parking Slots</strong>
        <span id="autoSlotStatus" class="helper-text">Loading slot map...</span>
      </div>
      <div id="autoSlotMap" class="auto-slot-map"></div>
      <p id="entryConfirmHint" class="helper-text"></p>

      <div class="entry-confirm-actions">
        <button type="button" id="confirmEntryBtn" class="entry-confirm-btn" disabled>Confirm Entry</button>
        <button type="button" id="cancelEntryBtn" class="entry-cancel-btn">Cancel</button>
      </div>
    </div>

    <details class="auto-session-panel">
      <summary class="auto-session-head">
        <span>
          <strong>Recent Scans</strong>
          <small>Activity from this session</small>
        </span>
        <span aria-hidden="true">View</span>
      </summary>
      <div class="auto-session-content">
        <div id="sessionEventEmpty" class="auto-session-empty">No scans yet.</div>
        <div id="sessionEventList" class="auto-session-list"></div>
      </div>
    </details>

    <div class="auto-fallback-actions">
      <a href="/scanner" class="link-btn"><%= isRemoteScannerMode ? 'Open guard console' : 'QR not scanning? Use manual lookup' %></a>
      <button type="button" id="resumeScannerBtn" class="auto-resume-btn">Resume Scanner</button>
    </div>
  </section>
</div>

<div id="scanInfoPopup" class="slot-history-modal scan-info-popup" aria-hidden="true">
  <div class="slot-history-backdrop" data-scan-popup-close></div>
  <article id="scanInfoPopupCard" class="slot-history-dialog scan-info-popup-card tone-info" role="dialog" aria-modal="true" aria-labelledby="scanInfoPopupTitle">
    <button type="button" id="scanInfoPopupClose" class="slot-history-close scan-info-popup-close" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12"></path>
        <path d="M18 6 6 18"></path>
      </svg>
    </button>
    <p id="scanInfoPopupKicker" class="scan-info-popup-kicker">Scan detected</p>
    <h3 id="scanInfoPopupTitle">Vehicle Scan Result</h3>
    <p id="scanInfoPopupMessage" class="scan-info-popup-message">Waiting for data...</p>
    <div id="scanInfoPopupMeta" class="scan-info-popup-meta"></div>
  </article>
</div>

<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
<script src="/js/qr-token-parser.js?v=20260826-accuracy1"></script>
<script src="/js/qr-behavior-classifier.js"></script>
<script src="/js/scan-readiness-model.js?v=20260828-ops1"></script>
<script src="/js/ml-qr-detector.js?v=20260828-ops1"></script>
<script src="/js/scanner-guidance.js?v=20260827-ml1"></script>
<script src="/js/scanner-device-check.js?v=20260828-ops1"></script>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
  (() => {
    const shell = document.querySelector(".auto-gate-shell");
    const cooldownSeconds = Number(shell?.dataset.scanCooldown || 10);
    const deferEntryConfirmation = <%- isRemoteScannerMode ? "true" : "false" %>;
    const HEARTBEAT_INTERVAL_MS = 6000;
    const HEARTBEAT_STORAGE_KEY = "naap_auto_scanner_device_id";
    const GATE_STORAGE_KEY = "naap_scanner_gate";
    const enhancedScannerAvailable = typeof window.MLQrCodeScanner === "function" && typeof window.jsQR === "function";

    const STABLE_READ_MIN_HITS = 2;
    const STABLE_READ_WINDOW_MS = 2800;
    const LOCAL_DEDUP_FLOOR_MS = 2500;

    const gateSelect = document.getElementById("autoGateSelect");
    const cameraWrapper = document.getElementById("autoCameraWrapper");
    const toggleCameraBtn = document.getElementById("toggleAutoCameraBtn");
    const resumeScannerBtn = document.getElementById("resumeScannerBtn");
    const cameraStatus = document.getElementById("autoCameraStatus");
    const processingOverlay = document.getElementById("processingOverlay");
    const scannerGuidance = new window.ScannerGuidance({
      cameraContainer: "autoQrReader",
      guidanceElement: "autoScannerGuidance",
      torchButton: "autoScannerTorchBtn"
    });

    const chipAutoState = document.getElementById("chipAutoState");
    const chipCameraState = document.getElementById("chipCameraState");
    const chipMlState = document.getElementById("chipMlState");
    const smartAssistSummary = document.getElementById("smartAssistSummary");
    const chipRiskState = document.getElementById("chipRiskState");
    const chipStabilityState = document.getElementById("chipStabilityState");
    const chipCooldownState = document.getElementById("chipCooldownState");
    const chipOfflineQueueState = document.getElementById("chipOfflineQueueState");
    const recalibrateScannerBtn = document.getElementById("recalibrateScannerBtn");
    const resetSmartAssistBtn = document.getElementById("resetSmartAssistBtn");
    const runDeviceCheckBtn = document.getElementById("runDeviceCheckBtn");
    const scannerDeviceCheckResults = document.getElementById("scannerDeviceCheckResults");

    const resultCard = document.getElementById("autoResultCard");
    const resultTitle = document.getElementById("autoResultTitle");
    const resultMessage = document.getElementById("autoResultMessage");
    const resultMeta = document.getElementById("autoResultMeta");

    const entryConfirmPanel = document.getElementById("entryConfirmPanel");
    const entryStickerDetails = document.getElementById("entryStickerDetails");
    const autoSlotStatus = document.getElementById("autoSlotStatus");
    const autoSlotMap = document.getElementById("autoSlotMap");
    const entryConfirmHint = document.getElementById("entryConfirmHint");
    const confirmEntryBtn = document.getElementById("confirmEntryBtn");
    const cancelEntryBtn = document.getElementById("cancelEntryBtn");

    const sessionEventEmpty = document.getElementById("sessionEventEmpty");
    const sessionEventList = document.getElementById("sessionEventList");
    const scanInfoPopup = document.getElementById("scanInfoPopup");
    const scanInfoPopupCard = document.getElementById("scanInfoPopupCard");
    const scanInfoPopupClose = document.getElementById("scanInfoPopupClose");
    const scanInfoPopupKicker = document.getElementById("scanInfoPopupKicker");
    const scanInfoPopupTitle = document.getElementById("scanInfoPopupTitle");
    const scanInfoPopupMessage = document.getElementById("scanInfoPopupMessage");
    const scanInfoPopupMeta = document.getElementById("scanInfoPopupMeta");

    try {
      const savedGate = localStorage.getItem(GATE_STORAGE_KEY);
      if (savedGate && Array.from(gateSelect?.options || []).some((option) => option.value === savedGate)) {
        gateSelect.value = savedGate;
      }
    } catch (_storageError) {
      // Continue with Main Gate when browser storage is unavailable.
    }

    if (deferEntryConfirmation && entryConfirmPanel) {
      entryConfirmPanel.style.display = "none";
    }

    let html5QrCode = null;
    let cameraStarted = false;
    let processingScan = false;

    const QR_STATE = {
      UNKNOWN: (typeof Html5QrcodeScannerState !== "undefined" && Html5QrcodeScannerState?.UNKNOWN !== undefined)
        ? Html5QrcodeScannerState.UNKNOWN
        : 0,
      NOT_STARTED: (typeof Html5QrcodeScannerState !== "undefined" && Html5QrcodeScannerState?.NOT_STARTED !== undefined)
        ? Html5QrcodeScannerState.NOT_STARTED
        : 1,
      SCANNING: (typeof Html5QrcodeScannerState !== "undefined" && Html5QrcodeScannerState?.SCANNING !== undefined)
        ? Html5QrcodeScannerState.SCANNING
        : 2,
      PAUSED: (typeof Html5QrcodeScannerState !== "undefined" && Html5QrcodeScannerState?.PAUSED !== undefined)
        ? Html5QrcodeScannerState.PAUSED
        : 3
    };

    let selectedSlotId = null;
    let pendingToken = null;
    let pendingSticker = null;
    let pendingSlotOverview = null;

    let lastRiskAssessment = null;
    let latestMlMeta = null;
    let scanCycleStartedAt = Date.now();
    let unreadableFrameCount = 0;
    let lastGuidanceKey = "center";

    let stableCandidateToken = "";
    let stableCandidateHits = 0;
    let stableCandidateFirstSeenMs = 0;
    let scanInfoPopupTimer = null;
    let heartbeatTimer = null;
    let heartbeatInFlight = false;
    const scannerDeviceId = getOrCreateDeviceId();

    const localCooldownUntilMs = new Map();
    const sessionEvents = [];

    function setChip(element, text, state) {
      if (!element) return;
      element.textContent = text;
      element.className = `auto-chip state-${state}`;
    }

    function setRiskChip(risk) {
      if (!risk || !chipRiskState) {
        setChip(chipRiskState, "QR Safety: Waiting", "idle");
        return;
      }
      const scorePercent = Math.round((Number(risk.riskScore) || 0) * 100);
      if (risk.riskLevel === "high") {
        setChip(chipRiskState, `QR Safety: High risk (${scorePercent}%)`, "error");
        return;
      }
      if (risk.riskLevel === "medium") {
        setChip(chipRiskState, `QR Safety: Review (${scorePercent}%)`, "warning");
        return;
      }
      setChip(chipRiskState, `QR Safety: Clear (${scorePercent}%)`, "live");
    }

    function normalizeRiskAssessment(riskPayload, fallbackRisk = null) {
      if (!riskPayload || typeof riskPayload !== "object") {
        return fallbackRisk || null;
      }
      const level = String(
        riskPayload.riskLevel
        || riskPayload.risk_level
        || fallbackRisk?.riskLevel
        || "low"
      ).toLowerCase();
      const normalizedLevel = level === "high" || level === "medium" || level === "low"
        ? level
        : "low";
      const scoreRaw = Number(
        riskPayload.riskScore
        ?? riskPayload.risk_score
        ?? fallbackRisk?.riskScore
        ?? 0
      );
      const score = Math.max(0, Math.min(1, Number.isFinite(scoreRaw) ? scoreRaw : 0));
      const reasons = Array.isArray(riskPayload.reasons)
        ? riskPayload.reasons
        : (Array.isArray(riskPayload.risk_reasons) ? riskPayload.risk_reasons : []);
      return {
        riskLevel: normalizedLevel,
        riskScore: Math.round(score * 1000) / 1000,
        reasons: reasons
          .map((item) => String(item || "").trim())
          .filter(Boolean)
          .slice(0, 3)
      };
    }

    function classifyQrBehavior(rawValue) {
      if (!window.QRBehaviorClassifier || typeof window.QRBehaviorClassifier.classify !== "function") {
        return {
          riskScore: 0,
          riskLevel: "low",
          reasons: ["Behavior classifier unavailable."],
          features: {}
        };
      }
      return window.QRBehaviorClassifier.classify(rawValue);
    }

    function renderRiskMeta(risk) {
      if (!risk) return "";
      const reasons = Array.isArray(risk.reasons) ? risk.reasons : [];
      const leadReason = reasons[0] || "No anomaly reason available.";
      return `
        <p><strong>Risk:</strong> ${(risk.riskLevel || "low").toUpperCase()} (${Math.round((Number(risk.riskScore) || 0) * 100)}%)</p>
        <p><strong>Signal:</strong> ${escapeHtml(leadReason)}</p>
      `;
    }

    function renderMlMeta(meta) {
      if (!meta) return "";
      const confidence = Number(meta.ml_confidence ?? meta.confidence ?? 0);
      const processMs = Number(meta.process_ms ?? meta.processMs ?? 0);
      const readinessValue = meta.readiness_score ?? meta.readinessScore;
      const readiness = readinessValue === null || readinessValue === undefined ? null : Number(readinessValue);
      return `
        <p><strong>Detection Confidence:</strong> ${Math.round(confidence * 100)}%</p>
        ${Number.isFinite(readiness) ? `<p><strong>Scan Readiness:</strong> ${Math.round(readiness * 100)}%</p>` : ""}
        <p><strong>Frame Process:</strong> ${processMs > 0 ? `${Math.round(processMs)}ms` : "N/A"}</p>
      `;
    }

    function updateMlChip(meta) {
      latestMlMeta = meta || null;
      if (!meta) {
        setChip(chipMlState, "Smart Assist: Waiting", "idle");
        if (smartAssistSummary) smartAssistSummary.textContent = "Learns successful scan conditions on this device. Camera frames stay private.";
        return;
      }

      const confidence = Number(meta.confidence || meta.ml_confidence || 0);
      const readinessValue = meta.readinessScore ?? meta.readiness_score;
      const readiness = readinessValue === null || readinessValue === undefined ? null : Number(readinessValue);
      const samples = Math.max(0, Number(meta.learningSamples ?? meta.learning_samples ?? 0));
      if (Number.isFinite(readiness)) {
        const readinessPercent = Math.round(readiness * 100);
        const tone = readiness >= 0.68 ? "live" : readiness >= 0.42 ? "warning" : "idle";
        setChip(chipMlState, `Smart Assist: ${readinessPercent}% ready`, tone);
        if (smartAssistSummary) {
          smartAssistSummary.textContent = samples >= 12
            ? `Adapted from ${Math.round(samples)} local scan samples. No camera frames are stored.`
            : `Learning locally (${Math.round(samples)}/12 samples). No camera frames are stored.`;
        }
      } else if (confidence >= 0.45) {
        setChip(chipMlState, "Smart Assist: Active", "live");
      } else {
        setChip(chipMlState, "Smart Assist: Learning", "warning");
      }
    }

    function updateStabilityChip() {
      const hits = Math.max(0, Math.min(STABLE_READ_MIN_HITS, stableCandidateHits));
      setChip(chipStabilityState, `QR Read: ${hits}/${STABLE_READ_MIN_HITS}`, hits >= STABLE_READ_MIN_HITS ? "live" : "idle");
    }

    function updateCooldownChip() {
      const now = Date.now();
      let nearestRemainingMs = 0;
      for (const until of localCooldownUntilMs.values()) {
        if (until > now) {
          const remaining = until - now;
          if (!nearestRemainingMs || remaining < nearestRemainingMs) {
            nearestRemainingMs = remaining;
          }
        }
      }

      if (!nearestRemainingMs) {
        setChip(chipCooldownState, "Ready for QR", "idle");
        return;
      }

      const seconds = Math.max(1, Math.ceil(nearestRemainingMs / 1000));
      setChip(chipCooldownState, `Next scan in ${seconds}s`, "warning");
    }

    setInterval(updateCooldownChip, 350);

    function setCameraStatus(message, kind = "neutral") {
      if (!cameraStatus) return;
      cameraStatus.textContent = message;
      cameraStatus.classList.remove("status-ok", "status-error");
      if (kind === "ok") cameraStatus.classList.add("status-ok");
      if (kind === "error") cameraStatus.classList.add("status-error");
    }

    function makeDeviceId() {
      if (window.crypto && typeof window.crypto.randomUUID === "function") {
        return `phone-${window.crypto.randomUUID()}`;
      }
      return `phone-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
    }

    function getOrCreateDeviceId() {
      try {
        const existing = String(window.localStorage.getItem(HEARTBEAT_STORAGE_KEY) || "").trim();
        if (existing) return existing;
        const next = makeDeviceId();
        window.localStorage.setItem(HEARTBEAT_STORAGE_KEY, next);
        return next;
      } catch (_error) {
        return makeDeviceId();
      }
    }

    async function sendHeartbeat({ markScanReceived = false } = {}) {
      if (heartbeatInFlight) return;
      heartbeatInFlight = true;
      try {
        await fetch("/api/auto-scan/heartbeat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({
            device_id: scannerDeviceId,
            gate: gateSelect?.value || "Main Gate",
            mark_scan_received: markScanReceived ? 1 : 0
          })
        });
      } catch (_error) {
        // Keep scanner active even if heartbeat fails temporarily.
      } finally {
        heartbeatInFlight = false;
      }
    }

    function startHeartbeatLoop() {
      if (heartbeatTimer) clearInterval(heartbeatTimer);
      sendHeartbeat();
      heartbeatTimer = window.setInterval(() => {
        sendHeartbeat();
      }, HEARTBEAT_INTERVAL_MS);
    }

    function setProcessingOverlay(visible) {
      if (!processingOverlay) return;
      processingOverlay.hidden = !visible;
    }

    function setResultState(state, title, message, detailsHtml = "") {
      resultCard.className = `auto-result-card state-${state}`;
      resultTitle.textContent = title;
      resultMessage.textContent = message;
      resultMeta.innerHTML = detailsHtml || "";
      if (["success", "invalid", "error", "warning"].includes(state)) {
        requestAnimationFrame(() => resultCard.classList.add("is-feedback-pop"));
      }
    }

    function escapeHtml(value) {
      return String(value == null ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function popupMetaRow(label, value) {
      const cleanValue = String(value == null ? "" : value).trim();
      if (!cleanValue) return "";
      return `
        <div class="scan-info-meta-row">
          <span>${escapeHtml(label)}</span>
          <strong>${escapeHtml(cleanValue)}</strong>
        </div>
      `;
    }

    function resultMetaRow(label, value) {
      const cleanValue = String(value == null ? "" : value).trim();
      if (!cleanValue) return "";
      return `<p><strong>${escapeHtml(label)}:</strong> ${escapeHtml(cleanValue)}</p>`;
    }

    function closeScanInfoPopup() {
      if (!scanInfoPopup) return;
      if (scanInfoPopupTimer) {
        clearTimeout(scanInfoPopupTimer);
        scanInfoPopupTimer = null;
      }
      scanInfoPopup.classList.remove("open");
      scanInfoPopup.setAttribute("aria-hidden", "true");
    }

    function showScanInfoPopup(options = {}) {
      if (!scanInfoPopup || !scanInfoPopupCard) return;
      const tone = String(options.tone || "info");
      const title = String(options.title || "Scan Result");
      const message = String(options.message || "");
      const kicker = String(options.kicker || "Scan detected");
      const metaHtml = String(options.metaHtml || "");
      const autoHideMs = Math.max(1200, Number(options.autoHideMs) || 4500);
      const persist = options.persist === true;

      scanInfoPopupCard.classList.remove("tone-info", "tone-success", "tone-warning", "tone-error");
      scanInfoPopupCard.classList.add(`tone-${tone}`);
      scanInfoPopupKicker.textContent = kicker;
      scanInfoPopupTitle.textContent = title;
      scanInfoPopupMessage.textContent = message;
      scanInfoPopupMeta.innerHTML = metaHtml;
      scanInfoPopup.classList.add("open");
      scanInfoPopup.setAttribute("aria-hidden", "false");

      if (scanInfoPopupTimer) {
        clearTimeout(scanInfoPopupTimer);
        scanInfoPopupTimer = null;
      }

      if (!persist) {
        scanInfoPopupTimer = window.setTimeout(() => {
          closeScanInfoPopup();
        }, autoHideMs);
      }
    }

    function formatTime(date) {
      return new Intl.DateTimeFormat("en-PH", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
      }).format(date);
    }

    function pushSessionEvent(kind, status, title, detail) {
      sessionEvents.unshift({
        kind,
        status,
        title,
        detail,
        at: new Date()
      });
      if (sessionEvents.length > 10) sessionEvents.pop();
      renderSessionEvents();
    }

    function renderSessionEvents() {
      if (!sessionEvents.length) {
        sessionEventEmpty.style.display = "";
        sessionEventList.innerHTML = "";
        return;
      }

      sessionEventEmpty.style.display = "none";
      sessionEventList.innerHTML = sessionEvents.map((event) => {
        const statusClass = event.status || "idle";
        return `
          <article class="session-event ${statusClass}">
            <div class="session-event-main">
              <h4>${escapeHtml(event.title)}</h4>
              <p>${escapeHtml(event.detail || "")}</p>
            </div>
            <div class="session-event-meta">
              <span class="tag">${escapeHtml(event.kind)}</span>
              <time>${formatTime(event.at)}</time>
            </div>
          </article>
        `;
      }).join("");
    }

    function playTone(type = "ok") {
      if (navigator.vibrate) {
        navigator.vibrate(type === "ok" ? [60, 35, 80] : [180, 60, 80]);
      }
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);

        if (type === "ok") {
          osc.frequency.setValueAtTime(760, ctx.currentTime);
          gain.gain.setValueAtTime(0.0001, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.2);
          osc.start();
          osc.stop(ctx.currentTime + 0.22);
          return;
        }

        osc.frequency.setValueAtTime(260, ctx.currentTime);
        gain.gain.setValueAtTime(0.0001, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.1, ctx.currentTime + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.3);
        osc.start();
        osc.stop(ctx.currentTime + 0.32);
      } catch (_error) {
        // Silent fallback
      }
    }

    function resetScanCycle() {
      scanCycleStartedAt = Date.now();
      unreadableFrameCount = 0;
      lastGuidanceKey = "center";
    }

    function getDeviceClass() {
      if (window.ScannerDeviceCheck?.classifyDevice) {
        return window.ScannerDeviceCheck.classifyDevice(window.innerWidth, navigator.userAgent);
      }
      return window.innerWidth < 700 ? "mobile" : window.innerWidth < 1100 ? "tablet" : "desktop";
    }

    async function reportScannerMetric(outcome, options = {}) {
      const metric = {
        outcome,
        device_id: scannerDeviceId,
        gate_id: gateSelect?.value || "Main Gate",
        movement_action: options.action || null,
        detection_model: latestMlMeta?.model || (enhancedScannerAvailable ? "MLQrCodeScanner" : "html5-qrcode"),
        detection_confidence: Number(latestMlMeta?.confidence ?? latestMlMeta?.ml_confidence ?? 0),
        readiness_score: Number(latestMlMeta?.readinessScore ?? latestMlMeta?.readiness_score ?? 0),
        process_ms: Number(latestMlMeta?.processMs ?? latestMlMeta?.process_ms ?? 0),
        time_to_read_ms: Math.max(0, Date.now() - scanCycleStartedAt),
        unreadable_frames: unreadableFrameCount,
        guidance_key: lastGuidanceKey,
        failure_reason: options.reason || null,
        learning_samples: Number(latestMlMeta?.learningSamples ?? latestMlMeta?.learning_samples ?? 0),
        device_class: getDeviceClass(),
        occurred_at: new Date().toISOString()
      };
      try {
        if (window.OfflineManager?.queueScanMetric) {
          await window.OfflineManager.queueScanMetric(metric);
        } else {
          await fetch("/api/scanner-metrics", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify(metric)
          });
        }
      } catch (_error) {
        // Telemetry must never interrupt gate scanning.
      }
    }

    function updateOfflineQueueChip(status) {
      const total = Number(status?.total) || 0;
      const state = status?.syncing ? "warning" : total > 0 ? "warning" : "idle";
      setChip(chipOfflineQueueState, status?.syncing ? `Syncing ${total}` : `Offline Queue: ${total}`, state);
    }

    function extractToken(decodedText) {
      if (window.QRTokenParser && typeof window.QRTokenParser.extract === "function") {
        return window.QRTokenParser.extract(decodedText, window.location.href);
      }
      return String(decodedText || "").trim();
    }

    function captureSnapshotDataUrl() {
      const video = document.querySelector("#autoQrReader video");
      if (!video || !video.videoWidth || !video.videoHeight) return "";

      // Downscale snapshots to keep API payload small and reliable on mobile data.
      const maxEdge = 960;
      const sourceWidth = video.videoWidth;
      const sourceHeight = video.videoHeight;
      const scale = Math.min(1, maxEdge / Math.max(sourceWidth, sourceHeight));

      const canvas = document.createElement("canvas");
      canvas.width = Math.max(1, Math.round(sourceWidth * scale));
      canvas.height = Math.max(1, Math.round(sourceHeight * scale));
      const ctx = canvas.getContext("2d", { willReadFrequently: false });
      if (!ctx) return "";
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL("image/jpeg", 0.72);
    }

    async function postJson(url, payload) {
      const response = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify(payload)
      });

      const contentType = response.headers.get("content-type") || "";
      let data = { ok: false, message: "Invalid server response." };

      if (contentType.includes("application/json")) {
        try {
          data = await response.json();
        } catch (_jsonError) {
          data = { ok: false, message: "Invalid server response." };
        }
      } else {
        const responseText = await response.text();
        const redirectedToLogin = response.redirected && /\/login(?:[/?#]|$)/i.test(response.url || "");
        if (response.status === 401 || redirectedToLogin) {
          data = { ok: false, message: "Session expired. Please log in again on this device." };
        } else if (!responseText.trim()) {
          data = { ok: false, message: `Empty server response (${response.status}).` };
        } else {
          data = { ok: false, message: `Server returned an unexpected response (${response.status}).` };
        }
      }

      if (!response.ok || !contentType.includes("application/json")) {
        throw new Error(data.message || `Request failed (${response.status})`);
      }

      return data;
    }

    function groupSlotsByZone(slots) {
      return (slots || []).reduce((acc, slot) => {
        const zone = slot.zone || "General";
        if (!acc[zone]) acc[zone] = [];
        acc[zone].push(slot);
        return acc;
      }, {});
    }

    function renderSlotMap() {
      const slots = Array.isArray(pendingSlotOverview?.slots) ? pendingSlotOverview.slots : [];
      const summary = pendingSlotOverview?.summary || { total: 0, available: 0, occupied: 0, disabled: 0 };

      if (!slots.length) {
        autoSlotMap.innerHTML = window.NaapUiState.render("empty", {
          title: "No available slots",
          message: "No parking slots are available for this entry.",
          compact: true
        });
        autoSlotStatus.textContent = "No slots configured";
        confirmEntryBtn.disabled = true;
        return;
      }

      const grouped = groupSlotsByZone(slots);
      autoSlotStatus.textContent = `${summary.available || 0} available of ${summary.total || slots.length}`;

      autoSlotMap.innerHTML = `
        <div class="auto-slot-summary">
          <span>Available: <strong>${summary.available || 0}</strong></span>
          <span>Occupied: <strong>${summary.occupied || 0}</strong></span>
          <span>Disabled: <strong>${summary.disabled || 0}</strong></span>
        </div>
        ${Object.keys(grouped).map((zone) => `
          <div class="auto-zone-block">
            <p class="auto-zone-title">${escapeHtml(zone)}</p>
            <div class="auto-zone-grid">
              ${grouped[zone].map((slot) => {
                const selected = String(selectedSlotId || "") === String(slot.id);
                const occupancy = slot.occupancy || "available";
                const selectable = occupancy === "available";
                const occupant = slot.occupied_by_name
                  ? `<small>${escapeHtml(slot.occupied_by_name)}</small>`
                  : "<small></small>";
                return `
                  <button
                    type="button"
                    class="auto-slot-btn ${occupancy} ${selected ? "selected" : ""}"
                    data-slot-id="${escapeHtml(slot.id)}"
                    data-slot-code="${escapeHtml(slot.slot_code)}"
                    ${selectable ? "" : "disabled"}>
                    <span>${escapeHtml(slot.slot_code)}</span>
                    ${occupant}
                  </button>
                `;
              }).join("")}
            </div>
          </div>
        `).join("")}
      `;

      autoSlotMap.querySelectorAll(".auto-slot-btn.available").forEach((button) => {
        button.addEventListener("click", () => {
          selectedSlotId = button.dataset.slotId;
          renderSlotMap();
          confirmEntryBtn.disabled = false;
          confirmEntryBtn.textContent = `Confirm Entry · ${button.dataset.slotCode}`;
          entryConfirmHint.textContent = `${button.dataset.slotCode} selected. Confirm to admit the vehicle.`;
        });
      });
    }

    function renderEntryDetails(sticker) {
      const safe = sticker || {};
      entryStickerDetails.innerHTML = `
        <div><span>Authorized</span><strong>Yes</strong></div>
        <div><span>Student</span><strong>${escapeHtml(safe.full_name || "-")}</strong></div>
        <div><span>Student ID</span><strong>${escapeHtml(safe.student_number || "-")}</strong></div>
        <div><span>Plate Number</span><strong>${escapeHtml(safe.plate_number || "-")}</strong></div>
        <div><span>Vehicle Type</span><strong>${escapeHtml(safe.vehicle_type || safe.vehicle_model || "-")}</strong></div>
      `;
    }

    function hideEntryPanel() {
      pendingToken = null;
      pendingSticker = null;
      pendingSlotOverview = null;
      selectedSlotId = null;
      confirmEntryBtn.disabled = true;
      confirmEntryBtn.textContent = "Confirm Entry";
      cancelEntryBtn.disabled = false;
      entryConfirmHint.textContent = "";
      entryStickerDetails.innerHTML = "";
      autoSlotMap.innerHTML = "";
      entryConfirmPanel.style.display = "none";
    }

    function setLocalCooldown(token, milliseconds) {
      if (!token) return;
      const until = Date.now() + Math.max(0, milliseconds);
      localCooldownUntilMs.set(token, until);
      updateCooldownChip();
    }

    function getLocalCooldownRemainingMs(token) {
      if (!token) return 0;
      const until = localCooldownUntilMs.get(token) || 0;
      const remaining = until - Date.now();
      return remaining > 0 ? remaining : 0;
    }

    function resetStability() {
      stableCandidateToken = "";
      stableCandidateHits = 0;
      stableCandidateFirstSeenMs = 0;
      updateStabilityChip();
    }

    async function pauseScanner() {
      if (!html5QrCode || !cameraStarted) return;
      try {
        await html5QrCode.pause();
      } catch (_error) {
        // ignore pause race conditions
      }
    }

    function getScannerState() {
      if (!html5QrCode || typeof html5QrCode.getState !== "function") return QR_STATE.UNKNOWN;
      try {
        return html5QrCode.getState();
      } catch (_error) {
        return QR_STATE.UNKNOWN;
      }
    }

    async function hardRestartScanner() {
      if (html5QrCode) {
        try {
          await html5QrCode.stop();
        } catch (_stopError) {
          // ignore stop race conditions
        }
        try {
          await html5QrCode.clear();
        } catch (_clearError) {
          // ignore clear race conditions
        }
      }

      html5QrCode = null;
      cameraStarted = false;
      toggleCameraBtn.textContent = "Stop Camera";
      resetStability();
      setCameraStatus("Reinitializing camera...", "ok");
      setChip(chipCameraState, "Reinitializing", "warning");
      setChip(chipAutoState, "Recovering Scanner", "warning");
      setChip(chipMlState, "Smart Assist: Restarting", "warning");

      await startCamera();
    }

    async function resumeScanner(delayMs = 0) {
      const waitMs = Math.max(0, Number(delayMs) || 0);
      if (waitMs) {
        await new Promise((resolve) => window.setTimeout(resolve, waitMs));
      }

      if (!html5QrCode || !cameraStarted) {
        await startCamera();
        return;
      }

      const state = getScannerState();

      try {
        if (state === QR_STATE.SCANNING) {
          setCameraStatus("Scanner active", "ok");
          setChip(chipAutoState, "Ready to Scan", "live");
          setChip(chipCameraState, "Camera Ready", "live");
          resetStability();
          resetScanCycle();
          return;
        }

        if (state === QR_STATE.PAUSED) {
          await html5QrCode.resume();
          setCameraStatus("Scanner active", "ok");
          setChip(chipAutoState, "Ready to Scan", "live");
          setChip(chipCameraState, "Camera Ready", "live");
          resetStability();
          resetScanCycle();
          return;
        }

        await hardRestartScanner();
      } catch (_error) {
        setCameraStatus("Scanner resume failed. Reinitializing...", "error");
        await hardRestartScanner();
      }
    }

    async function fetchLatestSlotOverview() {
      const resp = await fetch("/api/parking-slot-overview");
      const data = await resp.json();
      if (!data.ok) {
        throw new Error(data.message || "Failed to load parking slots.");
      }
      return {
        slots: Array.isArray(data.slots) ? data.slots : [],
        summary: data.summary || { total: 0, available: 0, occupied: 0, disabled: 0 }
      };
    }

    async function processStableToken(token, decodedText, decodeMeta = null) {
      processingScan = true;
      setProcessingOverlay(true);
      setChip(chipAutoState, "Processing", "warning");
      await pauseScanner();
      lastRiskAssessment = classifyQrBehavior(decodedText || token);
      setRiskChip(lastRiskAssessment);
      if (lastRiskAssessment?.riskLevel === "high") {
        pushSessionEvent(
          "RISK",
          "warning",
          "High-risk QR content flagged",
          (lastRiskAssessment.reasons && lastRiskAssessment.reasons[0]) || "Suspicious payload pattern detected."
        );
      } else if (lastRiskAssessment?.riskLevel === "medium") {
        pushSessionEvent(
          "RISK",
          "warning",
          "Medium-risk QR content",
          (lastRiskAssessment.reasons && lastRiskAssessment.reasons[0]) || "Potentially unusual payload detected."
        );
      }
      if (decodeMeta) {
        updateMlChip({
          confidence: decodeMeta.ml_confidence ?? decodeMeta.confidence,
          processMs: decodeMeta.process_ms,
          model: decodeMeta.model || null,
          readinessScore: decodeMeta.readiness_score,
          readinessGuidance: decodeMeta.readiness_guidance,
          learningSamples: decodeMeta.learning_samples,
          learningTrained: decodeMeta.learning_trained
        });
      }
      setResultState("processing", "Processing QR scan", "Verifying sticker and determining movement...");

      try {
        const payload = {
          token,
          gate: gateSelect.value,
          device_id: scannerDeviceId,
          defer_entry_confirmation: deferEntryConfirmation,
          snapshot_data_url: captureSnapshotDataUrl(),
          behavior_risk_level: lastRiskAssessment?.riskLevel || null,
          behavior_risk_score: Number(lastRiskAssessment?.riskScore || 0),
          behavior_risk_reasons: Array.isArray(lastRiskAssessment?.reasons)
            ? lastRiskAssessment.reasons.slice(0, 3)
            : [],
          detection_confidence: Number(decodeMeta?.ml_confidence || decodeMeta?.confidence || 0),
          detection_model: decodeMeta?.model || (enhancedScannerAvailable ? "MLQrCodeScanner" : "html5-qrcode")
        };

        const data = await postJson("/api/auto-scan/detect", payload);
        lastRiskAssessment = normalizeRiskAssessment(data.behavior_risk, lastRiskAssessment);
        setRiskChip(lastRiskAssessment);
        await reportScannerMetric(
          data.duplicate_scan ? "DUPLICATE" : data.ok ? "SUCCESS" : "INVALID",
          {
            action: data.action || "VERIFY",
            reason: data.duplicate_scan ? "Duplicate cooldown" : data.ok ? null : (data.message || data.result || "Invalid QR")
          }
        );

        if (data.duplicate_scan) {
          hideEntryPanel();
          const waitSeconds = Math.max(1, cooldownSeconds - Number(data.seconds_since_last_scan || 0));
          setLocalCooldown(token, waitSeconds * 1000);
          setResultState(
            "warning",
            "Duplicate scan ignored",
            data.message || `Please wait ${waitSeconds} seconds before scanning this sticker again.`,
            `${renderMlMeta(decodeMeta)}${renderRiskMeta(lastRiskAssessment)}`
          );
          pushSessionEvent("DUPLICATE", "warning", "Duplicate blocked", `Cooldown active (${waitSeconds}s)`);
          showScanInfoPopup({
            tone: "warning",
            kicker: "Duplicate",
            title: "Duplicate scan ignored",
            message: data.message || `Please wait ${waitSeconds} seconds before scanning again.`,
            metaHtml: `
              ${popupMetaRow("Student", data.sticker?.full_name || "-")}
              ${popupMetaRow("Plate", data.sticker?.plate_number || "-")}
              ${popupMetaRow("Cooldown", `${waitSeconds}s`)}
              ${popupMetaRow("Gate", gateSelect.value)}
            `,
            autoHideMs: 3200
          });
          playTone("warn");
          await resumeScanner(900);
          return;
        }

        if (!data.ok) {
          hideEntryPanel();
          setLocalCooldown(token, LOCAL_DEDUP_FLOOR_MS);
          const statusLabel = (data.result || "INVALID").toUpperCase();
          setResultState(
            "invalid",
            `Unauthorized (${statusLabel})`,
            data.message || "QR sticker is not valid.",
            `${data.sticker ? resultMetaRow("Student", data.sticker.full_name || "-") : ""}${renderMlMeta(decodeMeta)}${renderRiskMeta(lastRiskAssessment)}`
          );
          pushSessionEvent("VERIFY", "error", `Scan rejected (${statusLabel})`, data.message || "Unauthorized sticker");
          showScanInfoPopup({
            tone: "error",
            kicker: "Unauthorized",
            title: `Scan rejected (${statusLabel})`,
            message: data.message || "QR sticker is not valid.",
            metaHtml: `
              ${popupMetaRow("Student", data.sticker?.full_name || "-")}
              ${popupMetaRow("Plate", data.sticker?.plate_number || "-")}
              ${popupMetaRow("Gate", gateSelect.value)}
            `,
            autoHideMs: 4200
          });
          playTone("warn");
          await resumeScanner(1100);
          return;
        }

        if (data.action === "EXIT" && data.movement_saved) {
          hideEntryPanel();
          setLocalCooldown(token, cooldownSeconds * 1000);
          setResultState(
            "success",
            "EXIT recorded",
            data.message || "Vehicle exit logged successfully.",
            `
              ${resultMetaRow("Student", data.sticker?.full_name || "-")}
              ${resultMetaRow("Plate", data.sticker?.plate_number || "-")}
              ${resultMetaRow("Released Slot", data.released_slot || "N/A")}
              ${renderMlMeta(decodeMeta)}
              ${renderRiskMeta(lastRiskAssessment)}
            `
          );
          pushSessionEvent("EXIT", "ok", "Exit saved", `${data.sticker?.plate_number || "Unknown plate"} at ${gateSelect.value}`);
          showScanInfoPopup({
            tone: "success",
            kicker: "Exit recorded",
            title: "Vehicle exit saved",
            message: data.message || "Vehicle exit logged successfully.",
            metaHtml: `
              ${popupMetaRow("Student", data.sticker?.full_name || "-")}
              ${popupMetaRow("Plate", data.sticker?.plate_number || "-")}
              ${popupMetaRow("Released Slot", data.released_slot || "N/A")}
              ${popupMetaRow("Gate", gateSelect.value)}
            `
          });
          playTone("ok");
          await resumeScanner(1200);
          return;
        }

        if (data.action === "ENTRY" && data.queued_for_guard) {
          hideEntryPanel();
          setLocalCooldown(token, cooldownSeconds * 1000);
          setResultState(
            "success",
            "ENTRY sent to laptop monitor",
            data.message || "Waiting for guard slot assignment on monitor console.",
            `
              ${resultMetaRow("Student", data.sticker?.full_name || "-")}
              ${resultMetaRow("Plate", data.sticker?.plate_number || "-")}
              ${resultMetaRow("Gate", gateSelect.value)}
              ${resultMetaRow("Queue ID", data.pending_entry_id || "-")}
              ${renderMlMeta(decodeMeta)}
              ${renderRiskMeta(lastRiskAssessment)}
            `
          );
          setChip(chipAutoState, "Queued for Guard", "warning");
          pushSessionEvent(
            "ENTRY",
            "ok",
            "Entry queued for laptop guard",
            `${data.sticker?.plate_number || "Unknown plate"} at ${gateSelect.value}`
          );
          showScanInfoPopup({
            tone: "success",
            kicker: "Entry queued",
            title: "Vehicle detected",
            message: data.message || "Waiting for laptop guard slot assignment.",
            metaHtml: `
              ${popupMetaRow("Student", data.sticker?.full_name || "-")}
              ${popupMetaRow("Plate", data.sticker?.plate_number || "-")}
              ${popupMetaRow("Queue ID", data.pending_entry_id || "-")}
              ${popupMetaRow("Gate", gateSelect.value)}
            `
          });
          playTone("ok");
          await resumeScanner(850);
          return;
        }

        if (data.action === "ENTRY" && data.requires_confirmation) {
          pendingToken = token;
          pendingSticker = data.sticker || null;
          pendingSlotOverview = data.parkingSlotOverview || { slots: [], summary: { total: 0, available: 0, occupied: 0, disabled: 0 } };
          selectedSlotId = null;
          confirmEntryBtn.disabled = true;

          renderEntryDetails(pendingSticker);
          renderSlotMap();
          entryConfirmPanel.style.display = "block";

          setResultState(
            "entry",
            "ENTRY detected - guard confirmation required",
            data.message || "Select a parking slot and confirm to save ENTRY.",
            `
              ${resultMetaRow("Student", pendingSticker?.full_name || "-")}
              ${resultMetaRow("Plate", pendingSticker?.plate_number || "-")}
              ${resultMetaRow("Vehicle Type", pendingSticker?.vehicle_type || pendingSticker?.vehicle_model || "-")}
              ${renderMlMeta(decodeMeta)}
              ${renderRiskMeta(lastRiskAssessment)}
            `
          );
          setChip(chipAutoState, "Awaiting Guard", "warning");
          pushSessionEvent("ENTRY", "warning", "Entry pending confirmation", `${pendingSticker?.plate_number || "Unknown plate"} waiting for slot assignment`);
          closeScanInfoPopup();
          window.setTimeout(() => {
            entryConfirmPanel.scrollIntoView({ behavior: "smooth", block: "start" });
          }, 120);
          playTone("ok");
          return;
        }

        hideEntryPanel();
        setResultState("warning", "Scan completed", data.message || "No action was recorded.", `${renderMlMeta(decodeMeta)}${renderRiskMeta(lastRiskAssessment)}`);
        pushSessionEvent("VERIFY", "warning", "No movement saved", data.message || "Review scanner result");
        showScanInfoPopup({
          tone: "warning",
          kicker: "Review",
          title: "Scan completed",
          message: data.message || "No action was recorded for this QR.",
          metaHtml: `${popupMetaRow("Gate", gateSelect.value)}`,
          autoHideMs: 3200
        });
        await resumeScanner(900);
      } catch (error) {
        if (!navigator.onLine && window.OfflineManager) {
          try {
            const offlineVerification = await window.OfflineManager.verifyOfflineToken(token);
            if (offlineVerification?.ok) {
              const offlineAction = offlineVerification.sticker?.last_action === "ENTRY" ? "EXIT" : "ENTRY";
              await window.OfflineManager.queueMovement(token, offlineAction, gateSelect.value, Date.now());
              hideEntryPanel();
              setResultState("warning", `${offlineAction} queued offline`, "The record will synchronize automatically when internet access returns.");
              setChip(chipAutoState, "Saved Offline", "warning");
              pushSessionEvent(offlineAction, "warning", `${offlineAction} queued offline`, offlineVerification.sticker?.plate_number || gateSelect.value);
              showScanInfoPopup({
                tone: "warning",
                kicker: "Saved offline",
                title: `${offlineAction} queued`,
                message: "Safe to continue scanning. This record will sync automatically.",
                metaHtml: `${popupMetaRow("Plate", offlineVerification.sticker?.plate_number || "-")}${popupMetaRow("Gate", gateSelect.value)}`,
                autoHideMs: 4200
              });
              playTone("ok");
              await reportScannerMetric("OFFLINE_QUEUED", { action: offlineAction, reason: "Network unavailable" });
              resetScanCycle();
              await resumeScanner(900);
              return;
            }
          } catch (_offlineError) {
            // Fall through to the normal error state.
          }
        }
        hideEntryPanel();
        setResultState("error", "Scan failed", error.message || "Unable to process this scan right now.", `${renderMlMeta(decodeMeta)}${renderRiskMeta(lastRiskAssessment)}`);
        setCameraStatus(error.message || "Scan failed", "error");
        pushSessionEvent("ERROR", "error", "Scan processing error", error.message || "Unknown scanner error");
        showScanInfoPopup({
          tone: "error",
          kicker: "Scan error",
          title: "Unable to process QR",
          message: error.message || "Unable to process this scan right now.",
          metaHtml: `${popupMetaRow("Gate", gateSelect.value)}`,
          autoHideMs: 4200
        });
        playTone("warn");
        await reportScannerMetric("ERROR", { reason: error.message || "Scan processing failed" });
        await resumeScanner(1200);
      } finally {
        processingScan = false;
        setProcessingOverlay(false);
      }
    }

    async function handleDecodedText(decodedText, decodeMeta = null) {
      if (!cameraStarted || processingScan) return;
      if (entryConfirmPanel.style.display !== "none") return;

      scannerGuidance.detected();

      if (decodeMeta) {
        updateMlChip({
          confidence: decodeMeta.ml_confidence ?? decodeMeta.confidence,
          processMs: decodeMeta.process_ms,
          model: decodeMeta.model || null,
          readinessScore: decodeMeta.readiness_score,
          readinessGuidance: decodeMeta.readiness_guidance,
          learningSamples: decodeMeta.learning_samples,
          learningTrained: decodeMeta.learning_trained
        });
      }

      const token = extractToken(decodedText);
      if (!token) return;

      const remainingCooldown = getLocalCooldownRemainingMs(token);
      if (remainingCooldown > 0) {
        const seconds = Math.max(1, Math.ceil(remainingCooldown / 1000));
        setChip(chipCooldownState, `Next scan in ${seconds}s`, "warning");
        return;
      }

      const now = Date.now();
      if (token !== stableCandidateToken || now - stableCandidateFirstSeenMs > STABLE_READ_WINDOW_MS) {
        stableCandidateToken = token;
        stableCandidateHits = 1;
        stableCandidateFirstSeenMs = now;
        updateStabilityChip();
        setCameraStatus("Detecting stable QR read...", "ok");
        return;
      }

      stableCandidateHits += 1;
      updateStabilityChip();

      if (stableCandidateHits < STABLE_READ_MIN_HITS) {
        return;
      }

      resetStability();
      setLocalCooldown(token, LOCAL_DEDUP_FLOOR_MS);
      await processStableToken(token, decodedText, decodeMeta);
    }

    async function startCamera() {
      if (!html5QrCode) {
        if (enhancedScannerAvailable) {
          html5QrCode = new window.MLQrCodeScanner("autoQrReader", {
            targetFps: 24,
            confidenceThreshold: 0.35,
            maxProcessWidth: 720,
            perspectiveSize: 320,
            lowConfidenceDecodeRatio: 0.58,
            duplicateSuppressMs: 220,
            onMlMetrics: (metrics) => {
              scannerGuidance.update(metrics);
              lastGuidanceKey = String(metrics?.readinessGuidance || lastGuidanceKey || "center");
              updateMlChip({
                ...metrics,
                model: metrics?.usedDetector ? "BarcodeDetector+jsQR" : "jsQR-fallback"
              });
            }
          });
          setChip(chipMlState, "Smart Assist: Active", "live");
        } else {
          html5QrCode = new Html5Qrcode("autoQrReader");
          setChip(chipMlState, "Smart Assist: Unavailable", "warning");
        }
      }

      const config = {
        fps: 24,
        aspectRatio: 1.333333,
        disableFlip: false
      };

      const onFailure = () => {
        unreadableFrameCount += 1;
        scannerGuidance.unreadableFrame();
      };

      setCameraStatus("Requesting camera permission...");
      setChip(chipCameraState, "Opening Camera", "warning");

      try {
        await html5QrCode.start(
          { facingMode: "environment" },
          config,
          handleDecodedText,
          onFailure
        );
        cameraStarted = true;
        resetScanCycle();
        scannerGuidance.start();
        toggleCameraBtn.textContent = "Stop Camera";
        setCameraStatus("Rear camera active", "ok");
        setChip(chipAutoState, "Ready to Scan", "live");
        setChip(chipCameraState, "Camera Ready", "live");
        if (!enhancedScannerAvailable) {
          setChip(chipMlState, "Smart Assist: Unavailable", "warning");
        }
        setResultState("idle", "Waiting for QR detection", "Point the camera to a student vehicle QR sticker anywhere in view.");
        return;
      } catch (_rearError) {
        // Fallback below.
      }

      try {
        const getCamerasFn = typeof html5QrCode.constructor.getCameras === "function"
          ? html5QrCode.constructor.getCameras.bind(html5QrCode.constructor)
          : (typeof Html5Qrcode !== "undefined" && typeof Html5Qrcode.getCameras === "function"
            ? Html5Qrcode.getCameras.bind(Html5Qrcode)
            : null);

        const devices = getCamerasFn ? await getCamerasFn() : [];
        if (!devices || devices.length === 0) {
          throw new Error("No camera found on this device.");
        }
        const rear = devices.find((d) => /back|rear|environment/i.test(d.label)) || devices[0];
        await html5QrCode.start(rear.id, config, handleDecodedText, onFailure);
        cameraStarted = true;
        resetScanCycle();
        scannerGuidance.start();
        toggleCameraBtn.textContent = "Stop Camera";
        setCameraStatus("Camera active", "ok");
        setChip(chipAutoState, "Ready to Scan", "live");
        setChip(chipCameraState, "Camera Ready", "live");
        if (!enhancedScannerAvailable) {
          setChip(chipMlState, "Smart Assist: Unavailable", "warning");
        }
        setResultState("idle", "Waiting for QR detection", "Point the camera to a student vehicle QR sticker anywhere in view.");
      } catch (error) {
        cameraStarted = false;
        scannerGuidance.stop();
        toggleCameraBtn.textContent = "Start Camera";
        const message = String(error && error.message ? error.message : error);
        const prettyMessage = /permission|denied/i.test(message)
          ? "Camera permission denied. Allow camera access and retry."
          : message;
        setCameraStatus(prettyMessage, "error");
        setChip(chipCameraState, "Camera Error", "error");
        setChip(chipAutoState, "Scanner Stopped", "idle");
        setChip(chipMlState, "Smart Assist: Offline", "error");
        setResultState("error", "Camera unavailable", prettyMessage);
        pushSessionEvent("ERROR", "error", "Camera unavailable", prettyMessage);
        await reportScannerMetric("CAMERA_ERROR", { reason: prettyMessage });
      }
    }

    async function stopCamera() {
      if (!html5QrCode && !cameraStarted) return;

      if (html5QrCode) {
        try {
          await html5QrCode.stop();
        } catch (_stopError) {
          // ignore stop race conditions
        }

        try {
          await html5QrCode.clear();
        } catch (_clearError) {
          // ignore clear race conditions
        }
      }

      html5QrCode = null;
      cameraStarted = false;
      scannerGuidance.stop();
      toggleCameraBtn.textContent = "Start Camera";
      setCameraStatus("Camera stopped");
      setChip(chipCameraState, "Camera Stopped", "idle");
      setChip(chipAutoState, "Scanner Stopped", "idle");
      setChip(chipMlState, "Smart Assist: Waiting", "idle");
      setChip(chipRiskState, "QR Safety: Waiting", "idle");
      resetStability();
      setProcessingOverlay(false);
    }

    toggleCameraBtn.addEventListener("click", async () => {
      if (cameraStarted) {
        await stopCamera();
      } else {
        await startCamera();
      }
    });

    resumeScannerBtn.addEventListener("click", async () => {
      hideEntryPanel();
      setResultState("idle", "Scanner resumed", "Waiting for the next QR scan.");
      pushSessionEvent("SYSTEM", "ok", "Scanner resumed", `Gate: ${gateSelect.value}`);
      if (!cameraStarted) {
        await startCamera();
      } else {
        await resumeScanner(0);
      }
    });

    cancelEntryBtn.addEventListener("click", async () => {
      const plate = pendingSticker?.plate_number || "Unknown plate";
      hideEntryPanel();
      setResultState("idle", "Entry confirmation cancelled", "Waiting for the next QR scan.");
      setChip(chipAutoState, "Ready to Scan", "live");
      pushSessionEvent("ENTRY", "warning", "Entry cancelled", `${plate} was not recorded`);
      await reportScannerMetric("CANCELLED", { action: "ENTRY", reason: "Guard cancelled slot assignment" });
      await resumeScanner(500);
    });

    recalibrateScannerBtn?.addEventListener("click", async () => {
      recalibrateScannerBtn.disabled = true;
      setCameraStatus("Recalibrating focus and exposure...", "ok");
      const recalibrated = typeof html5QrCode?.recalibrate === "function"
        ? await html5QrCode.recalibrate()
        : false;
      setCameraStatus(
        recalibrated ? "Camera recalibrated. Hold a QR steady." : "Automatic calibration is not supported by this camera.",
        recalibrated ? "ok" : "neutral"
      );
      scannerGuidance.start();
      resetStability();
      resetScanCycle();
      recalibrateScannerBtn.disabled = false;
    });

    resetSmartAssistBtn?.addEventListener("click", () => {
      if (!confirm("Reset the locally learned scanner conditions on this device?")) return;
      const status = typeof html5QrCode?.resetReadinessModel === "function"
        ? html5QrCode.resetReadinessModel()
        : null;
      updateMlChip({
        confidence: 0,
        readinessScore: 0,
        learningSamples: Number(status?.samples || 0),
        model: enhancedScannerAvailable ? "MLQrCodeScanner" : "html5-qrcode"
      });
      setCameraStatus("Smart Assist reset. Scan normally to teach this device again.", "ok");
      pushSessionEvent("SYSTEM", "ok", "Smart Assist reset", "Local learning restarted at 0/12 samples");
    });

    runDeviceCheckBtn?.addEventListener("click", () => {
      if (!window.ScannerDeviceCheck?.inspect || !scannerDeviceCheckResults) return;
      const result = window.ScannerDeviceCheck.inspect("autoQrReader");
      scannerDeviceCheckResults.hidden = false;
      scannerDeviceCheckResults.className = `scanner-device-check-results grade-${result.grade}`;
      scannerDeviceCheckResults.innerHTML = `
        <strong>${result.ready ? "Device is ready for scanning" : "Device needs attention"}</strong>
        <span>${result.deviceClass} · ${result.grade.replace("-", " ")}</span>
        <ul>${result.checks.map((check) => `<li class="${check.passed ? "passed" : "failed"}">${check.passed ? "✓" : "!"} ${check.label}${!check.passed && !check.required ? " (optional)" : ""}</li>`).join("")}</ul>
      `;
    });

    scanInfoPopupClose?.addEventListener("click", closeScanInfoPopup);
    scanInfoPopup?.querySelectorAll("[data-scan-popup-close]").forEach((node) => {
      node.addEventListener("click", closeScanInfoPopup);
    });
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && scanInfoPopup?.classList.contains("open")) {
        closeScanInfoPopup();
      }
    });

    confirmEntryBtn.addEventListener("click", async () => {
      if (!pendingToken) {
        entryConfirmHint.textContent = "No pending entry to confirm.";
        return;
      }
      if (!selectedSlotId) {
        entryConfirmHint.textContent = "Please select a parking slot before confirming ENTRY.";
        return;
      }

      confirmEntryBtn.disabled = true;
      cancelEntryBtn.disabled = true;
      entryConfirmHint.textContent = "Saving entry record...";
      setProcessingOverlay(true);

      try {
        const payload = {
          token: pendingToken,
          gate: gateSelect.value,
          device_id: scannerDeviceId,
          slot_id: selectedSlotId,
          snapshot_data_url: captureSnapshotDataUrl(),
          behavior_risk_level: lastRiskAssessment?.riskLevel || null,
          behavior_risk_score: Number(lastRiskAssessment?.riskScore || 0),
          behavior_risk_reasons: Array.isArray(lastRiskAssessment?.reasons)
            ? lastRiskAssessment.reasons.slice(0, 3)
            : [],
          detection_confidence: Number(latestMlMeta?.confidence || latestMlMeta?.ml_confidence || 0),
          detection_model: latestMlMeta?.model || (enhancedScannerAvailable ? "MLQrCodeScanner" : "html5-qrcode")
        };

        const data = await postJson("/api/auto-scan/confirm-entry", payload);
        if (!data.ok) {
          throw new Error(data.message || "Failed to save entry.");
        }
        lastRiskAssessment = normalizeRiskAssessment(data.behavior_risk, lastRiskAssessment);
        setRiskChip(lastRiskAssessment);

        setLocalCooldown(pendingToken, cooldownSeconds * 1000);

        hideEntryPanel();
        setResultState(
          "success",
          "ENTRY recorded",
          data.message || "Entry logged successfully.",
          `
            ${resultMetaRow("Student", data.sticker?.full_name || "-")}
            ${resultMetaRow("Plate", data.sticker?.plate_number || "-")}
            ${resultMetaRow("Assigned Slot", data.parking_slot || "-")}
            ${resultMetaRow("Assigned Area", data.assigned_area || "-")}
            ${renderRiskMeta(lastRiskAssessment)}
          `
        );
        showScanInfoPopup({
          tone: "success",
          kicker: "Entry recorded",
          title: "Vehicle entry saved",
          message: data.message || "Entry logged successfully.",
          metaHtml: `
            ${popupMetaRow("Student", data.sticker?.full_name || "-")}
            ${popupMetaRow("Plate", data.sticker?.plate_number || "-")}
            ${popupMetaRow("Assigned Slot", data.parking_slot || "-")}
            ${popupMetaRow("Gate", gateSelect.value)}
          `
        });

        setChip(chipAutoState, "Ready to Scan", "live");
        pushSessionEvent("ENTRY", "ok", "Entry saved", `${data.sticker?.plate_number || "Unknown plate"} assigned to ${data.parking_slot || "N/A"}`);
        playTone("ok");
        await resumeScanner(1100);
        if (window.matchMedia("(max-width: 900px)").matches) {
          cameraWrapper?.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      } catch (error) {
        entryConfirmHint.textContent = error.message || "Failed to save entry.";
        confirmEntryBtn.disabled = false;
        cancelEntryBtn.disabled = false;
        pushSessionEvent("ENTRY", "error", "Entry save failed", error.message || "Unknown error");
        showScanInfoPopup({
          tone: "error",
          kicker: "Entry failed",
          title: "Unable to save entry",
          message: error.message || "Failed to save entry.",
          metaHtml: `${popupMetaRow("Gate", gateSelect.value)}`,
          autoHideMs: 4200
        });
        playTone("warn");

        try {
          pendingSlotOverview = await fetchLatestSlotOverview();
          renderSlotMap();
        } catch (_loadError) {
          // keep current map if refresh fails
        }
      } finally {
        setProcessingOverlay(false);
      }
    });

    renderSessionEvents();
    updateStabilityChip();
    updateCooldownChip();
    setRiskChip(null);
    updateMlChip(null);
    window.addEventListener("naap-offline-queue-status", (event) => updateOfflineQueueChip(event.detail));
    if (window.OfflineManager?.getQueueStatus) {
      window.OfflineManager.getQueueStatus().then(updateOfflineQueueChip);
    } else {
      updateOfflineQueueChip({ total: 0 });
    }
    startHeartbeatLoop();
    gateSelect?.addEventListener("change", () => {
      try {
        localStorage.setItem(GATE_STORAGE_KEY, gateSelect.value);
      } catch (_storageError) {
        // Gate selection still works for this session.
      }
      sendHeartbeat();
    });
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) sendHeartbeat();
    });
    startCamera();
  })();
</script>

<%- include("partials/footer") %>
