<%- include("partials/header") %>

<% const pageFlash = typeof flash !== 'undefined' ? flash : null; %>

<section class="dashboard-hero">
  <div class="hero-greeting">
    <h2>Access Control</h2>
    <h1>Vehicle Management</h1>
  </div>
  <div class="hero-cards">
    <div class="hero-card">
      <h3>Registered Vehicles</h3>
      <p><%= vehicles.length %></p>
    </div>
  </div>
  <% if (pageFlash) { %>
    <div class="flash flash-<%= pageFlash.type === 'success' ? 'success' : 'error' %> flash-spaced">
      <%= pageFlash.type === 'success' ? '✅' : '⚠️' %> <%= pageFlash.message %>
    </div>
  <% } %>
</section>

<div class="overlap-wrapper">
  <section class="panel">
    <div class="section-head">
      <h2>Vehicle Registration</h2>
      <p>Bind each vehicle to an authorized student profile.</p>
    </div>
  <form method="post" action="/vehicles" class="form-grid">
    <label for="v_student_id">Student</label>
    <select id="v_student_id" name="student_id" required>
      <option value="">Select student</option>
      <% students.forEach(student => { %>
        <option value="<%= student.id %>"><%= student.student_number %> — <%= student.full_name %></option>
      <% }) %>
    </select>

    <label for="v_plate">Plate Number</label>
    <input id="v_plate" name="plate_number" required placeholder="e.g. ABC 1234" />

    <label for="v_model">Vehicle Model</label>
    <input id="v_model" name="model" placeholder="e.g. Honda Click 125i" />

    <label for="v_color">Color</label>
    <input id="v_color" name="color" placeholder="e.g. Black" />

    <button type="submit">Save Vehicle</button>
  </form>
</section>

  <section class="panel">
    <div class="section-head">
      <h2>Vehicle Registry</h2>
      <p>Manage existing records.</p>
    </div>
  <div class="table-wrap desktop-only-table ops-table-shell">
    <table>
      <thead>
        <tr>
          <th>Student</th>
          <th>Plate Number</th>
          <th>Model</th>
          <th>Color</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (vehicles.length === 0) { %>
          <tr class="table-empty-row">
            <td colspan="5" class="table-empty-cell">
              <div class="empty-state">
                <div class="empty-state-icon">🚗</div>
                <p>No vehicles registered yet. Use the form above to add one.</p>
              </div>
            </td>
          </tr>
        <% } %>
        <% vehicles.forEach(vehicle => { %>
          <tr>
            <td><strong><%= vehicle.student_number %></strong> <span class="record-secondary"><%= vehicle.full_name %></span></td>
            <td><span class="badge badge-plate"><%= vehicle.plate_number %></span></td>
            <td class="table-muted"><%= vehicle.model || "-" %></td>
            <td class="table-muted"><%= vehicle.color || "-" %></td>
            <td class="table-actions-cell">
              <form id="deleteVehicleDesktop_<%= vehicle.id %>" method="post" action="/vehicles/<%= vehicle.id %>/delete" class="inline-form inline-form-end" hidden></form>
              <button type="button" class="danger btn-sm" data-destructive-trigger data-form-id="deleteVehicleDesktop_<%= vehicle.id %>" data-confirm-title="Delete vehicle?" data-confirm-message="Delete vehicle <%= vehicle.plate_number %>? This cannot be undone." data-confirm-label="Delete vehicle">Delete</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Mobile-Ready Cards -->
  <div class="mobile-data-list">
    <% if (vehicles.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">🚗</div>
        <p>No vehicles registered yet.</p>
      </div>
    <% } %>
    <% vehicles.forEach(vehicle => { %>
      <div class="mobile-data-card">
        <div class="card-header">
          <div class="card-title"><%= vehicle.plate_number %></div>
          <span class="badge badge-soft"><%= vehicle.color || "No Color" %></span>
        </div>
        <div class="card-body">
          <div class="card-item">👤 <strong>Owner:</strong> <%= vehicle.full_name %> (<%= vehicle.student_number %>)</div>
          <div class="card-item">🚘 <strong>Model:</strong> <%= vehicle.model || "-" %></div>
        </div>
        <div class="card-actions">
          <form id="deleteVehicleMobile_<%= vehicle.id %>" class="inline-form" method="post" action="/vehicles/<%= vehicle.id %>/delete" hidden></form>
          <button type="button" class="danger btn-mobile-touch" data-destructive-trigger data-form-id="deleteVehicleMobile_<%= vehicle.id %>" data-confirm-title="Delete vehicle?" data-confirm-message="Delete vehicle <%= vehicle.plate_number %>? This cannot be undone." data-confirm-label="Delete vehicle">Delete Vehicle</button>
        </div>
      </div>
    <% }) %>
  </div>
  </section>
</div>

<%- include("partials/footer") %>
