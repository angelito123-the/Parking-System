<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#102a46" />
  <meta name="application-name" content="NAAP Parking" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>NAAP Parking - Staff Sign In</title>
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy-950: #081c31;
      --navy-900: #102a46;
      --navy-800: #123a66;
      --blue-600: #2563eb;
      --blue-500: #3b82f6;
      --surface: #ffffff;
      --line: #d8e2ee;
      --line-strong: #c2d0e0;
      --text: #142236;
      --muted: #65778f;
      --danger: #a11b3c;
      --danger-bg: #fff1f3;
      --success: #22c55e;
    }

    html { min-height: 100%; }

    body {
      min-height: 100vh;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      place-items: stretch;
      overflow-x: hidden;
      padding: 0;
      color: var(--text);
      font-family: "Manrope", sans-serif;
      background:
        radial-gradient(900px 560px at 8% 2%, rgba(37, 99, 235, 0.17), transparent 65%),
        radial-gradient(780px 520px at 96% 94%, rgba(14, 165, 233, 0.12), transparent 68%),
        linear-gradient(145deg, #f4f8fc 0%, #eaf1f8 52%, #f5f8fc 100%);
      isolation: isolate;
    }

    .ambient-grid,
    .ambient-orb {
      position: fixed;
      z-index: -1;
      pointer-events: none;
    }

    .ambient-grid {
      inset: 0;
      opacity: 0.36;
      background-image:
        linear-gradient(rgba(71, 103, 137, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(71, 103, 137, 0.07) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(to bottom, transparent, #000 24%, #000 76%, transparent);
    }

    .ambient-orb {
      width: 340px;
      height: 340px;
      right: -140px;
      top: 12%;
      border: 72px solid rgba(59, 130, 246, 0.07);
      border-radius: 50%;
      animation: orbFloat 10s ease-in-out infinite alternate;
    }

    .login-shell {
      width: 100%;
      max-width: none;
      min-width: 0;
      min-height: 100vh;
      min-height: 100dvh;
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      overflow: hidden;
      border: 0;
      border-radius: 0;
      background: var(--surface);
      box-shadow: none;
      transform-origin: center;
      animation: shellEnter 620ms cubic-bezier(0.2, 0.76, 0.22, 1) both;
      transition: transform 180ms ease, opacity 180ms ease, filter 180ms ease;
    }

    .login-shell.is-submitting {
      transform: translateY(-2px) scale(0.997);
      opacity: 0.97;
      filter: saturate(0.94);
    }

    .brand-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(2.5rem, 6vh, 4.5rem);
      overflow: hidden;
      padding-block: clamp(2.5rem, 6vw, 7rem);
      padding-inline: max(clamp(2.5rem, 5vw, 6rem), calc((100% - 520px) / 2));
      color: #fff;
      background:
        radial-gradient(circle at 105% 10%, rgba(96, 165, 250, 0.34), transparent 35%),
        linear-gradient(150deg, var(--navy-950) 0%, var(--navy-800) 65%, #15549a 100%);
    }

    .brand-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0.15;
      background: repeating-linear-gradient(
        115deg,
        transparent 0 64px,
        rgba(255, 255, 255, 0.42) 64px 66px,
        transparent 66px 130px
      );
      background-size: 300% 100%;
      animation: laneDrift 18s linear infinite;
    }

    .brand-panel::after {
      content: "P";
      position: absolute;
      right: -48px;
      bottom: -88px;
      display: grid;
      place-items: center;
      width: 260px;
      height: 260px;
      border: 48px solid rgba(255, 255, 255, 0.065);
      border-radius: 50%;
      color: rgba(255, 255, 255, 0.08);
      font-family: "Outfit", sans-serif;
      font-size: 6.8rem;
      font-weight: 700;
      line-height: 1;
      animation: markRotate 24s linear infinite;
    }

    .brand-top,
    .brand-message,
    .portal-status {
      position: relative;
      z-index: 1;
    }

    .brand-top {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      animation: contentEnter 500ms 160ms ease-out both;
    }

    .brand-logo {
      width: 52px;
      height: 52px;
      flex: 0 0 auto;
      border-radius: 15px;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.22);
      animation: logoSettle 700ms 220ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .brand-name {
      font-family: "Outfit", sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: 0.01em;
    }

    .brand-system {
      margin-top: 0.25rem;
      color: rgba(219, 234, 254, 0.76);
      font-size: 0.77rem;
      font-weight: 500;
    }

    .brand-message {
      width: 100%;
      max-width: 520px;
      margin: 0;
    }

    .brand-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      margin-bottom: 1rem;
      color: #bfdbfe;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      animation: contentEnter 500ms 230ms ease-out both;
    }

    .brand-kicker::before {
      content: "";
      width: 22px;
      height: 2px;
      border-radius: 999px;
      background: #60a5fa;
    }

    .brand-title {
      font-family: "Outfit", sans-serif;
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 600;
      line-height: 1.08;
      letter-spacing: -0.025em;
      text-wrap: balance;
      animation: contentEnter 540ms 290ms ease-out both;
    }

    .brand-copy {
      max-width: 32rem;
      margin-top: 1rem;
      color: rgba(219, 234, 254, 0.78);
      font-size: 0.9rem;
      line-height: 1.65;
      animation: contentEnter 540ms 350ms ease-out both;
    }

    .brand-features {
      display: grid;
      gap: 0.55rem;
      margin-top: 1.35rem;
      color: rgba(239, 246, 255, 0.88);
      font-size: 0.76rem;
      font-weight: 650;
      list-style: none;
      animation: contentEnter 540ms 390ms ease-out both;
    }

    .brand-features li {
      display: flex;
      align-items: center;
      gap: 0.62rem;
    }

    .feature-check {
      width: 20px;
      height: 20px;
      display: inline-grid;
      place-items: center;
      flex: 0 0 auto;
      border: 1px solid rgba(147, 197, 253, 0.24);
      border-radius: 6px;
      color: #93c5fd;
      background: rgba(59, 130, 246, 0.12);
      font-size: 0.68rem;
      line-height: 1;
    }

    .portal-status {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      gap: 0.55rem;
      padding: 0.55rem 0.75rem;
      border: 1px solid rgba(191, 219, 254, 0.2);
      border-radius: 999px;
      color: rgba(239, 246, 255, 0.88);
      background: rgba(8, 28, 49, 0.34);
      backdrop-filter: blur(8px);
      font-size: 0.73rem;
      font-weight: 700;
      animation: contentEnter 500ms 410ms ease-out both;
    }

    .status-dot {
      position: relative;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.14);
    }

    .status-dot::after {
      content: "";
      position: absolute;
      inset: -4px;
      border: 1px solid rgba(74, 222, 128, 0.58);
      border-radius: inherit;
      animation: statusPulse 2.2s ease-out infinite;
    }

    .auth-panel {
      position: relative;
      display: flex;
      min-width: 0;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      padding-block: clamp(2.5rem, 6vw, 7rem);
      padding-inline: max(clamp(2.5rem, 5vw, 6rem), calc((100% - 520px) / 2));
      background:
        radial-gradient(circle at 100% 0%, rgba(59, 130, 246, 0.075), transparent 32%),
        linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .auth-panel::before {
      content: "";
      position: absolute;
      width: 260px;
      height: 260px;
      right: -150px;
      bottom: -150px;
      border: 42px solid rgba(37, 99, 235, 0.035);
      border-radius: 50%;
      pointer-events: none;
    }

    .auth-panel > * {
      position: relative;
      z-index: 1;
      width: min(520px, 100%);
    }

    .mobile-brand {
      display: none;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 1.5rem;
    }

    .mobile-brand img {
      width: 42px;
      height: 42px;
      border-radius: 12px;
    }

    .mobile-brand strong {
      display: block;
      color: var(--navy-900);
      font-family: "Outfit", sans-serif;
      font-size: 1rem;
    }

    .mobile-brand span {
      display: block;
      margin-top: 0.05rem;
      color: var(--muted);
      font-size: 0.68rem;
    }

    .auth-kicker,
    .auth-title,
    .auth-copy,
    .access-note,
    .login-error,
    .login-form,
    .login-note {
      animation: formItemEnter 480ms ease-out both;
    }

    .auth-kicker {
      margin-bottom: 0.55rem;
      color: var(--blue-600);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      animation-delay: 230ms;
    }

    .auth-title {
      color: var(--navy-950);
      font-family: "Outfit", sans-serif;
      font-size: clamp(1.9rem, 4vw, 2.35rem);
      font-weight: 600;
      line-height: 1.12;
      letter-spacing: -0.025em;
      animation-delay: 280ms;
    }

    .auth-copy {
      margin: 0.65rem 0 1rem;
      color: var(--muted);
      font-size: 0.87rem;
      line-height: 1.55;
      animation-delay: 330ms;
    }

    .access-note {
      display: flex;
      align-items: center;
      gap: 0.78rem;
      margin-bottom: 1.35rem;
      padding: 0.78rem 0.88rem;
      border: 1px solid #d8e5f5;
      border-radius: 11px;
      color: #29415d;
      background: rgba(239, 246, 255, 0.82);
      animation-delay: 350ms;
    }

    .access-note-icon {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      border-radius: 10px;
      color: #1d4ed8;
      background: #e5efff;
    }

    .access-note-icon svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.9;
    }

    .access-note-copy {
      min-width: 0;
      display: grid;
      gap: 0.15rem;
    }

    .access-note-copy strong {
      color: #23364d;
      font-size: 0.76rem;
      line-height: 1.2;
    }

    .access-note-copy small {
      color: #71839a;
      font-size: 0.67rem;
      line-height: 1.35;
    }

    .login-error {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      margin-bottom: 1rem;
      padding: 0.78rem 0.9rem;
      border: 1px solid #fecdd3;
      border-radius: 12px;
      color: var(--danger);
      background: var(--danger-bg);
      font-size: 0.82rem;
      font-weight: 700;
      line-height: 1.4;
      animation-delay: 350ms;
    }

    .login-error svg {
      width: 17px;
      height: 17px;
      flex: 0 0 auto;
      margin-top: 1px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 2;
    }

    .login-form {
      min-width: 0;
      animation-delay: 380ms;
    }

    .form-group { margin-bottom: 1rem; }

    label {
      display: block;
      margin-bottom: 0.42rem;
      color: #263a52;
      font-size: 0.73rem;
      font-weight: 800;
      letter-spacing: 0.055em;
      text-transform: uppercase;
    }

    .input-wrap {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      align-items: center;
      overflow: hidden;
      min-height: 52px;
      border: 1px solid var(--line-strong);
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 1px 2px rgba(15, 39, 66, 0.03);
      transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    .input-wrap.has-action {
      grid-template-columns: 44px minmax(0, 1fr) 44px;
    }

    .input-wrap:focus-within {
      border-color: var(--blue-500);
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.13), 0 7px 16px rgba(37, 99, 235, 0.08);
      transform: translateY(-1px);
    }

    .input-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: #68809b;
      border-right: 1px solid #e1e8f0;
      transition: color 180ms ease, background-color 180ms ease;
    }

    .input-wrap:focus-within .input-icon {
      color: var(--blue-600);
      background: #f6f9ff;
    }

    .input-icon svg,
    .password-toggle svg,
    .login-btn svg,
    .login-note svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.9;
    }

    input[type="text"],
    input[type="password"] {
      width: 100%;
      min-width: 0;
      padding: 0.84rem 0.9rem;
      border: 0;
      outline: 0;
      color: var(--text);
      background: transparent;
      font: 500 0.93rem/1.25 "Manrope", sans-serif;
    }

    input::placeholder { color: #8c9cb0; }

    .password-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      margin-right: 3px;
      border: 0;
      border-radius: 9px;
      color: #687d96;
      background: transparent;
      cursor: pointer;
      transition: color 160ms ease, background-color 160ms ease, transform 160ms ease;
    }

    .password-toggle:hover {
      color: var(--blue-600);
      background: #edf4ff;
    }

    .password-toggle:active { transform: scale(0.92); }

    .password-toggle:focus-visible,
    .login-btn:focus-visible {
      outline: 3px solid rgba(59, 130, 246, 0.32);
      outline-offset: 2px;
    }

    .login-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      width: 100%;
      min-height: 52px;
      margin-top: 0.55rem;
      overflow: hidden;
      border: 0;
      border-radius: 12px;
      color: #fff;
      background: linear-gradient(135deg, #123f72 0%, #1557a4 100%);
      box-shadow: 0 11px 22px rgba(18, 63, 114, 0.23);
      cursor: pointer;
      font: 700 0.94rem/1 "Manrope", sans-serif;
      transition: transform 170ms ease, box-shadow 170ms ease, filter 170ms ease;
    }

    .login-btn::before {
      content: "";
      position: absolute;
      inset: 0;
      transform: translateX(-120%) skewX(-24deg);
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: transform 650ms ease;
    }

    .login-btn:hover {
      transform: translateY(-2px);
      filter: brightness(1.04);
      box-shadow: 0 15px 28px rgba(18, 63, 114, 0.3);
    }

    .login-btn:hover::before { transform: translateX(120%) skewX(-24deg); }

    .login-btn:active {
      transform: translateY(0);
      box-shadow: 0 8px 16px rgba(18, 63, 114, 0.23);
    }

    .login-btn.is-loading {
      pointer-events: none;
      filter: saturate(0.9);
    }

    .login-btn.is-loading .button-icon { display: none; }

    .button-spinner {
      display: none;
      width: 17px;
      height: 17px;
      border: 2px solid rgba(255, 255, 255, 0.4);
      border-top-color: #fff;
      border-radius: 50%;
      animation: btnSpin 700ms linear infinite;
    }

    .login-btn.is-loading .button-spinner { display: inline-block; }

    .login-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.42rem;
      margin-top: 1.15rem;
      color: var(--muted);
      font-size: 0.72rem;
      text-align: center;
      animation-delay: 440ms;
    }

    .login-note svg {
      width: 14px;
      height: 14px;
      flex: 0 0 auto;
    }

    .auth-footer {
      margin-top: 1.8rem;
      padding-top: 1.15rem;
      border-top: 1px solid #e5ebf2;
      color: #8191a5;
      font-size: 0.68rem;
      line-height: 1.45;
      text-align: center;
      animation: formItemEnter 480ms 480ms ease-out both;
    }

    @keyframes shellEnter {
      from { opacity: 0; transform: translateY(20px) scale(0.985); }
      to { opacity: 1; transform: none; }
    }

    @keyframes contentEnter {
      from { opacity: 0; transform: translateX(-12px); }
      to { opacity: 1; transform: none; }
    }

    @keyframes formItemEnter {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: none; }
    }

    @keyframes logoSettle {
      0% { opacity: 0; transform: scale(0.82) rotate(-8deg); }
      70% { opacity: 1; transform: scale(1.04) rotate(1deg); }
      100% { opacity: 1; transform: none; }
    }

    @keyframes laneDrift {
      to { background-position: 300px 0; }
    }

    @keyframes markRotate {
      to { transform: rotate(360deg); }
    }

    @keyframes statusPulse {
      0% { opacity: 0.85; transform: scale(0.55); }
      75%, 100% { opacity: 0; transform: scale(1.35); }
    }

    @keyframes orbFloat {
      to { transform: translate(-22px, 28px) scale(1.05); }
    }

    @keyframes btnSpin {
      to { transform: rotate(360deg); }
    }

    @media (max-width: 760px) {
      body { padding: 0; }

      .login-shell {
        display: block;
        width: 100%;
        max-width: none;
        min-height: 100vh;
        min-height: 100dvh;
        border-radius: 0;
      }

      .brand-panel { display: none; }

      .auth-panel {
        min-height: 100vh;
        min-height: 100dvh;
        padding: clamp(1.5rem, 7vw, 2.3rem);
      }

      .mobile-brand { display: flex; }

      .auth-title { font-size: 1.85rem; }

      .auth-copy { margin-bottom: 1.35rem; }
    }

    @media (max-width: 380px) {
      body { padding: 0; }
      .auth-panel { padding: 1.25rem; }
      .login-shell { border-radius: 0; }
      .auth-title { font-size: 1.65rem; }
      .mobile-brand { margin-bottom: 1.15rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <div class="ambient-grid" aria-hidden="true"></div>
  <div class="ambient-orb" aria-hidden="true"></div>

  <main class="login-shell">
    <section class="brand-panel" aria-label="NAAP Parking Management">
      <div class="brand-top">
        <img class="brand-logo" src="/icons/icon-192.png" alt="" />
        <div>
          <div class="brand-name">NAAP Parking</div>
          <div class="brand-system">Management system</div>
        </div>
      </div>

      <div class="brand-message">
        <p class="brand-kicker">Staff operations portal</p>
        <h1 class="brand-title">Secure access from gate to parking slot.</h1>
        <p class="brand-copy">
          Manage vehicles, visitor passes, parking assignments, and gate activity from one authorized workspace.
        </p>
        <ul class="brand-features">
          <li><span class="feature-check" aria-hidden="true">✓</span>Fast QR vehicle verification</li>
          <li><span class="feature-check" aria-hidden="true">✓</span>Live parking and gate visibility</li>
          <li><span class="feature-check" aria-hidden="true">✓</span>Reliable activity and audit records</li>
        </ul>
      </div>

      <div class="portal-status">
        <span class="status-dot" aria-hidden="true"></span>
        Secure role-based access
      </div>
    </section>

    <section class="auth-panel" aria-labelledby="login-title">
      <div class="mobile-brand">
        <img src="/icons/icon-192.png" alt="" />
        <div>
          <strong>NAAP Parking</strong>
          <span>Management system</span>
        </div>
      </div>

      <p class="auth-kicker">Authorized personnel</p>
      <h2 class="auth-title" id="login-title">Welcome back</h2>
      <p class="auth-copy">Sign in with your Admin or Guard account to continue.</p>

      <div class="access-note">
        <span class="access-note-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 3 5 6v5c0 4.6 2.8 8 7 10 4.2-2 7-5.4 7-10V6l-7-3Z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </span>
        <span class="access-note-copy">
          <strong>Automatic role routing</strong>
          <small>Your authorized dashboard opens automatically after sign-in.</small>
        </span>
      </div>

      <% if (locals.error) { %>
        <div class="login-error" role="alert">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M10.3 3.6 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z"></path>
            <path d="M12 9v4"></path>
            <path d="M12 17h.01"></path>
          </svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form class="login-form" method="post" action="/login">
        <div class="form-group">
          <label for="username">Username</label>
          <div class="input-wrap">
            <span class="input-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M20 21a8 8 0 0 0-16 0"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </span>
            <input
              type="text"
              id="username"
              name="username"
              required
              autofocus
              autocomplete="username"
              placeholder="Enter your username"
              value="<%= locals.usernameVal || '' %>"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="input-wrap has-action">
            <span class="input-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="4" y="11" width="16" height="9" rx="2"></rect>
                <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
              </svg>
            </span>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="Enter your password"
            />
            <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
                <circle cx="12" cy="12" r="2.5"></circle>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="login-btn">
          <span class="button-label">Sign in securely</span>
          <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
          <span class="button-spinner" aria-hidden="true"></span>
        </button>
      </form>

      <p class="login-note">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="5" y="10" width="14" height="11" rx="2"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
        </svg>
        Your session is protected and role restricted.
      </p>

      <footer class="auth-footer">
        National Aviation Academy of the Philippines<br />
        Parking Management System
      </footer>
    </section>
  </main>

  <script>
    (() => {
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => undefined);
        });
      }

      const form = document.querySelector('form[action="/login"]');
      const submitBtn = form ? form.querySelector('.login-btn') : null;
      const buttonLabel = submitBtn ? submitBtn.querySelector('.button-label') : null;
      const loginShell = document.querySelector('.login-shell');
      const passwordInput = document.querySelector('#password');
      const passwordToggle = document.querySelector('.password-toggle');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (passwordInput && passwordToggle) {
        passwordToggle.addEventListener('click', () => {
          const willShow = passwordInput.type === 'password';
          passwordInput.type = willShow ? 'text' : 'password';
          passwordToggle.setAttribute('aria-pressed', String(willShow));
          passwordToggle.setAttribute('aria-label', willShow ? 'Hide password' : 'Show password');
          passwordInput.focus({ preventScroll: true });
        });
      }

      if (!form || !submitBtn) return;

      form.addEventListener('submit', (event) => {
        if (form.dataset.submitting === '1') {
          event.preventDefault();
          return;
        }

        form.dataset.submitting = '1';
        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
        submitBtn.setAttribute('aria-busy', 'true');
        if (buttonLabel) buttonLabel.textContent = 'Signing in';
        if (!prefersReducedMotion && loginShell) {
          loginShell.classList.add('is-submitting');
        }
      });
    })();
  </script>
</body>
</html>
