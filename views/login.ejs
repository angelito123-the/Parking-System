<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#102a46" />
  <meta name="application-name" content="NAAP Parking" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>NAAP Parking - Staff Sign In</title>
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/phosphor/style.css?v=2.1.2" />
  <link rel="stylesheet" href="/theme-tokens.css?v=20261021-brand" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy-950: #081c31;
      --navy-900: #102a46;
      --navy-800: #123a66;
      --blue-600: #2563eb;
      --blue-500: #3b82f6;
      --surface: #ffffff;
      --line: #d8e2ee;
      --line-strong: #c2d0e0;
      --text: #142236;
      --muted: #65778f;
      --danger: #a11b3c;
      --danger-bg: #fff1f3;
      --success: #22c55e;
      --login-enter-ease: cubic-bezier(0.22, 1, 0.36, 1);
      --login-control-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    html { min-height: 100%; }

    body {
      min-height: 100vh;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      place-items: stretch;
      overflow-x: hidden;
      padding: 0;
      color: var(--text);
      font-family: "Manrope", sans-serif;
      background:
        radial-gradient(900px 560px at 8% 2%, rgba(37, 99, 235, 0.17), transparent 65%),
        radial-gradient(780px 520px at 96% 94%, rgba(14, 165, 233, 0.12), transparent 68%),
        linear-gradient(145deg, #f4f8fc 0%, #eaf1f8 52%, #f5f8fc 100%);
      isolation: isolate;
    }

    .ambient-grid,
    .ambient-orb {
      position: fixed;
      z-index: -1;
      pointer-events: none;
    }

    .ambient-grid {
      inset: 0;
      opacity: 0.36;
      background-image:
        linear-gradient(rgba(71, 103, 137, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(71, 103, 137, 0.07) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(to bottom, transparent, #000 24%, #000 76%, transparent);
    }

    .ambient-orb {
      width: 340px;
      height: 340px;
      right: -140px;
      top: 12%;
      border: 72px solid rgba(59, 130, 246, 0.07);
      border-radius: 50%;
    }

    .login-shell {
      width: 100%;
      max-width: none;
      min-width: 0;
      min-height: 100vh;
      min-height: 100dvh;
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      overflow: hidden;
      border: 0;
      border-radius: 0;
      background: var(--surface);
      box-shadow: none;
    }

    .brand-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(2.5rem, 6vh, 4.5rem);
      overflow: hidden;
      padding-block: clamp(2.5rem, 6vw, 7rem);
      padding-inline: max(clamp(2.5rem, 5vw, 6rem), calc((100% - 520px) / 2));
      color: #fff;
      background:
        radial-gradient(circle at 105% 10%, rgba(96, 165, 250, 0.34), transparent 35%),
        linear-gradient(150deg, var(--navy-950) 0%, var(--navy-800) 65%, #15549a 100%);
    }

    .brand-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0.5;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
    }

    .brand-panel::after {
      content: "P";
      position: absolute;
      right: -48px;
      bottom: -88px;
      display: grid;
      place-items: center;
      width: 260px;
      height: 260px;
      border: 48px solid rgba(255, 255, 255, 0.035);
      border-radius: 50%;
      color: rgba(255, 255, 255, 0.08);
      font-family: "Outfit", sans-serif;
      font-size: 6.8rem;
      font-weight: 700;
      line-height: 1;
    }

    /* Decorative glows move independently behind the readable brand content. */
    .brand-orb {
      position: absolute;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      pointer-events: none;
      opacity: 0.24;
      background: radial-gradient(circle, #60a5fa, transparent 70%);
      animation: brandOrbDrift 18s ease-in-out infinite;
    }

    .brand-orb--one { top: -180px; right: -120px; }
    .brand-orb--two {
      width: 400px;
      height: 400px;
      bottom: -120px;
      left: -100px;
      background: radial-gradient(circle, #ffffff, transparent 70%);
      animation-duration: 22s;
      animation-direction: reverse;
    }
    .brand-orb--three {
      width: 250px;
      height: 250px;
      top: 45%;
      left: 45%;
      background: radial-gradient(circle, #818cf8, transparent 70%);
      animation-duration: 16s;
      animation-delay: 2s;
    }

    .brand-top,
    .brand-message,
    .portal-status {
      position: relative;
      z-index: 1;
    }

    .brand-top {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      animation: contentEnter 600ms 100ms var(--login-enter-ease) backwards;
    }

    .brand-logo {
      width: 52px;
      height: 52px;
      flex: 0 0 auto;
      border-radius: 15px;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.22);
      animation: logoFloat 6s ease-in-out infinite;
    }

    .brand-name {
      font-family: "Outfit", sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: 0.01em;
    }

    .brand-system {
      margin-top: 0.25rem;
      color: rgba(219, 234, 254, 0.76);
      font-size: 0.77rem;
      font-weight: 500;
    }

    .brand-message {
      width: 100%;
      max-width: 520px;
      margin: 0;
    }

    .brand-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      margin-bottom: 1rem;
      color: #bfdbfe;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      animation: contentEnter 600ms 100ms var(--login-enter-ease) backwards;
    }

    .brand-kicker::before {
      content: "";
      width: 22px;
      height: 2px;
      border-radius: 999px;
      background: #60a5fa;
    }

    .brand-title {
      font-family: "Outfit", sans-serif;
      font-size: clamp(2.1rem, 3.6vw, 3rem);
      font-weight: 600;
      line-height: 1.13;
      letter-spacing: -0.025em;
      text-wrap: balance;
      animation: contentEnter 600ms 100ms var(--login-enter-ease) backwards;
    }

    .brand-copy {
      max-width: 32rem;
      margin-top: 1rem;
      color: rgba(219, 234, 254, 0.78);
      font-size: 0.9rem;
      line-height: 1.65;
      animation: contentEnter 600ms 100ms var(--login-enter-ease) backwards;
    }

    .brand-features {
      display: grid;
      gap: 0.55rem;
      margin-top: 1.35rem;
      color: rgba(239, 246, 255, 0.88);
      font-size: 0.82rem;
      line-height: 1.5;
      font-weight: 650;
      list-style: none;
    }

    .brand-features li {
      display: flex;
      align-items: center;
      gap: 0.62rem;
      padding: 0.85rem 0.9rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.06);
      animation: contentEnter 480ms var(--login-enter-ease) backwards;
      transition: translate 240ms var(--login-control-ease), background-color 240ms ease, border-color 240ms ease;
    }

    .brand-features li:nth-child(1) { animation-delay: 80ms; }
    .brand-features li:nth-child(2) { animation-delay: 130ms; }
    .brand-features li:nth-child(n+3) { animation-delay: 180ms; }

    .feature-check {
      width: 20px;
      height: 20px;
      display: inline-grid;
      place-items: center;
      flex: 0 0 auto;
      border: 1px solid rgba(147, 197, 253, 0.24);
      border-radius: 6px;
      color: #93c5fd;
      background: rgba(59, 130, 246, 0.12);
      font-size: 0.68rem;
      line-height: 1;
      transition: background-color 300ms ease;
    }

    .portal-status {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      gap: 0.55rem;
      padding: 0.55rem 0.75rem;
      border: 1px solid rgba(191, 219, 254, 0.2);
      border-radius: 999px;
      color: rgba(239, 246, 255, 0.88);
      background: rgba(8, 28, 49, 0.34);
      backdrop-filter: blur(8px);
      font-size: 0.73rem;
      font-weight: 700;
      animation: contentEnter 600ms 300ms var(--login-enter-ease) backwards;
    }

    .status-dot {
      position: relative;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.14);
    }

    .status-dot::after {
      content: "";
      position: absolute;
      inset: -4px;
      border: 1px solid rgba(74, 222, 128, 0.58);
      border-radius: inherit;
    }

    .auth-panel {
      position: relative;
      display: flex;
      min-width: 0;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      padding-block: clamp(2.5rem, 6vw, 7rem);
      padding-inline: max(clamp(2.5rem, 5vw, 6rem), calc((100% - 520px) / 2));
      background:
        radial-gradient(circle at 100% 0%, rgba(59, 130, 246, 0.075), transparent 32%),
        linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .auth-panel::before {
      content: "";
      position: absolute;
      width: 260px;
      height: 260px;
      right: -150px;
      bottom: -150px;
      border: 42px solid rgba(37, 99, 235, 0.035);
      border-radius: 50%;
      pointer-events: none;
    }

    .auth-card {
      position: relative;
      z-index: 1;
      width: min(480px, 100%);
      padding: clamp(1.5rem, 2.5vw, 2.25rem);
      border: 1px solid var(--line);
      border-radius: 22px;
      background: var(--surface);
      box-shadow: 0 20px 64px rgba(18, 58, 102, 0.07), 0 2px 8px rgba(18, 58, 102, 0.03);
      animation: formItemEnter 480ms var(--login-enter-ease) backwards;
    }

    .mobile-brand {
      display: none;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 1.5rem;
    }

    .mobile-brand img {
      width: 42px;
      height: 42px;
      border-radius: 12px;
    }

    .mobile-brand strong {
      display: block;
      color: var(--navy-900);
      font-family: "Outfit", sans-serif;
      font-size: 1rem;
    }

    .mobile-brand span {
      display: block;
      margin-top: 0.05rem;
      color: var(--muted);
      font-size: 0.68rem;
    }

    .auth-kicker {
      margin-bottom: 0.55rem;
      color: var(--blue-600);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .auth-title {
      color: var(--navy-950);
      font-family: "Outfit", sans-serif;
      font-size: clamp(1.9rem, 4vw, 2.35rem);
      font-weight: 600;
      line-height: 1.12;
      letter-spacing: -0.025em;
    }

    .auth-copy {
      margin: 0.65rem 0 1rem;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .login-error {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      margin-bottom: 1rem;
      padding: 0.78rem 0.9rem;
      border: 1px solid #fecdd3;
      border-radius: 12px;
      color: var(--danger);
      background: var(--danger-bg);
      font-size: 0.82rem;
      font-weight: 700;
      line-height: 1.4;
      animation: loginAlertEnter 300ms var(--login-enter-ease);
    }

    .login-error .ph {
      font-size: 17px;
      flex: 0 0 auto;
      margin-top: 1px;
    }

    .login-form {
      min-width: 0;
    }

    .form-group { margin-bottom: 1rem; }

    label {
      display: block;
      margin-bottom: 0.42rem;
      color: #263a52;
      font-size: 0.73rem;
      font-weight: 800;
      letter-spacing: 0.055em;
      text-transform: uppercase;
    }

    .input-wrap {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      align-items: center;
      overflow: hidden;
      min-height: 52px;
      border: 1px solid var(--line-strong);
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 1px 2px rgba(15, 39, 66, 0.03);
      transition: border-color 200ms var(--login-control-ease), box-shadow 200ms var(--login-control-ease);
    }

    .input-wrap.has-action {
      grid-template-columns: 44px minmax(0, 1fr) 44px;
    }

    .input-wrap:focus-within {
      border-color: var(--blue-500);
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.13), 0 7px 16px rgba(37, 99, 235, 0.08);
    }

    .input-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: #68809b;
      border-right: 1px solid #e1e8f0;
      transition: color 180ms ease, background-color 180ms ease;
    }

    .input-wrap:focus-within .input-icon {
      color: var(--blue-600);
      background: #f6f9ff;
    }

    .input-icon .ph,
    .password-toggle .ph,
    .login-btn .ph,
    .login-note .ph {
      font-size: 18px;
    }

    input[type="text"],
    input[type="password"] {
      width: 100%;
      min-width: 0;
      padding: 0.84rem 0.9rem;
      border: 0;
      outline: 0;
      color: var(--text);
      background: transparent;
      font: 500 0.93rem/1.25 "Manrope", sans-serif;
    }

    input::placeholder { color: #8c9cb0; }

    .password-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      margin-right: 3px;
      border: 0;
      border-radius: 9px;
      color: #687d96;
      background: transparent;
      cursor: pointer;
      transition: color 160ms ease, background-color 160ms ease, transform 160ms ease;
    }

    .password-toggle:hover {
      color: var(--blue-600);
      background: #edf4ff;
    }

    .password-toggle:active { transform: scale(0.92); }

    .password-toggle:focus-visible,
    .login-btn:focus-visible {
      outline: 3px solid rgba(59, 130, 246, 0.32);
      outline-offset: 2px;
    }

    .login-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      width: 100%;
      min-height: 52px;
      margin-top: 0.55rem;
      overflow: hidden;
      border: 0;
      border-radius: 12px;
      color: #fff;
      background: linear-gradient(135deg, #123f72 0%, #1557a4 100%);
      box-shadow: 0 8px 18px rgba(18, 63, 114, 0.16);
      cursor: pointer;
      font: 700 0.94rem/1 "Manrope", sans-serif;
      transition: transform 250ms var(--login-control-ease), box-shadow 250ms var(--login-control-ease);
    }

    .login-btn::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      background: linear-gradient(135deg, #1557a4 0%, #123f72 100%);
      transition: opacity 250ms ease;
    }

    .login-btn > * { position: relative; z-index: 1; }
    .login-btn .button-icon { transition: transform 250ms var(--login-control-ease); }

    @media (hover: hover) and (pointer: fine) {
      .login-btn:hover:not(:disabled):not(.is-loading) {
        transform: translateY(-1px);
        box-shadow: 0 10px 26px rgba(18, 63, 114, 0.22);
      }
      .login-btn:hover:not(:disabled):not(.is-loading)::before { opacity: 1; }
      .login-btn:hover:not(:disabled):not(.is-loading) .button-icon { transform: translateX(3px); }
      .brand-features li:hover {
        translate: 3px 0;
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(255, 255, 255, 0.2);
      }
      .brand-features li:hover .feature-check { background: rgba(255, 255, 255, 0.2); }
    }

    .login-btn:focus-visible .button-icon { transform: translateX(3px); }

    .login-btn:active:not(:disabled):not(.is-loading) {
      transform: translateY(0) scale(0.99);
      box-shadow: 0 8px 16px rgba(18, 63, 114, 0.23);
    }

    .login-btn.is-loading {
      pointer-events: none;
      filter: saturate(0.9);
    }

    .login-btn.is-loading .button-icon { display: none; }

    .button-spinner {
      display: none;
      width: 17px;
      height: 17px;
      border: 2px solid rgba(255, 255, 255, 0.4);
      border-top-color: #fff;
      border-radius: 50%;
      animation: btnSpin 700ms linear infinite;
    }

    .login-btn.is-loading .button-spinner { display: inline-block; }

    .login-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.42rem;
      margin-top: 1.15rem;
      color: var(--muted);
      font-size: 0.72rem;
      text-align: center;
    }

    .login-note .ph {
      font-size: 14px;
      flex: 0 0 auto;
    }

    .auth-footer {
      margin-top: 1.8rem;
      padding-top: 1.15rem;
      border-top: 1px solid #e5ebf2;
      color: #5f7188;
      font-size: 0.68rem;
      line-height: 1.45;
      text-align: center;
    }

    @keyframes contentEnter {
      from { opacity: 0.4; transform: translateY(10px); }
      to { opacity: 1; transform: none; }
    }

    @keyframes formItemEnter {
      from { opacity: 0.4; transform: translateY(12px); }
      to { opacity: 1; transform: none; }
    }

    @keyframes logoFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    @keyframes brandOrbDrift {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(16px, -20px) scale(1.035); }
    }

    @keyframes loginAlertEnter {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: none; }
    }

    @keyframes btnSpin {
      to { transform: rotate(360deg); }
    }

    @media (max-width: 760px) {
      body { padding: 0; }

      .login-shell {
        display: block;
        width: 100%;
        max-width: none;
        min-height: 100vh;
        min-height: 100dvh;
        border-radius: 0;
      }

      .brand-panel { display: none; }

      .auth-panel {
        min-height: 100vh;
        min-height: 100dvh;
        padding: clamp(1.5rem, 7vw, 2.3rem);
      }

      .mobile-brand { display: flex; }

      .auth-card {
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
      }

      .auth-title { font-size: 1.85rem; }

      .auth-copy { margin-bottom: 1.35rem; }
    }

    @media (max-width: 760px) {
      .auth-panel { justify-content: center; padding-block: 2rem; }
      .input-wrap input { font-size: 1rem; }
      .password-toggle { width: 44px; height: 44px; }
      .auth-footer { margin-top: 1.3rem; }
    }

    @media (max-width: 380px) {
      body { padding: 0; }
      .auth-panel { padding: 1.25rem; }
      .login-shell { border-radius: 0; }
      .auth-title { font-size: 1.65rem; }
      .mobile-brand { margin-bottom: 1.15rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation: none !important;
        transition-duration: 0.01ms !important;
      }
      .brand-features li:hover,
      .login-btn,
      .login-btn .button-icon,
      .password-toggle:active { transform: none !important; }
      .brand-features li { translate: none !important; }
    }
  </style>
  <link rel="stylesheet" href="/login-theme.css?v=20261022-depth" />
  <link rel="stylesheet" href="/ui-motion.css?v=20261022-depth" />
  <script src="/js/ui-motion.js?v=20261022-depth" defer></script>
</head>
<body class="page-login">
  <div class="ambient-grid" aria-hidden="true"></div>
  <div class="ambient-orb" aria-hidden="true"></div>

  <main class="login-shell">
    <section class="brand-panel" aria-label="NAAP Parking Management">
      <div class="brand-orb brand-orb--one" aria-hidden="true"></div>
      <div class="brand-orb brand-orb--two" aria-hidden="true"></div>
      <div class="brand-orb brand-orb--three" aria-hidden="true"></div>
      <div class="brand-top">
        <img class="brand-logo" src="/icons/icon-192.png" alt="" />
        <div>
          <div class="brand-name">NAAP Parking</div>
          <div class="brand-system">Management system</div>
        </div>
      </div>

      <div class="brand-message">
        <p class="brand-kicker">Staff operations portal</p>
        <h1 class="brand-title">Secure access from gate to parking slot.</h1>
        <p class="brand-copy">
          Manage vehicles, visitor passes, parking assignments, and gate activity from one authorized workspace.
        </p>
        <ul class="brand-features">
          <li><i class="ph ph-check feature-check" aria-hidden="true"></i>Fast QR vehicle verification</li>
          <li><i class="ph ph-check feature-check" aria-hidden="true"></i>Live parking and gate visibility</li>
          <li><i class="ph ph-check feature-check" aria-hidden="true"></i>Reliable activity and audit records</li>
        </ul>
      </div>

      <div class="portal-status">
        <span class="status-dot" aria-hidden="true"></span>
        Secure role-based access
      </div>
    </section>

    <section class="auth-panel" aria-labelledby="login-title">
      <div class="auth-card">
      <div class="mobile-brand">
        <img src="/icons/icon-192.png" alt="" />
        <div>
          <strong>NAAP Parking</strong>
          <span>Management system</span>
        </div>
      </div>

      <p class="auth-kicker">Authorized personnel</p>
      <h2 class="auth-title" id="login-title">Welcome back</h2>
      <p class="auth-copy">Sign in with your Admin or Guard account to continue.</p>

      <% if (locals.error) { %>
        <div class="login-error" role="alert">
          <i class="ph ph-warning" aria-hidden="true"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form class="login-form" method="post" action="/login">
        <div class="form-group">
          <label for="username">Username</label>
          <div class="input-wrap">
            <span class="input-icon" aria-hidden="true">
              <i class="ph ph-user"></i>
            </span>
            <input
              type="text"
              id="username"
              name="username"
              required
              autocomplete="username"
              autocapitalize="none"
              spellcheck="false"
              placeholder="Enter your username"
              value="<%= locals.usernameVal || '' %>"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="input-wrap has-action">
            <span class="input-icon" aria-hidden="true">
              <i class="ph ph-lock-key"></i>
            </span>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="Enter your password"
            />
            <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false">
              <i class="ph ph-eye" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="login-btn">
          <span class="button-label">Sign in</span>
          <i class="ph ph-arrow-right button-icon" aria-hidden="true"></i>
          <span class="button-spinner" aria-hidden="true"></span>
          <i class="ph ph-check button-success" aria-hidden="true"></i>
        </button>
      </form>

      <p class="login-note">
        <i class="ph ph-lock-key" aria-hidden="true"></i>
        Need an account? Contact your system administrator.
      </p>

      <footer class="auth-footer">
        National Aviation Academy of the Philippines<br />
        Parking Management System
      </footer>
      </div>
    </section>
  </main>

  <script nonce="<%= cspNonce %>">
    (() => {
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => undefined);
        });
      }

      const form = document.querySelector('form[action="/login"]');
      const submitBtn = form ? form.querySelector('.login-btn') : null;
      const buttonLabel = submitBtn ? submitBtn.querySelector('.button-label') : null;
      const passwordInput = document.querySelector('#password');
      const passwordToggle = document.querySelector('.password-toggle');

      if (passwordInput && passwordToggle) {
        passwordToggle.addEventListener('click', () => {
          const willShow = passwordInput.type === 'password';
          const passwordIcon = passwordToggle.querySelector('.ph');
          passwordInput.type = willShow ? 'text' : 'password';
          passwordIcon?.classList.toggle('ph-eye', !willShow);
          passwordIcon?.classList.toggle('ph-eye-slash', willShow);
          passwordToggle.setAttribute('aria-pressed', String(willShow));
          passwordToggle.setAttribute('aria-label', willShow ? 'Hide password' : 'Show password');
          passwordInput.focus({ preventScroll: true });
        });
      }

      if (!form || !submitBtn) return;

      form.addEventListener('submit', (event) => {
        if (form.dataset.submitting === '1') {
          event.preventDefault();
          return;
        }

        form.dataset.submitting = '1';
        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
        submitBtn.setAttribute('aria-busy', 'true');
        if (buttonLabel) buttonLabel.textContent = 'Signing in';
      });
    })();
  </script>
</body>
</html>
