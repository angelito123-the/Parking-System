<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0f2a4a" />
  <title>Two-factor verification | NAAP Parking</title>
  <link rel="icon" href="/icons/favicon-32.png" />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      color: #172033;
      background: #edf3f9;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .verify-card {
      width: min(100%, 440px);
      padding: 32px;
      border: 1px solid #d7e1ec;
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 18px 48px rgba(15, 42, 74, 0.12);
    }
    .brand { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
    .brand img { width: 44px; height: 44px; border-radius: 12px; }
    .brand strong { display: block; font-size: 1rem; }
    .brand span { display: block; margin-top: 2px; color: #6c7d94; font-size: 0.82rem; }
    h1 { margin: 0; font-size: 1.55rem; }
    .copy { margin: 9px 0 24px; color: #61738c; line-height: 1.55; }
    label { display: block; margin-bottom: 7px; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
    input {
      width: 100%;
      padding: 15px 16px;
      border: 1px solid #c8d5e5;
      border-radius: 12px;
      font: inherit;
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-align: center;
    }
    input:focus { outline: 3px solid rgba(37, 99, 235, 0.16); border-color: #2563eb; }
    button {
      width: 100%;
      margin-top: 16px;
      padding: 14px 18px;
      border: 0;
      border-radius: 12px;
      color: #fff;
      background: #174f96;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }
    .error { margin: 0 0 16px; padding: 11px 13px; border: 1px solid #fecdd3; border-radius: 10px; color: #9f1239; background: #fff1f2; }
    .cancel { display: block; margin-top: 18px; color: #52657e; text-align: center; text-decoration: none; font-weight: 700; }
  </style>
</head>
<body>
  <main class="verify-card">
    <div class="brand">
      <img src="/icons/icon-192.png" alt="" />
      <div><strong>NAAP Parking</strong><span>Secure staff access</span></div>
    </div>
    <h1>Enter verification code</h1>
    <p class="copy">Open the authenticator app connected to <strong><%= username %></strong>, then enter its current six-digit code.</p>
    <% if (locals.error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/login/2fa">
      <label for="code">Authentication code</label>
      <input id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" autofocus required />
      <button type="submit">Verify and continue</button>
    </form>
    <a class="cancel" href="/logout">Cancel sign-in</a>
  </main>
</body>
</html>
