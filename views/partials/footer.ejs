      </main>
    </div>
    </div><!-- /.content-area -->
  </div>

  <div class="confirm-dialog" id="confirmDialog" hidden>
    <button type="button" class="confirm-dialog-backdrop" data-confirm-close tabindex="-1" aria-label="Close confirmation"></button>
    <div class="confirm-dialog-card" role="alertdialog" aria-modal="true" aria-labelledby="confirmDialogTitle" aria-describedby="confirmDialogMessage">
      <span class="confirm-dialog-icon" aria-hidden="true">
        <i class="ph ph-warning"></i>
      </span>
      <div class="confirm-dialog-copy">
        <h2 id="confirmDialogTitle">Confirm action</h2>
        <p id="confirmDialogMessage">This action cannot be undone.</p>
      </div>
      <div class="confirm-dialog-note" id="confirmDialogNoteField" hidden>
        <label for="confirmDialogNote">Reason <span class="optional-label">(optional)</span></label>
        <textarea id="confirmDialogNote" maxlength="255" rows="3" placeholder="Add a short note for the record"></textarea>
      </div>
      <div class="confirm-dialog-actions">
        <button type="button" class="btn-cancel-sm" data-confirm-close>Go back</button>
        <button type="button" class="btn-confirm-danger" id="confirmDialogSubmit">Confirm</button>
      </div>
    </div>
  </div>

  <script nonce="<%= cspNonce %>">
    (() => {
      const body = document.body;
      const mobileTrigger = document.getElementById("mobileNavTrigger");
      const mobileClose = document.getElementById("mobileNavClose");
      const mobileBackdrop = document.getElementById("mobileNavBackdrop");
      const mobileSidebar = document.getElementById("mobileSidebar");
      const accountButton = document.getElementById("accountMenuButton");
      const accountMenu = document.getElementById("accountMenu");
      const contentArea = document.querySelector(".content-area");
      const mobileViewport = window.matchMedia("(max-width: 1080px)");

      const setMobileNavigation = (open, restoreFocus = true) => {
        if (!body || !mobileTrigger) return;
        const isMobile = mobileViewport.matches;
        open = Boolean(open && isMobile);
        body.classList.toggle("mobile-nav-open", open);
        if (mobileSidebar) mobileSidebar.inert = isMobile && !open;
        if (contentArea && !open) contentArea.inert = false;
        if (mobileSidebar) {
          if (open) {
            mobileSidebar.setAttribute("role", "dialog");
            mobileSidebar.setAttribute("aria-modal", "true");
          } else {
            mobileSidebar.removeAttribute("role");
            mobileSidebar.removeAttribute("aria-modal");
          }
        }
        mobileTrigger.setAttribute("aria-expanded", open ? "true" : "false");
        if (open) {
          mobileClose?.focus({ preventScroll: true });
          if (contentArea) contentArea.inert = true;
        } else if (restoreFocus && window.matchMedia("(max-width: 1080px)").matches) {
          mobileTrigger.focus({ preventScroll: true });
        }
      };

      setMobileNavigation(false, false);
      mobileTrigger?.addEventListener("click", () => setMobileNavigation(true, false));
      mobileClose?.addEventListener("click", () => setMobileNavigation(false));
      mobileBackdrop?.addEventListener("click", () => setMobileNavigation(false));
      mobileSidebar?.querySelectorAll("a[href]").forEach((link) => {
        link.addEventListener("click", () => setMobileNavigation(false, false));
      });

      const setAccountMenu = (open, restoreFocus = true) => {
        if (!accountButton || !accountMenu) return;
        accountMenu.hidden = !open;
        accountButton.setAttribute("aria-expanded", open ? "true" : "false");
        if (open) {
          window.requestAnimationFrame(() => accountMenu.querySelector('[role="menuitem"]')?.focus());
        } else if (restoreFocus) {
          accountButton.focus({ preventScroll: true });
        }
      };

      accountButton?.addEventListener("click", (event) => {
        event.stopPropagation();
        setAccountMenu(accountMenu?.hidden !== false, false);
      });
      accountMenu?.addEventListener("click", (event) => event.stopPropagation());
      document.addEventListener("click", () => {
        if (accountMenu && !accountMenu.hidden) setAccountMenu(false, false);
      });

      window.addEventListener("resize", () => {
        setMobileNavigation(false, false);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Tab" && body?.classList.contains("mobile-nav-open")) {
          const controls = Array.from(mobileSidebar.querySelectorAll('a[href], button:not([disabled])')).filter(node => node.getClientRects().length);
          const first = controls[0];
          const last = controls[controls.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
          return;
        }
        if (event.key !== "Escape") return;
        if (body?.classList.contains("mobile-nav-open")) {
          setMobileNavigation(false);
          return;
        }
        if (accountMenu && !accountMenu.hidden) setAccountMenu(false);
      });
    })();
  </script>

  <script nonce="<%= cspNonce %>">
    (() => {
      const closeActionMenu = (except = null) => {
        document.querySelectorAll(".action-menu.is-open").forEach((menu) => {
          if (menu === except) return;
          menu.classList.remove("is-open");
          menu.querySelector("[data-action-menu-trigger]")?.setAttribute("aria-expanded", "false");
        });
      };

      document.addEventListener("click", (event) => {
        const menuTrigger = event.target instanceof Element ? event.target.closest("[data-action-menu-trigger]") : null;
        if (menuTrigger) {
          event.preventDefault();
          event.stopPropagation();
          const menu = menuTrigger.closest(".action-menu");
          const willOpen = !menu?.classList.contains("is-open");
          closeActionMenu(menu);
          menu?.classList.toggle("is-open", willOpen);
          menuTrigger.setAttribute("aria-expanded", willOpen ? "true" : "false");
          return;
        }
        if (!(event.target instanceof Element) || !event.target.closest(".action-menu")) closeActionMenu();
      });

    })();
  </script>

  <script nonce="<%= cspNonce %>">
    (() => {
      const clock = document.getElementById("liveClock");
      if (!clock) return;
      const render = () => {
        clock.textContent = new Date().toLocaleTimeString([], {
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit"
        });
      };
      render();
      setInterval(render, 1000);
    })();
  </script>
  <script nonce="<%= cspNonce %>">
    (() => {
      const body = document.body;
      requestAnimationFrame(() => body.classList.add("is-ready"));

      const navLinks = document.querySelector(".top-nav-links");
      if (navLinks) {
        navLinks.scrollLeft = 0;
      }
    })();
  </script>
  <script nonce="<%= cspNonce %>">
    (() => {
      const body = document.body;
      if (!body) return;

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const pageLoader = document.getElementById("pageLoader");
      let pageLoaderHideTimer = null;

      const showPageLoader = () => {
        if (pageLoaderHideTimer) {
          window.clearTimeout(pageLoaderHideTimer);
          pageLoaderHideTimer = null;
        }
        if (pageLoader) {
          pageLoader.hidden = false;
          pageLoader.setAttribute("aria-hidden", "false");
        }
        pageLoader?.classList.add("is-active");
        body.classList.add("page-transitioning");
      };

      const hidePageLoader = () => {
        pageLoader?.classList.remove("is-active");
        pageLoader?.setAttribute("aria-hidden", "true");
        body.classList.remove("page-transitioning");
        if (!pageLoader) return;
        if (pageLoaderHideTimer) window.clearTimeout(pageLoaderHideTimer);
        const finishHide = () => {
          pageLoaderHideTimer = null;
          if (!pageLoader.classList.contains("is-active")) pageLoader.hidden = true;
        };
        if (prefersReducedMotion) {
          finishHide();
        } else {
          pageLoaderHideTimer = window.setTimeout(finishHide, 140);
        }
      };

      requestAnimationFrame(() => requestAnimationFrame(hidePageLoader));

      document.addEventListener("pointerdown", (event) => {
        if (prefersReducedMotion) return;
        const target = event.target instanceof Element ? event.target.closest("button, .btn-sm, .link-btn, .quick-link-card, .top-nav-links a, .icon-btn") : null;
        if (!target) return;
        if ("disabled" in target && target.disabled) return;
        target.classList.remove("ui-tap-pop");
        void target.offsetWidth;
        target.classList.add("ui-tap-pop");
      });

      document.addEventListener("animationend", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.classList.contains("ui-tap-pop")) {
          target.classList.remove("ui-tap-pop");
        }
      });

      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
        if (!link || link.hasAttribute("download") || link.target === "_blank") return;

        const rawHref = link.getAttribute("href");
        if (!rawHref || rawHref.startsWith("#") || rawHref.startsWith("javascript:")) return;

        const destination = new URL(link.href, window.location.href);
        if (destination.origin !== window.location.origin) return;
        if (destination.pathname === window.location.pathname && destination.search === window.location.search && destination.hash) return;

        showPageLoader();
      });

      document.addEventListener("submit", (event) => {
        if (event.defaultPrevented) return;
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        // File downloads keep this page open; no navigation event will clear a page loader.
        if (form.hasAttribute("data-native-download")) return;

        if (form.dataset.loading === "true") {
          event.preventDefault();
          return;
        }

        const submitter = event.submitter instanceof HTMLElement
          ? event.submitter
          : form.querySelector('button[type="submit"], input[type="submit"]');

        form.dataset.loading = "true";
        form.setAttribute("aria-busy", "true");
        if (submitter) {
          submitter.classList.add("is-loading");
          submitter.setAttribute("aria-busy", "true");
          submitter.setAttribute("aria-disabled", "true");
        }
        showPageLoader();
      });

      window.addEventListener("pageshow", () => {
        hidePageLoader();
        document.querySelectorAll('form[data-loading="true"]').forEach((form) => {
          form.removeAttribute("data-loading");
          form.removeAttribute("aria-busy");
          form.querySelectorAll(".is-loading").forEach((control) => {
            control.classList.remove("is-loading");
            control.removeAttribute("aria-busy");
            control.removeAttribute("aria-disabled");
          });
        });
        const navLinks = document.querySelector(".top-nav-links");
        if (navLinks) {
          navLinks.scrollLeft = 0;
        }
        if (body.classList.contains("page-reports") && window.scrollX !== 0) {
          window.scrollTo({ left: 0, top: window.scrollY });
        }
      });

      window.addEventListener("load", hidePageLoader, { once: true });
    })();
  </script>
</body>
</html>
